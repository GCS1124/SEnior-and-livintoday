---
import { SITE, SERVICES } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid cols">
    <div>
      <p class="name">Senior and Living Today (S.A.L.T.)</p>
      <p>{SITE.tagline}.</p>
      <address>
        {SITE.address.street}<br />
        {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}<br />
        <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a><br />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </address>
    </div>
    <nav aria-label="Services">
      <p class="h">Services</p>
      <ul>
        {SERVICES.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
        <li><a href="/caregiver-connection/">Caregiver Connection</a></li>
      </ul>
    </nav>
    <nav aria-label="Resources">
      <p class="h">Resources</p>
      <ul>
        <li><a href="/books/living-legacy-planner/">The Living Legacy Planner</a></li>
        <li><a href="/books/relics-of-the-century/">Relics of the Century</a></li>
        <li><a href="/resources/final-arrangements-discussion-guide/">Final Arrangements Discussion Guide</a></li>
        <li><a href="/guides/types-of-senior-living/">Types of Senior Living</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="h">S.A.L.T.</p>
      <ul>
        <li><a href="/about/">About Courtney Jones</a></li>
        <li><a href="/community/">Free Community</a></li>
        <li><a href={SITE.links.store} rel="noopener">SALT Online Store</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms-conditions/">Terms &amp; Conditions</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {year} Senior and Living Today. S.A.L.T. provides information, consulting and support. We are not a medical, legal or financial provider; please consult a licensed professional for advice about your situation.</p>
  </div>
</footer>

<style>
  .site-footer { background: #10302f; color: #dfe8e6; padding: 64px 0 28px; font-size: 1rem; }
  .site-footer a { color: #fff; }
  .cols { gap: 36px; }
  @media (min-width: 760px) { .cols { grid-template-columns: 1.4fr 1fr 1fr 1fr; } }
  .name { font-family: var(--font-head); font-size: 1.35rem; color: #fff; }
  .h { font-weight: 700; color: #f2b98f; letter-spacing: .1em; text-transform: uppercase; font-size: .85rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .55em; }
  address { font-style: normal; line-height: 1.8; }
  .legal { border-top: 1px solid #2c4a49; margin-top: 40px; padding-top: 22px; font-size: .9rem; color: #b8c8c5; }
</style>
