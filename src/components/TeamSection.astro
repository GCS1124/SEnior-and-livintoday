---
// "The people behind S.A.L.T.": Courtney (founder) beside approved professional contributors.
// Renders nothing until at least one contributor is fully approved (see src/data/team.ts).
import { SITE } from '../data/site';
import { PUBLISHED_CONTRIBUTORS as people } from '../data/team';
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
{people.length > 0 && (
  <section class="section team-sec" id="team" aria-labelledby="team-title">
    <div class="wrap">
      <span class="kicker">Experience you can trust</span>
      <h2 id="team-title">The people behind S.A.L.T.</h2>
      <p class="lead">Real caregiving experience, with professional perspective where it matters.</p>
      <ul class="team">
        <li class="tcard">
          <img class="tphoto" src="/images/courtney-portrait.webp" alt="Courtney Jones" width="240" height="240" loading="lazy" />
          <div>
            <h3>Courtney R. Jones</h3>
            <p class="trole">Founder · The caregiver’s caregiver</p>
            <p>More than {SITE.founder.yearsExperience} years around senior care, hospital and medical billing experience, and author of The Living Legacy Planner. Courtney writes and leads everything you see on S.A.L.T.</p>
            <a class="tmore" href="#courtney">Read Courtney’s story ↑</a>
          </div>
        </li>
        {people.map((p) => (
          <li class="tcard" id={p.slug}>
            {p.photo && p.approvals.photo
              ? <img class="tphoto" src={p.photo} alt={p.photoAlt ?? p.name} width="240" height="240" loading="lazy" />
              : <span class="tphoto tinit" aria-hidden="true">{initials(p.name)}</span>}
            <div>
              <h3>{p.name}{p.credential && p.approvals.licenseVerified ? `, ${p.credential}` : ''}</h3>
              <p class="trole">{p.role}</p>
              {p.bio.map((t) => <p>{t}</p>)}
              <ul class="tfocus" aria-label="Areas of focus">{p.focus.map((f) => <li>{f}</li>)}</ul>
              <p class="tinv"><strong>Role with S.A.L.T.:</strong> {p.involvement}</p>
              <p class="tind">{p.independence}</p>
              {p.verified && <p class="tver">✓ {p.verified}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
