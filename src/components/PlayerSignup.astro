---
// "Before you play" sign-up card: first name + email (both required), a short
// privacy note, and a SEPARATE, optional box for news and offers (never pre-ticked).
//
// Details go only to /api/register, which forwards them to the business's own
// GoHighLevel account. The browser keeps just the first name for this visit; the
// email address lives only in this page's memory (so a win can be sent with it)
// and is never written to browser storage.
//
// When a visitor is ready to play, the page receives a "salt:player" event and
// <html> gets the class "player-ready".
//   window.saltPlayer()          -> first name
//   window.saltReportWin(detail) -> Promise<{ recorded: boolean, emailHint: string, status?: 'sent'|'pending'|'already'|'manual' }>
interface Props { source?: string; title?: string; intro?: string; book?: string; buttonLabel?: string; emailNote?: string }
const {
  source = 'games',
  title = 'Play, win, and earn a $100 coupon code',
  intro = 'Tell us who’s playing. Win a game and we’ll email you a coupon code worth $100 for the SALT Online Store.',
  book = '',
  buttonLabel = 'Start playing',
  emailNote = 'Please enter your correct email. Your reward is sent to this email, and it’s the email you’ll use to sign in at the SALT Online Store.',
} = Astro.props;
---
<section class="signup-wrap" id="player">
  <div class="wrap">
    <div class="signup" data-source={source} data-book={book} data-label={buttonLabel}>
      <div class="pending">
        <h2>{title}</h2>
        <p class="intro">{intro}</p>
        <form class="sform" novalidate>
          <div class="row">
            <label>
              <span>Your first name</span>
              <input name="name" autocomplete="given-name" maxlength="80" required />
            </label>
            <label>
              <span>Your email address</span>
              <input name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required aria-describedby="email-note" />
            </label>
          </div>
          <p class="email-note" id="email-note">📧 {emailNote}</p>
          <label class="hp" aria-hidden="true">Company <input name="company" tabindex="-1" autocomplete="off" /></label>
          <label class="check">
            <input type="checkbox" name="marketing" />
            <span>Yes, send me occasional news and offers from Senior and Living Today. <small>(Optional. You can unsubscribe at any time.)</small></span>
          </label>
          <p class="err" role="alert" hidden></p>
          <div class="acts">
            <button class="btn btn-primary" type="submit">{buttonLabel} <span aria-hidden="true">→</span></button>
          </div>
          <p class="privacy">
            🔒 We only ask for your name and email. We never sell or share them, and we never ask for passwords, bank or Social Security numbers.{' '}
            <a href="/privacy-policy/#signups">How we use your details</a>{!book && <> · <a href="/coupon-code/">How the $100 coupon works</a></>}
          </p>
        </form>
      </div>
      <div class="ready" hidden>
        <p><span class="wave-hand" aria-hidden="true">👋</span> Welcome, <strong class="pname"></strong>!{source === 'games' ? <> Rewards go to <strong class="pmail"></strong>. Have fun!</> : book ? ' Enjoy your reading.' : ' Enjoy!'} <button type="button" class="change">Not you? Change details</button></p>
      </div>
    </div>
  </div>
</section>

<style>
  .signup-wrap { padding: 28px 0 0; }
  .signup { background: #fff; border: 2px solid var(--line); border-top: 6px solid var(--yellow); border-radius: 22px; padding: clamp(20px, 4vw, 32px); box-shadow: 0 14px 34px rgba(34,58,102,.08); max-width: 860px; }
  .signup h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); margin-bottom: .3em; }
  .intro { color: var(--ink-soft); }
  .row { display: grid; gap: 14px; }
  @media (min-width: 680px) { .row { grid-template-columns: 1fr 1.3fr; } }
  .sform label span { display: block; font: 600 1.05rem var(--font-head); color: var(--blue-ink); margin-bottom: 6px; }
  .sform input:not([type='checkbox']) { width: 100%; min-height: 54px; font: 1.15rem var(--font-body); padding: 10px 14px; border: 2px solid var(--line); border-radius: 14px; background: #fff; color: var(--ink); }
  .sform input:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 4px rgba(255,180,0,.3); }
  .sform input[aria-invalid='true'] { border-color: #b3261e; }
  .email-note { margin: 12px 0 0; padding: 10px 14px; background: var(--yellow-soft); border-left: 5px solid var(--yellow); border-radius: 0 12px 12px 0; font-size: 1.02rem; color: var(--blue-ink); }
  .check { display: flex; gap: 12px; align-items: flex-start; margin: 16px 0 4px; cursor: pointer; }
  .check input { width: 26px; height: 26px; margin-top: 2px; flex: none; accent-color: var(--blue); }
  .check span { font: 1.02rem var(--font-body) !important; color: var(--ink) !important; }
  .check small { color: var(--ink-soft); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .err { color: #b3261e; font-weight: 700; margin: 10px 0 0; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 16px; }
  .privacy { font-size: .95rem; color: var(--ink-soft); margin: 14px 0 0; }
  .ready p { margin: 0; font-size: 1.15rem; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .change { background: none; border: 0; min-height: 44px; font: 1rem var(--font-body); color: var(--blue); text-decoration: underline; cursor: pointer; }
  .signup.done { border-top-color: var(--blue); padding-top: 18px; padding-bottom: 18px; }
  @media (prefers-reduced-motion: no-preference) {
    .wave-hand { display: inline-block; animation: hand-wave 1.6s ease-in-out 2; transform-origin: 70% 70%; }
    @keyframes hand-wave { 25% { transform: rotate(16deg); } 50% { transform: rotate(-8deg); } 75% { transform: rotate(12deg); } }
  }
  @media print { .signup-wrap { display: none !important; } }
</style>

<script>
  type WinDetail = { game: string; level?: string; turns?: number };
  type Report = { recorded: boolean; emailHint: string; status?: string };
  type W = Window & { saltPlayer?: () => string; saltReportWin?: (d: WinDetail) => Promise<Report> };
  const KEY = 'salt-player-name'; // first name only, for this visit
  const ss = {
    get: (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch { /* private mode */ } },
    del: (k: string) => { try { sessionStorage.removeItem(k); } catch { /* private mode */ } },
  };
  // Kept in memory only (gone when the page closes).
  let player = '', playerEmail = '', playerSource = 'games', marketing = false;
  let playToken = ''; // signed by the server at sign-up: proves this player signed up before winning
  let winReport: Promise<Report> | null = null;
  const hint = (e: string) => { const [u, d] = e.split('@'); return `${u.slice(0, 2)}${'•'.repeat(Math.max(1, u.length - 2))}@${d}`; };

  (window as W).saltPlayer = () => player;
  (window as W).saltReportWin = (d) => {
    // One reward request per page visit, and only with real sign-up details.
    if (winReport) return winReport;
    if (!player || !playerEmail) return Promise.resolve({ recorded: false, emailHint: '' });
    winReport = fetch('/api/register', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ event: 'game_won', name: player, email: playerEmail, marketing, source: playerSource, game: d.game, level: d.level, turns: d.turns, playToken }),
    }).then(async (r) => ({ recorded: r.ok, emailHint: hint(playerEmail), status: r.ok ? ((await r.json().catch(() => ({})))?.reward?.status || 'manual') : undefined })).catch(() => ({ recorded: false, emailHint: hint(playerEmail) }));
    winReport.then((r) => { if (!r.recorded) winReport = null; }); // allow a retry on the next win if it failed
    return winReport;
  };

  document.querySelectorAll<HTMLElement>('.signup').forEach((box) => {
    const form = box.querySelector<HTMLFormElement>('.sform')!;
    const pending = box.querySelector<HTMLElement>('.pending')!;
    const ready = box.querySelector<HTMLElement>('.ready')!;
    const err = box.querySelector<HTMLElement>('.err')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const nameIn = form.elements.namedItem('name') as HTMLInputElement;
    const emailIn = form.elements.namedItem('email') as HTMLInputElement;
    playerSource = box.dataset.source || 'games';
    nameIn.value = ss.get(KEY) || ''; // friendly prefill; the email is always typed again

    const book = box.dataset.book || '';
    const label = box.dataset.label || 'Start playing';
    const go = (name: string, email: string, readPass?: string, token?: string) => {
      player = name; playerEmail = email; playToken = token || ''; ss.set(KEY, name);
      box.querySelector('.pname')!.textContent = name;
      const pm = box.querySelector('.pmail'); if (pm) pm.textContent = email;
      pending.hidden = true; ready.hidden = false; box.classList.add('done');
      document.documentElement.classList.add('player-ready');
      document.dispatchEvent(new CustomEvent('salt:player', { detail: { name, book, readPass } }));
    };
    const fail = (msg: string, field?: HTMLInputElement) => {
      err.textContent = msg; err.hidden = false;
      [nameIn, emailIn].forEach((f) => f.removeAttribute('aria-invalid'));
      if (field) { field.setAttribute('aria-invalid', 'true'); field.focus(); }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn.disabled) return; // no double submissions
      err.hidden = true;
      const name = nameIn.value.trim().replace(/\s+/g, ' ').slice(0, 80);
      const email = emailIn.value.trim().toLowerCase();
      if (!name) return fail('Please type your first name.', nameIn);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return fail('Please check your email address. It should look like name@example.com.', emailIn);
      marketing = (form.elements.namedItem('marketing') as HTMLInputElement).checked;
      btn.disabled = true; btn.textContent = 'One moment…';
      try {
        const r = await fetch('/api/register', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, marketing, source: playerSource, ...(book ? { book } : {}), company: (form.elements.namedItem('company') as HTMLInputElement).value }),
        });
        const j = await r.json().catch(() => ({}));
        if (r.status === 400) { fail(j.message || 'Please check your details.', j.error === 'email' ? emailIn : nameIn); return; }
        if (r.status === 429) { fail(j.message || 'Please wait a few minutes and try again.'); return; }
        // Saved, or the sign-up service is briefly unavailable: never block the game.
        // (Books only open with the reading pass that a successful sign-up returns.)
        go(name, email, r.ok ? j.readPass : undefined, r.ok ? j.playToken : undefined);
      } catch {
        go(name, email);
      } finally {
        btn.disabled = false; btn.innerHTML = `${label} <span aria-hidden="true">→</span>`;
      }
    });
    box.querySelector('.change')!.addEventListener('click', () => {
      ss.del(KEY); player = ''; playerEmail = ''; playToken = ''; winReport = null;
      document.documentElement.classList.remove('player-ready');
      pending.hidden = false; ready.hidden = true; box.classList.remove('done');
      nameIn.value = ''; emailIn.value = ''; nameIn.focus();
    });
  });
</script>
