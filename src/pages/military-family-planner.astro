---
// The Living Legacy Planner – Military Edition: standalone wholesale landing page (/military-family-planner/).
//
// A dedicated sales funnel for military bookstores, distributors, wholesale buyers and organizations
// serving military families. It uses the site layout in "standalone" mode: no site header, navigation,
// newsletter band, footer or Ask S.A.L.T. button (every other page is unchanged).
//
// Content: src/data/military-landing.ts (taken from the actual planner and its foreword).
// Styles: src/styles/military.css (colours and background design from the Military Edition cover).
// Book reader: the site's own two-page LookInside component, with its opt-in page turn and zoom.
// Wholesale form: src/components/MilitaryWholesaleForm.astro (isolated, so it can be replaced later).
import '../styles/military.css';
import Base from '../layouts/Base.astro';
import Book3D from '../components/Book3D.astro';
import LookInside from '../components/LookInside.astro';
import MilitaryWholesaleForm from '../components/MilitaryWholesaleForm.astro';
import { SITE } from '../data/site';
import { bookSchema, faqSchema } from '../data/schema';
import { MIL_BOOK as B, MIL_SECTIONS, MIL_MILITARY_SECTIONS, MIL_READER, MIL_VALUE, MIL_AUDIENCES, MIL_FAMILY_PHOTOS, MIL_PARTNERS, MIL_INTERESTS, MIL_FAQS } from '../data/military-landing';

const path = '/military-family-planner/';
const description = 'The Living Legacy Planner Military Edition, by a military wife of 23 years. Wholesale, bookstore and institutional inquiries welcome. Read inside.';
const year = new Date().getFullYear();
---
<Base
  title="Military Family Planner: Wholesale & Bookstore Partners"
  {description}
  image={B.cover}
  imageAlt={B.coverAlt}
  schema={[bookSchema({ name: B.title, description, path, amazonUrl: SITE.links.militaryPlannerAmazon, image: B.cover }), faqSchema(MIL_FAQS)]}
  standalone
>
  <div class="mlp">
    <!-- 1. HERO: independent, military-themed (no site header or navigation) -->
    <section class="m-hero" id="top" aria-labelledby="m-title">
      <div class="wrap">
        <div class="m-topbar">
          <span class="m-mark"><img src="/images/logo-registered-small.png" alt="Senior and Living Today logo" width="44" height="44" /> <span>The Living Legacy Planner · <strong>Military Edition</strong></span></span>
          <a class="m-btn m-btn-line m-btn-sm" href="#inquiry" data-track="mil_cta_wholesale">Wholesale inquiries</a>
        </div>
        <div class="m-hero-copy">
          <p class="m-eyebrow">★ For military bookstores, distributors &amp; organizations serving military families ★</p>
          <h1 id="m-title">A Legacy Worth Protecting. <span>A Family Story Worth Preserving.</span></h1>
          <p class="m-lead">Created with military families in mind, <em>The Living Legacy Planner – Military Edition</em> helps families organize important information, preserve meaningful memories, and keep the details that matter together in one place. Bring it to the military families your organization serves.</p>
          <div class="m-ctas">
            <a class="m-btn m-btn-solid" href="#inquiry" data-track="mil_cta_wholesale">Discuss a Wholesale Partnership</a>
            <a class="m-btn m-btn-line" href="#inside" data-track="mil_cta_preview">Read Inside the Planner</a>
          </div>
        </div>
      </div>
      <p class="m-band" aria-hidden="true">★ Plan today. &nbsp;Protect tomorrow. &nbsp;Leave a legacy. ★</p>
    </section>

    <!-- 2. THE BOOK + PRIMARY WHOLESALE CTA -->
    <section class="m-sec" id="edition" aria-labelledby="edition-title">
      <div class="wrap m-edition">
        <div class="m-edition-book">
          <Book3D src={B.cover} alt={B.coverAlt} width={B.coverW} height={B.coverH} eager />
        </div>
        <div>
          <p class="m-kicker">The Military Edition</p>
          <h2 id="edition-title" class="m-h2">A planner military families can keep, use and pass forward</h2>
          <p class="m-lead"><em>{B.title}</em>, by Courtney R. Jones, a military wife of 23 years. Published by Senior and Living Today in paperback and hardcover.</p>
          <ol class="m-sections" aria-label="The 28 sections">
            {MIL_SECTIONS.map((s) => <li class:list={[{ 'm-mil': MIL_MILITARY_SECTIONS.includes(s) }]}>{s}</li>)}
          </ol>
          <p class="m-small">★ Sections written specifically for military life.</p>
          <div class="m-ctas">
            <a class="m-btn m-btn-solid" href="#inquiry" data-track="mil_cta_wholesale">Discuss a Wholesale Partnership</a>
            <a class="m-btn m-btn-line m-btn-sm" href={B.amazon.url} target="_blank" rel="noopener" data-track="mil_buy_amazon">{B.amazon.label} ↗</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. WHY IT MATTERS -->
    <section class="m-sec m-parch" id="why" aria-labelledby="why-title">
      <div class="wrap">
        <p class="m-kicker">Why this planner matters to military families</p>
        <h2 id="why-title" class="m-h2">Military life involves many changes. The important things about a family deserve a place that stays with them.</h2>
        <p class="m-lead">New orders arrive. Deployments happen. Families relocate. Household responsibilities can change overnight. No planner can remove the challenges of military life, but this one keeps the details a family depends on together, ready for whoever needs them.</p>
        <ul class="m-values">
          {MIL_VALUE.map((v) => <li><span class="m-ico" aria-hidden="true">{v.icon}</span><h3>{v.title}</h3><p>{v.text}</p><small>In the planner: {v.sections}</small></li>)}
        </ul>
      </div>
    </section>

    <!-- 4. AUTHOR STORY, WITH HER PHOTOGRAPH -->
    <section class="m-sec" id="story" aria-labelledby="story-title">
      <div class="wrap m-story">
        <figure class="m-portrait">
          <img src="/images/courtney-portrait.webp" alt="Courtney R. Jones, author of the Military Edition, a military wife for 23 years" width="599" height="900" loading="lazy" />
          <figcaption><strong>Courtney R. Jones</strong>Military wife for 23 years (1984–2007) · Author of the Military Edition · Founder of Senior and Living Today</figcaption>
        </figure>
        <div class="m-story-text">
          <p class="m-kicker">The heart behind the Military Edition</p>
          <h2 id="story-title" class="m-h2">Written by a military wife, for military families</h2>
          <p class="m-drop">For 23 years, from 1984 to 2007, Courtney R. Jones was a military wife. Those years taught her, as she puts it, “resilience, flexibility, patience, and the importance of being prepared for the unexpected.”</p>
          <p>She knows how quickly military family life can change. In the planner’s foreword she remembers receiving deployment orders with only a few days’ notice, just one week after relocating to a new state with two children under the age of three. She went through pack-ups, cross-country moves and home inspections, and all the uncertainty that can come with military life.</p>
          <blockquote class="m-pull">“Like so many military spouses, I learned by doing.”<cite>— Courtney R. Jones, from the foreword</cite></blockquote>
          <p>There were times she wished for one place to keep everything she needed to remember, instead of searching through cabinets, notebooks and loose scraps of paper. And there were quiet moments when she wondered: if something happened to her, or to her spouse, would the person stepping in know what to do?</p>
          <p>Those experiences became this planner. Courtney wanted to give military families something more meaningful than another book on a shelf: a practical place to bring together the information, the memories and the family details that matter most.</p>
          <p class="m-sign">“It is my sincere hope that this planner serves you and your family as faithfully as you served ours.”<strong>Courtney R. Jones</strong></p>
        </div>
      </div>
    </section>

    <!-- 5. WHO IT IS DESIGNED FOR: THE WHOLE MILITARY FAMILY -->
    <section class="m-sec m-parch" id="families" aria-labelledby="families-title">
      <div class="wrap">
        <div class="m-center">
          <p class="m-kicker">Who this planner is designed for</p>
          <h2 id="families-title" class="m-h2">For the whole military family, not just the service member</h2>
          <p class="m-lead">Service touches everyone at home: the spouse who keeps the household running, the children who change schools and start over, the parents and grandparents who wait and support, and the veterans who carry the story forward.</p>
        </div>
        <ul class="m-photos">
          {MIL_FAMILY_PHOTOS.map((p) => <li><figure><img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" /><figcaption>{p.title}</figcaption></figure></li>)}
        </ul>
        <div class="m-family-grid">
          <div class="m-family-why">
            <h3 class="m-serif">Why it matters at home</h3>
            <p>When important information lives only in one person’s head, or on one person’s phone, the rest of the family can be left guessing during a deployment, a move or an emergency.</p>
            <p>The Military Edition gives the whole family one shared place: who to call, where documents are kept, how the household runs, and the memories, traditions and letters they want to keep for the next generation.</p>
          </div>
          <ul class="m-aud" aria-label="Family members it is written for">
            {MIL_AUDIENCES.map((a) => <li><h3>{a.title}</h3><p>{a.text}</p></li>)}
          </ul>
        </div>
        <p class="m-credits">Photos: {MIL_FAMILY_PHOTOS.map((p, i) => <>{i > 0 && ' · '}<a href={p.source} target="_blank" rel="noopener">{p.credit}</a></>)}. Use of U.S. Department of Defense imagery does not imply endorsement.</p>
      </div>
    </section>

    <!-- 6. READ INSIDE: the site's two-page book reader, with page turn and zoom -->
    <div id="inside">
      <LookInside editions={[MIL_READER]} title="Read inside the Military Edition" intro="Genuine pages from the planner, exactly as printed. Turn the pages like a real book, two at a time on larger screens, and use Zoom on any page to read it up close." flip zoom />
    </div>

    <!-- 7. WHOLESALE OPPORTUNITIES -->
    <section class="m-sec m-dark m-night" id="wholesale" aria-labelledby="wholesale-title">
      <div class="wrap">
        <p class="m-kicker">Wholesale &amp; institutional partnerships</p>
        <h2 id="wholesale-title" class="m-h2">Bring the Military Edition to More Military Families</h2>
        <p class="m-lead">We welcome conversations with organizations that serve, supply or support military families and would like to purchase the Military Edition in quantity, distribute it, or offer it to their customers and members.</p>
        <div class="m-lists">
          <div><h3>Who we work with</h3><ul>{MIL_PARTNERS.map((p) => <li>{p}</li>)}</ul></div>
          <div><h3>We welcome inquiries about</h3><ul>{MIL_INTERESTS.map((p) => <li>{p}</li>)}</ul></div>
        </div>
        <p class="m-terms">Wholesale pricing, quantities and partnership arrangements are discussed directly with each organization. Tell us about your organization and what you have in mind, and our team will reply personally.</p>
        <div class="m-ctas"><a class="m-btn m-btn-gold" href="#inquiry" data-track="mil_cta_wholesale">Discuss a Wholesale Partnership</a></div>
      </div>
    </section>

    <!-- 8. WHOLESALE INQUIRY FORM (isolated component) -->
    <section class="m-sec m-dark" id="inquiry" aria-labelledby="inquiry-title">
      <div class="wrap m-whole">
        <div>
          <p class="m-kicker">Wholesale inquiry</p>
          <h2 id="inquiry-title" class="m-h2">Start the conversation</h2>
          <ol class="m-next">
            <li><strong>Tell us about your organization</strong> and the military families you serve.</li>
            <li><strong>Our team reviews every inquiry</strong> personally. Nothing is automated.</li>
            <li><strong>We reply by email</strong> to discuss quantities, ordering and partnership arrangements.</li>
          </ol>
          <p class="m-small">Prefer email or phone? <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></p>
        </div>
        <MilitaryWholesaleForm />
      </div>
    </section>

    <!-- 9. FAQ -->
    <section class="m-sec m-parch" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="m-center">
          <p class="m-kicker">Questions</p>
          <h2 id="faq-title" class="m-h2">Military Edition questions, answered</h2>
        </div>
        <div class="m-faq">
          {MIL_FAQS.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>

    <!-- 10. CLOSING (no site footer) -->
    <footer class="m-close" aria-label="Publisher">
      <div class="wrap">
        <img src="/images/logo-512-registered.png" alt="Senior and Living Today logo" width="512" height="510" loading="lazy" />
        <p class="m-close-title">Published by Senior and Living Today®</p>
        <p class="m-close-line">Helping families keep what matters together. Plan today. Protect tomorrow. Leave a legacy.</p>
        <p class="m-close-small">© {year} Senior and Living Today Services LLC · <a href="/privacy-policy/">Privacy policy</a></p>
      </div>
    </footer>
  </div>
</Base>

<script>
  type W = Window & { gtag?: (...a: unknown[]) => void };
  const track = (name: string, params: Record<string, unknown> = {}) => { try { (window as W).gtag?.('event', name, params); } catch { /* ignore */ } };
  document.querySelectorAll<HTMLElement>('[data-track]').forEach((el) => el.addEventListener('click', () => track(el.dataset.track!, { location: el.closest('section')?.id || 'page' })));
  document.querySelector('#inside')?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.li-nav, .li-chips button')) track('mil_preview_turn'); if ((e.target as HTMLElement).closest('.li-zoom')) track('mil_preview_zoom'); });
</script>
