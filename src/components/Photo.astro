---
// A real photo in a hand-placed frame. Use tilt/tape sparingly so it feels personal, not themed.
interface Props { src: string; alt: string; width: number; height: number; caption?: string; tilt?: 'l' | 'r'; tape?: boolean; eager?: boolean; class?: string }
const { src, alt, width, height, caption, tilt, tape = false, eager = false, class: cls } = Astro.props;
---
<figure class:list={['photo', tilt && `tilt-${tilt}`, { tape }, cls]}>
  <img {src} {alt} {width} {height} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
