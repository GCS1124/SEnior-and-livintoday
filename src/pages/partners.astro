---
// Partners landing page (/partners/): standalone wholesale page for the First and Second Editions of
// The Living Legacy Planner. Same layout, components and experience as the Military Edition page
// (/team-up-with-us/), in the original blue-and-yellow branding.
//
// Standalone: the site layout in "standalone" mode (no site header, navigation, newsletter band,
// footer or Ask S.A.L.T. button). Every other page is unchanged.
// Content: src/data/partners-landing.ts. Styles: src/styles/partners.css.
// Book readers: the site's LookInside component with page turn and zoom (same as /team-up-with-us/).
// Wholesale form: src/components/WholesaleForm.astro → /api/partner-wholesale (existing GoHighLevel connection).
// Conversion events fire only if a GA4 ID is configured in src/data/site.ts.
import '../styles/partners.css';
import Base from '../layouts/Base.astro';
import Book3D from '../components/Book3D.astro';
import LookInside from '../components/LookInside.astro';
import Reviews from '../components/Reviews.astro';
import WholesaleForm from '../components/WholesaleForm.astro';
import { SITE } from '../data/site';
import { BRITTNEY } from '../data/team';
import { bookSchema, faqSchema } from '../data/schema';
import { P_BOOKS, P_READER_FIRST, P_READER_SECOND, P_VALUE, P_AUDIENCES, P_PARTNERS, P_INTERESTS, P_FAQS } from '../data/partners-landing';
import { WHOLESALE_ORG_TYPES, WHOLESALE_QUANTITIES, WHOLESALE_EDITIONS, EDITIONS as SAMPLE_EDITIONS } from '../../api/_lib/partner-options.js';

const path = '/partners/';
const description = 'Partner with Senior and Living Today to bring The Living Legacy Planner to the people you serve. Wholesale, bookstore and institutional inquiries welcome.';
const year = new Date().getFullYear();
const [first, second] = P_BOOKS;
---
<Base
  title="Partner Network for Senior-Focused Businesses"
  {description}
  image={second.cover}
  imageAlt={second.alt}
  schema={[
    bookSchema({ name: first.title, description: first.text, path, amazonUrl: first.amazon, image: first.cover }),
    bookSchema({ name: second.title, description: second.text, path, amazonUrl: second.amazon, image: second.cover }),
    faqSchema(P_FAQS),
  ]}
  standalone
>
  <div class="plp">
    <!-- 1. HERO (no site header or navigation) -->
    <section class="m-hero" id="top" aria-labelledby="p-title">
      <div class="wrap">
        <div class="m-topbar">
          <span class="m-mark"><img src="/images/logo-registered-small.png" alt="Senior and Living Today logo" width="44" height="44" /> <span>The Living Legacy Planner · <strong>Partner Network</strong></span></span>
          <a class="m-btn m-btn-line m-btn-sm" href="#inquiry" data-track="partner_cta_wholesale">Wholesale inquiries</a>
        </div>
        <div class="m-hero-copy">
          <p class="m-eyebrow">★ For bookstores, retailers, distributors &amp; organizations serving seniors and families ★</p>
          <h1 id="p-title">Bring the Living Legacy Planner <span>to More Families</span></h1>
          <p class="m-lead">Discover the Living Legacy Planner and explore partnership opportunities to bring this meaningful family resource to bookstores, retailers, organizations, and communities.</p>
          <div class="m-ctas">
            <a class="m-btn m-btn-solid" href="#opportunities" data-track="partner_cta_explore">Explore Partnership Opportunities</a>
            <a class="m-btn m-btn-line" href="#books" data-track="partner_cta_preview">Preview the Books</a>
          </div>
        </div>
      </div>
      <p class="m-band" aria-hidden="true">★ The Living Legacy Planner · First Edition &amp; Second Edition · by Courtney R. Jones ★</p>
    </section>

    <!-- 2. THE TWO EDITIONS -->
    <section class="m-sec" id="books" aria-labelledby="books-title">
      <div class="wrap">
        <div class="m-center">
          <p class="m-kicker">Two editions, one caring purpose</p>
          <h2 id="books-title" class="m-h2">Meet the First and Second Editions</h2>
          <p class="m-lead">Original publications by Courtney R. Jones, published by Senior and Living Today. Choose an edition to read inside.</p>
        </div>
        <div class="m-books">
          {P_BOOKS.map((b, i) => (
            <article class="m-bookcard">
              <Book3D src={b.cover} alt={b.alt} width={b.coverW} height={b.coverH} eager={i === 0} />
              <div>
                <span class="m-tag">{b.tag}</span>
                <h3>{b.title}</h3>
                <p>{b.text}</p>
                <p class="m-small"><strong>Available as:</strong> {b.formats.join(' · ')}</p>
                <div class="m-ctas">
                  <a class="m-btn m-btn-solid" href={b.preview} data-track="partner_cta_read">📖 Read inside</a>
                  <a class="m-btn m-btn-line" href={b.amazon} target="_blank" rel="noopener" data-track="partner_buy_amazon">On Amazon ↗</a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="m-ctas" style="justify-content:center"><a class="m-btn m-btn-solid" href="#inquiry" data-track="partner_cta_wholesale">Discuss a Wholesale Partnership</a></div>
      </div>
    </section>

    <!-- 3. READ INSIDE: FIRST EDITION -->
    <div id="read-first">
      <LookInside id="reader-first" editions={[P_READER_FIRST]} title="Read inside the First Edition" intro="Genuine pages from the original First Edition, in black and white. Turn the pages like a real book, two at a time on larger screens, and use Zoom on any page to read it up close." flip zoom />
    </div>

    <!-- 4. READ INSIDE: SECOND EDITION -->
    <div id="read-second">
      <LookInside id="reader-second" editions={[P_READER_SECOND]} title="Read inside the Second Edition" intro="Genuine pages from the Second Edition, refreshed in full color with warm illustrations. Turn the pages, or use Zoom to read any page up close." flip zoom />
    </div>

    <!-- 5. WHY ORGANIZATIONS OFFER THESE PLANNERS -->
    <section class="m-sec m-parch" id="why" aria-labelledby="why-title">
      <div class="wrap">
        <p class="m-kicker">Why organizations offer the planner</p>
        <h2 id="why-title" class="m-h2">A meaningful resource for the people you already serve</h2>
        <p class="m-lead">Planning ahead, organizing important information and preserving memories matter to older adults and their families. The Living Legacy Planner gives them one caring place to do it.</p>
        <ul class="m-values">
          {P_VALUE.map((v) => <li><span class="m-ico" aria-hidden="true">{v.icon}</span><h3>{v.title}</h3><p>{v.text}</p><small>{v.sections}</small></li>)}
        </ul>

        <div class="m-family-grid">
          <div class="m-family-why">
            <h3 class="m-serif">The people behind the planner</h3>
            <p>Courtney R. Jones has spent more than {SITE.founder.yearsExperience} years around senior care. She wrote The Living Legacy Planner so families never have to guess, and founded Senior and Living Today to help seniors and the people who care for them.</p>
            <div class="m-team">
              <figure><img src="/images/courtney-portrait.webp" alt="Courtney R. Jones, author of The Living Legacy Planner" width="599" height="900" loading="lazy" /><figcaption><strong>Courtney R. Jones</strong>Author and founder</figcaption></figure>
              <figure><img src={BRITTNEY.photo} alt={`${BRITTNEY.name}, ${BRITTNEY.credential}`} width={BRITTNEY.photoW} height={BRITTNEY.photoH} loading="lazy" /><figcaption><strong>{BRITTNEY.name}, {BRITTNEY.credential}</strong>{BRITTNEY.title}</figcaption></figure>
            </div>
          </div>
          <ul class="m-aud" aria-label="Who the planner is for">
            {P_AUDIENCES.map((a) => <li><h3>{a.title}</h3><p>{a.text}</p></li>)}
          </ul>
        </div>
        <div class="m-reviews">
          <h3 class="m-serif m-h2" style="font-size:1.5rem">What readers say about The Living Legacy Planner</h3>
          <p class="m-small">Product reviews written by readers on Amazon, not partner testimonials.</p>
          <Reviews limit={3} />
        </div>
      </div>
    </section>

    <!-- 6. PARTNERSHIP AND WHOLESALE OPPORTUNITIES -->
    <section class="m-sec m-dark m-night" id="opportunities" aria-labelledby="opp-title">
      <div class="wrap">
        <p class="m-kicker">Wholesale &amp; institutional partnerships</p>
        <h2 id="opp-title" class="m-h2">Bring the Living Legacy Planner to the families you serve</h2>
        <p class="m-lead">We welcome conversations with organizations that would like to purchase the First or Second Edition in quantity, offer it to their customers, or bring it into their communities and programs.</p>
        <div class="m-lists">
          <div><h3>Who we work with</h3><ul>{P_PARTNERS.map((p) => <li>{p}</li>)}</ul></div>
          <div><h3>We welcome inquiries about</h3><ul>{P_INTERESTS.map((p) => <li>{p}</li>)}</ul></div>
        </div>
        <p class="m-terms">Wholesale pricing, quantities and partnership arrangements are discussed directly with each organization. Tell us about your organization and what you have in mind, and our team will reply personally.</p>
        <div class="m-ctas"><a class="m-btn m-btn-gold" href="#inquiry" data-track="partner_cta_wholesale">Discuss a Wholesale Partnership</a></div>
      </div>
    </section>

    <!-- 7. WHOLESALE INQUIRY FORM -->
    <section class="m-sec m-dark" id="inquiry" aria-labelledby="inquiry-title">
      <div class="wrap m-whole">
        <div>
          <p class="m-kicker">Wholesale inquiry</p>
          <h2 id="inquiry-title" class="m-h2">Start the conversation</h2>
          <ol class="m-next">
            <li><strong>Tell us about your organization</strong> and the people you serve.</li>
            <li><strong>Our team reviews every inquiry</strong> personally. Nothing is automated.</li>
            <li><strong>We reply by email</strong> to discuss quantities, ordering and partnership arrangements.</li>
          </ol>
          <p class="m-small">Prefer email or phone? <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></p>
        </div>
        <WholesaleForm endpoint="/api/partner-wholesale" orgTypes={WHOLESALE_ORG_TYPES} quantities={WHOLESALE_QUANTITIES} editions={WHOLESALE_EDITIONS} sampleEditions={SAMPLE_EDITIONS} trackPrefix="partner_wholesale" />
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="m-sec m-parch" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="m-center">
          <p class="m-kicker">Questions</p>
          <h2 id="faq-title" class="m-h2">Partner questions, answered</h2>
        </div>
        <div class="m-faq">
          {P_FAQS.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>

    <!-- 9. CLOSING (no site footer) -->
    <footer class="m-close" aria-label="Publisher">
      <div class="wrap">
        <img src="/images/logo-512-registered.png" alt="Senior and Living Today logo" width="512" height="510" loading="lazy" />
        <p class="m-close-title">Published by Senior and Living Today®</p>
        <p class="m-close-line">Helping families keep what matters together, one planner at a time.</p>
        <p class="m-close-small">© {year} Senior and Living Today Services LLC · <a href="/privacy-policy/">Privacy policy</a></p>
      </div>
    </footer>
  </div>
</Base>

<script>
  type W = Window & { gtag?: (...a: unknown[]) => void };
  const track = (name: string, params: Record<string, unknown> = {}) => { try { (window as W).gtag?.('event', name, params); } catch { /* ignore */ } };
  document.querySelectorAll<HTMLElement>('[data-track]').forEach((el) => el.addEventListener('click', () => track(el.dataset.track!, { location: el.closest('section')?.id || 'page' })));
  document.querySelectorAll('#read-first, #read-second').forEach((r) => r.addEventListener('click', (e) => {
    const t = e.target as HTMLElement; const book = r.id === 'read-first' ? 'first' : 'second';
    if (t.closest('.li-nav, .li-chips button')) track('partner_preview_turn', { book });
    if (t.closest('.li-zoom')) track('partner_preview_zoom', { book });
  }));
  // Old campaign links like /partners/?interest=complimentary-copy keep working: tick the sample request.
  const qs = new URLSearchParams(location.search);
  if (qs.get('interest') === 'complimentary-copy') { const box = document.querySelector<HTMLInputElement>('#m-form [name=sample]'); if (box) { box.checked = true; box.dispatchEvent(new Event('change')); } }
</script>
