---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Video from '../../components/Video.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';
import { faqSchema, serviceSchema } from '../../data/schema';

const path = '/services/caregiver-support/';
const crumbs = [{ name: 'Work With Us', href: '/services/' }, { name: 'Caregiver Support', href: path }];
const description = 'Support for family caregivers looking after aging parents or a spouse: private sessions, round-table talks, planning tools and a community that gets it.';
const faqs = [
  { q: 'I’m caring for a parent and I’m overwhelmed. Where do I start?', a: 'Start with a free call. We’ll figure out what’s most urgent, what can wait, and where you can get help, including help for you.' },
  { q: 'Do you provide respite care or caregivers?', a: 'We don’t employ caregivers. We help you understand respite, in-home care and other options, what they cost, and what to ask, so you can choose with confidence.' },
  { q: 'What are the round-table discussions?', a: 'Small group conversations where caregivers can talk openly, share what’s working, and know they’re not alone.' },
];
---
<Base
  title="Support for Family Caregivers"
  {description}
  image="/images/courtney-with-friends.webp"
  breadcrumbs={crumbs}
  schema={[serviceSchema({ name: 'Family Caregiver Support', serviceType: 'Caregiver support and consultation', description, path }), faqSchema(faqs)]}
>
  <PageHero
    title="Caregiver support: you take care of everyone. Who takes care of you?"
    kicker="For the caregiver"
    lead="Private sessions and round-table conversations for sons, daughters, spouses and friends doing the caring. That’s why I call myself the caregiver’s caregiver."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="wrap grid split">
      <div>
        <h2>Three steps to feeling lighter</h2>
        <ol class="steps">
          <li><strong>Book a free call.</strong> Tell me what’s going on. No pressure.</li>
          <li><strong>Choose how you want help.</strong> One-on-one with me, or at your own pace with our community, videos and tools.</li>
          <li><strong>Get it written down.</strong> Fill in <a href="/books/living-legacy-planner/">The Living Legacy Planner</a> together so you have everything in one place.</li>
        </ol>
        <div class="btn-row">
          <a class="btn btn-primary" href={SITE.links.bookCall30} rel="noopener">Book your free call</a>
          <a class="btn btn-outline" href="/community/">Join the community</a>
        </div>
      </div>
      <Photo src="/images/garden-bench.webp" alt="Three women sitting together on a garden bench" width={734} height={1100} tilt="r" tape />
    </div>
  </section>

  <section class="section section-cream">
    <div class="wrap grid split split-rev">
      <div>
        <h2>If your person is going into the hospital</h2>
        <p>Nurses are stretched thin. Your loved one needs an advocate there, ideally around the clock, taking turns. Watch my video, then read <a href="/blog/hospital-advocate/">how to set up an advocate schedule</a>.</p>
      </div>
      <Video id="k5v5Vwbi7QE" title="Importance of Hospital Advocacy" length="13:16" />
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>Tools caregivers tell me they use</h2>
      <ul class="checklist">
        <li><a href={SITE.links.storeDigital} rel="noopener">Caregiver printables</a>: daily care log, medication tracker, appointment planner, family hand-off organizer.</li>
        <li><a href="/resources/final-arrangements-discussion-guide/">The 10-point final arrangements discussion guide</a>.</li>
        <li><a href="/blog/its-okay-to-ask-for-help/">Your “who to call” list</a>, because nobody knows everything.</li>
      </ul>
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand />
</Base>
<style>.steps { padding-left: 1.2em; } .steps li { margin-bottom: .8em; }</style>
