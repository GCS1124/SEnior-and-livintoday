---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import BibSpotlight from '../components/BibSpotlight.astro';
import StoreStory from '../components/StoreStory.astro';
import { SITE, GIFTS, EPRODUCTS, BOOKS, storeLink } from '../data/site';
import { faqSchema } from '../data/schema';

const crumbs = [{ name: 'Holiday Gifts for Seniors', href: '/gifts/' }];
const faqs = [
  { q: 'What do you buy a senior who says they don’t need anything?', a: 'Think comfort, safety and connection: an adult bib with a crumb catcher, a heated neck wrap or hand massager, a large calendar clock, reading glasses, or a planner that helps them get their wishes and memories written down. And time together is the best gift of all.' },
  { q: 'Where do these gifts ship from?', a: 'Comfort and everyday items come from our own SALT Online Store. Courtney’s printed planners and books are sold on Amazon, so you get Amazon’s shipping and returns.' },
  { q: 'Do you have gifts I can send instantly?', a: 'Yes. Our fillable PDF planners and journals are instant downloads from the SALT Online Store, and more e-planners and e-cards are on the way.' },
];
const itemList = { '@type': 'ItemList', name: 'Holiday gifts for seniors', itemListElement: GIFTS.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.name, url: `https://www.saltonlinestore.com/products/${g.handle}` })) };
---
<Base
  title="Holiday Gifts for Seniors & Elderly Parents"
  description="Holiday gifts for seniors picked by Courtney Jones: adult bibs, heated neck and hand massagers, reading glasses, a calendar clock, planners and instant e-planners."
  breadcrumbs={crumbs}
  schema={[faqSchema(faqs), itemList]}
>
  <PageHero
    title="Holiday gifts for seniors, picked with love"
    kicker="Courtney’s gift guide"
    lead="Every year people ask me: “What do I get Mom? She says she doesn’t need anything.” Here’s my answer: things that keep them warm, safe, connected and remembered."
    breadcrumbs={crumbs}
  >
    <nav class="jump" aria-label="Jump to">
      <a href="#comfort">🧣 Warm &amp; comfy</a>
      <a href="#planners">📘 Planners (Amazon)</a>
      <a href="#instant">⚡ Instant downloads</a>
      <a href="#our-story">💛 Our story &amp; $100 store credit</a>
    </nav>
  </PageHero>

  <BibSpotlight campaign="gift-guide-bibs" />

  <section class="section" id="comfort">
    <div class="wrap">
      <span class="kicker">From our SALT Online Store</span>
      <h2>Comfort, safety &amp; everyday helpers</h2>
      <p class="lead">Bibs, heated wraps, reading glasses, a calendar clock, and a few little things that make a big difference.</p>
      <ProductGrid items={GIFTS} campaign="holiday-gift-guide" />
      <div class="btn-row"><a class="btn btn-berry" href={storeLink('/collections/gifts-for-seniors', 'holiday-gift-guide')} rel="noopener" target="_blank">Shop Now: more gifts for seniors ↗</a><a class="btn btn-primary" href={storeLink('/', 'holiday-gift-guide')} rel="noopener" target="_blank">Shop more at www.saltonlinestore.com ↗</a></div>
    </div>
  </section>

  <StoreStory campaign="gifts-story" />

  <section class="section section-cream" id="planners">
    <div class="wrap">
      <span class="kicker">The gift that keeps on giving</span>
      <h2>Courtney’s planners and books</h2>
      <p class="lead">Printed and shipped by <strong>Amazon</strong>, a store you already trust. A planner says, “I care about your wishes and your story.”</p>
      <div class="books">
        {BOOKS.map((b) => (
          <a class="bk" href={b.buy} rel="noopener" target="_blank">
            <img src={b.image} alt={b.alt} width="300" height="430" loading="lazy" />
            <strong>{b.title.replace(': Military Deployment & Family Readiness Edition', ', Military Edition')}</strong>
            <span class="amz">Buy on Amazon ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="instant">
    <div class="wrap">
      <span class="kicker">Last-minute? No problem.</span>
      <h2>Instant-download e-planners &amp; journals</h2>
      <p class="lead">Fillable PDFs you can type into or print. Buy at the SALT store and download right away. New e-planners, e-greeting cards and e-wishes are coming soon.</p>
      <ProductGrid items={EPRODUCTS} campaign="e-planners"  />
      <div class="btn-row"><a class="btn btn-green" href={storeLink('/collections/digital-products', 'e-planners')} rel="noopener" target="_blank">Shop Now: all digital products ↗</a></div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap narrow">
      <span class="kicker">Gift-giving tips from Courtney</span>
      <h2>The best gifts aren’t always in a box</h2>
      <ul class="checklist">
        <li><strong>Give your time.</strong> Put a monthly lunch date on the calendar and wrap the calendar.</li>
        <li><strong>Fix something.</strong> Change the furnace filter, test the smoke detectors, hang the holiday lights.</li>
        <li><strong>Sit down with the photo albums</strong> and write names and dates on the back.</li>
        <li><strong>Take a walk down <a href="/memory-lane/">Memory Lane</a></strong> together. The old newspapers and radio shows are a great way to get the stories flowing.</li>
      </ul>
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand title="Shopping for someone who needs more than a gift?" text="If you’re worried about a parent this holiday season, call me. We’ll talk about what you’re seeing and what might help." />
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 1.2rem; }
  .jump a { background: #fff; border: 2px solid var(--line); border-radius: 999px; padding: 10px 18px; font: 600 1rem var(--font-head); text-decoration: none; color: var(--green-ink); }
  .jump a:hover { border-color: var(--gold); }
  .books { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 2rem; }
  @media (min-width: 700px) { .books { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .books { grid-template-columns: repeat(5, 1fr); } }
  .bk { display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; color: var(--ink); gap: 8px; }
  .bk img { width: 100%; max-width: 200px; border-radius: 3px 8px 8px 3px; box-shadow: -6px 10px 18px rgba(0,0,0,.25); transition: transform .2s; }
  .bk:hover img { transform: translateY(-5px); }
  .bk strong { font: 600 1.05rem/1.3 var(--font-head); }
  .amz { background: var(--yellow); color: var(--blue-ink); font: 600 .95rem var(--font-head); padding: 8px 16px; border-radius: 999px; }
</style>
