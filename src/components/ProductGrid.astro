---
import { storeLink, type Product } from '../data/site';
interface Props { items: Product[]; campaign?: string; cta?: string }
const { items, campaign = 'senior-site', cta = 'See it at the SALT store' } = Astro.props;
---
<ul class="pgrid">
  {items.map((p) => (
    <li class="pcard">
      <a href={storeLink(`/products/${p.handle}`, campaign)} rel="noopener" target="_blank">
        <span class="ptag">{p.tag}</span>
        <span class="pimg"><img src={`/images/shop/${p.key}.webp`} alt={p.name} width="600" height="600" loading="lazy" decoding="async" /></span>
        <strong>{p.name}</strong>
        <span class="why">{p.why}</span>
        <span class="go">{cta} <span aria-hidden="true">↗</span></span>
      </a>
    </li>
  ))}
</ul>
<style>
  .pgrid { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .pcard a { position: relative; height: 100%; display: flex; flex-direction: column; background: #fff; border: 2px solid var(--line); border-radius: 20px; padding: 14px 14px 18px; text-decoration: none; color: var(--ink); transition: transform .15s, border-color .15s, box-shadow .15s; }
  .pcard a:hover { transform: translateY(-4px); border-color: var(--gold); box-shadow: 0 14px 30px rgba(90,31,60,.12); }
  .pimg { display: block; border-radius: 14px; overflow: hidden; background: #f7f2ea; aspect-ratio: 1; margin-bottom: 12px; }
  .pimg img { width: 100%; height: 100%; object-fit: contain; }
  .ptag { position: absolute; top: 22px; left: 22px; z-index: 2; background: var(--berry); color: #fff; font: 600 .82rem var(--font-head); padding: 4px 11px; border-radius: 999px; }
  .pcard strong { font: 600 1.1rem/1.3 var(--font-head); }
  .why { color: var(--ink-soft); font-size: 1rem; margin: 4px 0 12px; }
  .go { margin-top: auto; font: 600 1rem var(--font-head); color: var(--plum); }
</style>
