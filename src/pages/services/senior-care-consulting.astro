---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';
import { faqSchema, serviceSchema } from '../../data/schema';

const path = '/services/senior-care-consulting/';
const crumbs = [{ name: 'Work With Us', href: '/services/' }, { name: 'Senior Care Consulting', href: path }];
const description = 'One-on-one senior care consulting with Courtney Jones: in-home care, senior living choices, hospital stays, bills and family decisions. Your first call is free.';
const faqs = [
  { q: 'What does a senior care consultant actually do?', a: 'I listen to what’s happening, help you sort out what matters most, explain your options in plain English, and help you make a plan. That can be one conversation or ongoing support while you work through it.' },
  { q: 'Do you provide caregivers or medical care?', a: 'No. I don’t send caregivers and I’m not a medical provider. I help you figure out what kind of help you need, what to ask, and who to call.' },
  { q: 'Can you help with medical bills?', a: 'I spent years in medical billing, so I can help you understand a bill, what to ask the billing office, and whether financial assistance might be available. I can’t give legal or financial advice.' },
  { q: 'We’re not in Ohio. Can you still help?', a: 'Yes. Consultations happen by phone or video, so I can help families anywhere in the U.S.' },
];
---
<Base
  title="Senior Care Consulting with Courtney Jones"
  {description}
  image="/images/courtney-home.webp"
  breadcrumbs={crumbs}
  schema={[serviceSchema({ name: 'Senior Care Consulting', serviceType: 'Senior care consulting', description, path }), faqSchema(faqs)]}
>
  <PageHero
    title="Senior care consulting: talk it through with me"
    kicker="Senior care consulting"
    lead="Sometimes you need ideas and a plan. Sometimes you just need to say it all out loud to someone who understands. Either way, I’m here."
    breadcrumbs={crumbs}
  >
    <div class="btn-row">
      <a class="btn btn-primary" href={SITE.links.bookCall} rel="noopener">Book your free consultation</a>
      <a class="btn btn-outline" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap grid split">
      <div>
        <h2>What people call me about</h2>
        <ul class="checklist">
          <li>Mom or Dad can’t live alone safely anymore, and the family can’t agree on what’s next.</li>
          <li>Someone’s going into the hospital and you want to make sure they’re looked after.</li>
          <li>Comparing in-home help, a 55+ community, independent or assisted living.</li>
          <li>A medical bill or insurance letter that makes no sense.</li>
          <li>A relative or friend who wants to move in “for a while.”</li>
          <li>Getting everything written down before something happens.</li>
        </ul>
        <p>Your situation doesn’t have to be on the list. If it’s about getting older or caring for someone who is, it’s my kind of call.</p>
      </div>
      <Photo src="/images/courtney-with-friends.webp" alt="Courtney Jones smiling with an older woman and a friend" width={1100} height={841} tilt="r" tape />
    </div>
  </section>

  <section class="section section-cream">
    <div class="wrap">
      <h2>How I help</h2>
      <div class="grid grid-3" style="margin-top:1.5rem">
        <div class="card"><h3>A plan that fits you</h3><p>Every family is different. We build a plan around the senior’s wishes, health, budget and the people available to help.</p></div>
        <div class="card"><h3>Plain-English explanations</h3><p>Care options, hospital discharge, insurance letters, bills. I’ll explain what it means and what questions to ask.</p></div>
        <div class="card"><h3>Who to call</h3><p>When you need a professional like a lawyer, an elder law attorney or a Medicare counselor, I’ll help you find them and prepare.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <span class="kicker">Keep learning</span>
      <h2>S.A.L.T. Academy</h2>
      <p>Our free community includes webinars and courses for seniors and caregivers on topics like Medicare, health and nutrition planning, and financial and estate planning.</p>
      <div class="btn-row">
        <a class="btn btn-green" href="/community/">Explore the community</a>
        <a class="btn btn-outline" href="/help/">Browse “What do I do when…?”</a>
      </div>
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand />
</Base>
