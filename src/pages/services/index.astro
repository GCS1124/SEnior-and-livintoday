---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, SITE } from '../../data/site';
const crumbs = [{ name: 'Work With Us', href: '/services/' }];
---
<Base
  title="Senior Care Consulting, Virtual Assistant & Caregiver Help"
  description="Work one-on-one with Courtney Jones: senior care consulting, a senior care virtual assistant, and support for family caregivers. Your first call is free."
  breadcrumbs={crumbs}
>
  <PageHero
    title="When you want a real person in your corner"
    kicker="Work with us"
    lead="Videos and planners help a lot. But sometimes you need to talk to somebody about your situation. Here’s how we can help, starting with a free call."
    breadcrumbs={crumbs}
  />
  <section class="section">
    <div class="wrap grid split">
      <div class="svcs">
        {SERVICES.map((s) => (
          <a class="card" href={s.href}>
            <span class="hand">{s.short}</span>
            <h2 class="t">{s.title}</h2>
            <p>{s.summary}</p>
            <span class="more">Find out more →</span>
          </a>
        ))}
      </div>
      <Photo src="/images/courtney-home.webp" alt="Courtney Jones at home, ready to help" width={900} height={600} tilt="r" tape caption="Let’s talk it through." />
    </div>
  </section>
  <section class="section section-cream">
    <div class="wrap narrow">
      <h2>How it works</h2>
      <ol class="steps">
        <li><strong>Book a free call.</strong> Pick a time online or call <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>.</li>
        <li><strong>Tell me what’s going on.</strong> No forms to fill in first. Just talk.</li>
        <li><strong>Get a next step.</strong> Sometimes that’s a resource or a phone number. Sometimes it’s ongoing help. You decide.</li>
      </ol>
      <div class="notice"><strong>Good to know:</strong> we don’t run a facility, send in-home caregivers, or give medical, legal or financial advice. We help you understand your options, get organized, and find the right professionals.</div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .svcs { display: grid; gap: 18px; }
  .svcs .hand { font-size: 1.45rem; }
  .t { font-size: 1.4rem; }
  .steps { padding-left: 1.3em; margin-bottom: 1.8rem; }
  .steps li { margin-bottom: .8em; }
</style>
