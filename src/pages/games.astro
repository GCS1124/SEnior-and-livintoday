---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import PlayerSignup from '../components/PlayerSignup.astro';
import { faqSchema } from '../data/schema';
import { COLORING } from '../data/coloring';
const crumbs = [{ name: 'Games & Coloring', href: '/games/' }];
const faqs = [
  { q: "Is this coloring book really free?", a: "Yes, completely free. There's no sign-up, no download and no ads. Just pick a picture and start coloring." },
  { q: "Do I have to color inside the lines?", a: "Nope. Pick a color and tap a shape, and it fills right in. That makes it a lot easier if your hands are stiff or a little shaky. Tap again to change the color, or use Undo." },
  { q: "Can I print my picture?", a: "Yes. When you're done, tap Print. Hang it on the fridge, mail it to someone, or turn it into a card with our greeting card maker." },
  { q: "Is the memory game timed?", a: "No, there's no clock at all. Flip two cards at a time and find the pairs at your own pace. Take a break and come back whenever you like." },
  { q: "Can I play on a tablet or phone?", a: "Yes. Both games work on a computer, tablet or phone. A tablet is often easiest, since you just tap with your finger." },
];
// Crayon box for the coloring book (a real range of colours, so these are not brand colours).
const swatches = [
  { c: '#e63946', n: 'Red' }, { c: '#ff8fab', n: 'Rose pink' }, { c: '#cc3366', n: 'Raspberry' }, { c: '#ffae00', n: 'Gold' },
  { c: '#fff200', n: 'Sunshine yellow' }, { c: '#f4a261', n: 'Orange' }, { c: '#8bc34a', n: 'Grass green' }, { c: '#47704c', n: 'Forest green' },
  { c: '#4fc3f7', n: 'Sky blue' }, { c: '#1d4ed8', n: 'Royal blue' }, { c: '#9b5de5', n: 'Purple' }, { c: '#8d6e63', n: 'Brown' },
  { c: '#9e9e9e', n: 'Gray' }, { c: '#ffffff', n: 'White (eraser)' },
];
---
<Base
  title="Free Online Coloring Book & Memory Game for Seniors"
  description="A free online coloring book for seniors with 16 pictures and big buttons, a printable greeting card maker, and a gentle memory match game."
  breadcrumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    title="Games & coloring, just for fun"
    kicker="Take a break"
    lead="No sign-up, no ads, big buttons. Color a picture, then try the memory game. Good for the mind, good for the soul."
    breadcrumbs={crumbs}
  >
    <nav class="jump" aria-label="Jump to"><a href="#color">🖍️ Coloring book</a><a href="/greeting-cards/">💌 Greeting card maker</a><a href="#match">🃏 Memory match</a></nav>
  </PageHero>

  <PlayerSignup source="games" />

  <!-- COLORING BOOK -->
  <section class="section" id="color">
    <div class="wrap">
      <h2>Online coloring book</h2>
      <p class="lead">Relax and color at your own pace. There’s no wrong way to do it.</p>
      <ol class="howto" aria-label="How to color">
        <li><span>1</span> Choose a picture</li>
        <li><span>2</span> Pick a color</li>
        <li><span>3</span> Tap a shape to fill it</li>
        <li><span>4</span> Print it when you’re done</li>
      </ol>
      <p class="hand">Choose a picture ({COLORING.length} to pick from)</p>
      <div class="pages" role="tablist" aria-label="Choose a picture">
        {COLORING.map((pg, i) => (
          <button type="button" class:list={['pg', { on: i === 0 }]} data-page={String(i)} aria-label={pg.name}>
            <svg viewBox="0 0 400 400" aria-hidden="true" set:html={pg.svg} />
            <span>{pg.emoji} {pg.name}</span>
          </button>
        ))}
      </div>
      <p class="hand">Color it in! Tap any shape.</p>
      <p class="gate-msg"><a href="#player">👆 Type your first name above to start coloring.</a></p>
      <div class="studio needs-player">
        <div class="canvas" id="canvas">
          {COLORING.map((pg, i) => (
            <svg viewBox="0 0 400 400" data-art={String(i)} role="img" aria-label={`${pg.name} to color`} hidden={i !== 0} set:html={pg.svg} />
          ))}
        </div>
        <div class="tools">
          <p class="hand">Pick a color</p>
          <div class="swatches" role="group" aria-label="Colors">
            {swatches.map((s, i) => <button type="button" class:list={['sw', { on: i === 3 }]} data-color={s.c} data-name={s.n} style={`background:${s.c}`} aria-label={s.n} aria-pressed={i === 3 ? 'true' : 'false'} title={s.n}></button>)}
          </div>
          <p class="picked" aria-live="polite">You picked: <strong id="picked-name">Gold</strong> <span class="dot" id="picked-dot" aria-hidden="true"></span></p>
          <div class="btn-row">
            <button type="button" class="btn btn-outline" id="undo">↶ Undo</button>
            <button type="button" class="btn btn-outline" id="clear">Start over</button>
            <button type="button" class="btn btn-berry" id="print">🖨️ Print</button>
            <button type="button" class="btn btn-primary" id="finished">✓ I’m finished!</button>
          </div>
          <p class="cstatus" id="cstatus" role="status" aria-live="polite"></p>
          <p class="tip">Want to send it to someone? Print it, or make a <a href="/greeting-cards/">greeting card</a> with a photo and your own message.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MEMORY MATCH -->
  <section class="section section-cream" id="match">
    <div class="wrap">
      <h2>Memory match: old-time favorites</h2>
      <p class="lead">Take your time. There’s no clock and no rush.</p>
      <ol class="howto" aria-label="How to play memory match">
        <li><span>1</span> Choose how many cards</li>
        <li><span>2</span> Tap a card to turn it over</li>
        <li><span>3</span> Tap a second card to look for its twin</li>
        <li><span>4</span> Find every pair to finish</li>
      </ol>
      <div class="levels" role="group" aria-label="How many cards">
        <button type="button" class="lvl" data-pairs="6" aria-pressed="false">😊 Easy <small>12 cards</small></button>
        <button type="button" class="lvl" data-pairs="8" aria-pressed="true">🙂 Normal <small>16 cards</small></button>
        <button type="button" class="lvl" data-pairs="10" aria-pressed="false">💪 Challenge <small>20 cards</small></button>
      </div>
      <p class="score">
        <span>Turns: <strong id="turns">0</strong></span>
        <span>Pairs found: <strong id="pairs">0</strong> of <strong id="total">8</strong></span>
        <span class="best" id="best" hidden>Your best: <strong id="best-n"></strong> turns</span>
        <button type="button" class="btn btn-outline" id="restart">↻ New game</button>
      </p>
      <p class="feedback" id="feedback" role="status" aria-live="polite">Tap any card to begin.</p>
      <p class="gate-msg"><a href="#player">👆 Type your first name above to start playing.</a></p>
      <div class="board needs-player" id="board"></div>
      <p class="win" id="win" hidden>🎉 You found them all in <strong id="win-turns"></strong> turns! <a href="/memory-lane/">Take a walk down Memory Lane →</a></p>
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand title="Enjoyed that? Come say hello." text="If you ever need a hand with something more serious, I’m a phone call away." />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 1.2rem; }
  .jump a { background: #fff; border: 2px solid var(--line); border-radius: 999px; padding: 10px 18px; font: 600 1rem var(--font-head); text-decoration: none; color: var(--green-ink); }
  .pages { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 12px; margin: .6rem 0 1.6rem; }
  .pg { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 8px 8px 10px; border-radius: 16px; border: 2px solid var(--line); background: #fff; cursor: pointer; font: 600 .92rem/1.2 var(--font-head); color: var(--ink); }
  .pg svg { width: 100%; height: auto; pointer-events: none; }
  .pg svg :global(.c) { fill: #fff; stroke: #2b2b2b; stroke-width: 5; }
  .pg svg :global(path.c[fill='none']) { fill: none; }
  .pg:hover { border-color: var(--gold); }
  .pg.on { background: var(--gold-soft); border-color: var(--gold); box-shadow: 0 0 0 2px var(--gold); }
  .tip { font-size: 1rem; color: var(--ink-soft); margin-top: 1rem; }
  .studio { display: grid; gap: 28px; align-items: start; }
  .studio > * { min-width: 0; }
  @media (min-width: 900px) { .studio { grid-template-columns: 1.2fr .8fr; } }
  .canvas { background: #fff; border: 3px solid var(--line); border-radius: 22px; padding: 12px; box-shadow: 0 14px 34px rgba(34,58,102,.08); }
  .canvas svg { width: 100%; height: auto; display: block; }
  .canvas svg[hidden] { display: none; }
  .canvas :global(.c) { fill: #fff; stroke: #2b2b2b; stroke-width: 3; stroke-linejoin: round; cursor: pointer; transition: fill .15s; }
  .canvas :global(path.c[fill='none']) { fill: none; }
  .swatches { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; margin: .6rem 0 1rem; }
  .sw { aspect-ratio: 1; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 2px var(--line); cursor: pointer; min-width: 44px; }
  .sw.on { box-shadow: 0 0 0 4px var(--ink); transform: scale(1.08); }
  .sw { transition: transform .15s; }
  .sw:hover { transform: scale(1.08); }
  .picked { display: flex; align-items: center; gap: 8px; font-size: 1.1rem; margin: 0 0 1rem; }
  .picked .dot { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--line); background: #ffae00; display: inline-block; }
  .howto { list-style: none; padding: 0; margin: 1rem 0 1.4rem; display: flex; flex-wrap: wrap; gap: 10px; }
  .howto li { display: flex; align-items: center; gap: 10px; background: #fff; border: 2px solid var(--line); border-radius: 999px; padding: 8px 16px 8px 8px; font: 600 1.02rem var(--font-head); color: var(--blue-ink); }
  .howto span { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--yellow); color: var(--blue-ink); font-weight: 700; }
  .levels { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 1rem; }
  .lvl { min-height: 56px; padding: 8px 20px; border-radius: 16px; border: 2px solid var(--line); background: #fff; font: 600 1.1rem var(--font-head); color: var(--blue-ink); cursor: pointer; display: flex; flex-direction: column; align-items: flex-start; line-height: 1.2; }
  .lvl small { font: 400 .9rem var(--font-body); color: var(--ink-soft); }
  .lvl[aria-pressed='true'] { border-color: var(--blue); background: var(--blue-soft); box-shadow: 0 0 0 2px var(--blue); }
  .feedback { min-height: 1.8em; font: 600 1.2rem var(--font-head); color: var(--blue); margin: .4rem 0 .2rem; }
  .best { color: var(--ink-soft); }
  .score { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; font-size: 1.2rem; }
  .board { display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: clamp(8px, 3vw, 14px); max-width: calc(var(--cols, 4) * 160px); margin-top: 1rem; }
  :global(.card-m) { aspect-ratio: 1; border-radius: 16px; border: 3px solid var(--gold); background: var(--blue); font-size: 0; cursor: pointer; display: grid; place-items: center; transition: transform .25s, background .2s, box-shadow .2s; }
  :global(.card-m:hover:not(.up):not(.done)) { transform: translateY(-3px); box-shadow: 0 8px 18px rgba(20,33,61,.25); }
  :global(.card-m:focus-visible) { outline: 4px solid var(--yellow-shadow); outline-offset: 3px; }
  :global(.card-m.match) { animation: pair-pop .5s ease; }
  :global(.card-m.miss) { animation: pair-shake .45s ease; }
  @keyframes pair-pop { 40% { transform: scale(1.1); } }
  @keyframes pair-shake { 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
  @media (prefers-reduced-motion: reduce) { :global(.card-m), :global(.card-m.match), :global(.card-m.miss) { animation: none !important; transition: none; } }
  :global(.card-m)::after { content: 'S.A.L.T.'; color: var(--sun); font: 700 .85rem var(--font-head); }
  :global(.card-m.up), :global(.card-m.done) { background: #fff; font-size: clamp(2rem, 7vw, 3.2rem); }
  :global(.card-m.up)::after, :global(.card-m.done)::after { content: none; }
  :global(.card-m.done) { border-color: var(--blue); background: var(--yellow-soft); }
  .win { font: 600 1.4rem var(--font-head); color: var(--green-ink); margin-top: 1.4rem; }
  .gate-msg { display: none; font: 600 1.15rem var(--font-head); background: var(--yellow-soft); border: 2px dashed var(--yellow); border-radius: 14px; padding: 12px 16px; margin: 0 0 1rem; }
  .gate-msg a { color: var(--blue-ink); text-decoration: none; }
  :global(html:not(.player-ready)) .gate-msg { display: block; }
  :global(html:not(.player-ready)) .needs-player { opacity: .45; pointer-events: none; filter: grayscale(.3); }
  .cstatus { min-height: 1.4em; margin: .6rem 0 0; font-weight: 700; color: var(--blue); }
  @media print {
    :global(body > *:not(main)), :global(.page-hero), :global(.wave), .tools, .pages, #match, :global(.cta) { display: none !important; }
    .canvas { border: 0; box-shadow: none; }
  }
</style>

<script>
  type Reward = { recorded: boolean; emailHint: string };
  type Cel = (o: { mode?: 'win' | 'done'; name?: string; achievement: string; detail?: string; artwork?: HTMLCanvasElement; reward?: Reward; fileName?: string; onPlayAgain?: () => void }) => void;
  const reportWin = (d: { game: string; level?: string; turns?: number }) =>
    (window as unknown as { saltReportWin?: (d: { game: string; level?: string; turns?: number }) => Promise<Reward> }).saltReportWin?.(d) ?? Promise.resolve({ recorded: false, emailHint: '' });
  const celebrate = (o: Parameters<Cel>[0]) => (window as unknown as { saltCelebrate?: Cel }).saltCelebrate?.(o);
  const playerName = () => (window as unknown as { saltPlayer?: () => string }).saltPlayer?.() || 'Friend';
  // ---- Coloring book ----
  let color = '#ffae00';
  const history: [SVGElement, string][] = [];
  const arts = document.querySelectorAll<SVGSVGElement>('#canvas svg');
  document.querySelectorAll<HTMLButtonElement>('.sw').forEach((b) => b.addEventListener('click', () => {
    color = b.dataset.color!;
    document.querySelectorAll<HTMLButtonElement>('.sw').forEach((s) => { s.classList.toggle('on', s === b); s.setAttribute('aria-pressed', String(s === b)); });
    document.getElementById('picked-name')!.textContent = b.dataset.name ?? '';
    (document.getElementById('picked-dot') as HTMLElement).style.background = color;
  }));
  document.querySelectorAll<HTMLButtonElement>('.pg').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.pg').forEach((p) => p.classList.toggle('on', p === b));
    arts.forEach((a) => a.toggleAttribute('hidden', a.dataset.art !== b.dataset.page));
    document.getElementById('canvas')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }));
  document.querySelectorAll<SVGElement>('#canvas .c').forEach((el) => {
    if (el.getAttribute('fill') === 'none') return;
    el.addEventListener('click', () => { history.push([el, el.style.fill]); el.style.fill = color; });
  });
  document.getElementById('undo')!.addEventListener('click', () => { const h = history.pop(); if (h) h[0].style.fill = h[1]; });
  document.getElementById('clear')!.addEventListener('click', () => {
    const visible = [...arts].find((a) => !a.hasAttribute('hidden'));
    visible?.querySelectorAll<SVGElement>('.c').forEach((el) => (el.style.fill = ''));
  });
  document.getElementById('print')!.addEventListener('click', () => window.print());

  // "I'm finished!" — a completion moment (not a win), once a few shapes are colored.
  const cstatus = document.getElementById('cstatus')!;
  document.getElementById('finished')!.addEventListener('click', async () => {
    const art = [...arts].find((a) => !a.hasAttribute('hidden'));
    if (!art) return;
    const filled = [...art.querySelectorAll<SVGElement>('.c')].filter((el) => el.style.fill && el.style.fill !== 'rgb(255, 255, 255)').length;
    if (filled < 3) { cstatus.textContent = 'Color a few more shapes first, then tap “I’m finished!” again.'; return; }
    cstatus.textContent = '';
    const pageName = document.querySelector<HTMLElement>('.pg.on span')?.textContent?.trim() ?? 'coloring page';
    const canvas = await artworkCanvas(art, playerName());
    celebrate({ mode: 'done', name: playerName(), achievement: `finished the ${pageName} coloring page`, detail: `${filled} shapes colored`, artwork: canvas, fileName: 'my-salt-coloring-page' });
  });

  // Turns the colored SVG into a picture with a small caption.
  async function artworkCanvas(svg: SVGSVGElement, name: string) {
    const clone = svg.cloneNode(true) as SVGSVGElement;
    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    clone.setAttribute('width', '1000'); clone.setAttribute('height', '1000');
    clone.removeAttribute('hidden');
    clone.querySelectorAll<SVGElement>('.c').forEach((el) => {
      const none = el.getAttribute('fill') === 'none';
      el.setAttribute('fill', none ? 'none' : (el.style.fill || '#ffffff'));
      el.setAttribute('stroke', '#2b2b2b'); el.setAttribute('stroke-width', '3'); el.setAttribute('stroke-linejoin', 'round');
    });
    const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml' }));
    const img = await new Promise<HTMLImageElement>((ok, no) => { const i = new Image(); i.onload = () => ok(i); i.onerror = no; i.src = url; });
    const c = document.createElement('canvas'); c.width = 1100; c.height = 1260;
    const x = c.getContext('2d')!;
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, c.width, c.height);
    x.strokeStyle = '#223a66'; x.lineWidth = 10; x.strokeRect(20, 20, c.width - 40, c.height - 40);
    x.drawImage(img, 50, 50, 1000, 1000);
    URL.revokeObjectURL(url);
    await document.fonts?.load('600 64px Caveat').catch(() => null);
    x.textAlign = 'center'; x.fillStyle = '#14213d'; x.font = '600 64px Caveat, cursive';
    x.fillText(name && name !== 'Friend' ? `Colored by ${name}` : 'My coloring page', c.width / 2, 1135, c.width - 120);
    x.fillStyle = '#223a66'; x.font = '700 26px Poppins, sans-serif';
    x.fillText(`Senior and Living Today · ${new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}`, c.width / 2, 1195);
    return c;
  }

  // ---- Memory match ----
  const ICONS: [string, string][] = [
    ['☎️', 'Telephone'], ['📻', 'Radio'], ['💿', 'Record'], ['📺', 'Television'], ['⌨️', 'Typewriter keys'],
    ['🥛', 'Milk bottle'], ['🎞️', 'Film reel'], ['✉️', 'Letter'], ['📷', 'Camera'], ['🕰️', 'Mantel clock'],
  ];
  const NICE = ['A match! Well done.', 'Lovely, a pair!', 'You found one!', 'Great memory!', 'That’s a pair!'];
  const board = document.getElementById('board')!;
  const $ = (id: string) => document.getElementById(id)!;
  const turnsEl = $('turns'), pairsEl = $('pairs'), totalEl = $('total'), win = $('win'), fb = $('feedback'), bestEl = $('best'), bestN = $('best-n');
  let open: HTMLButtonElement[] = [], turns = 0, pairs = 0, lock = false, size = 8, celebrated = false;
  const LEVEL: Record<number, string> = { 6: 'Easy', 8: 'Normal', 10: 'Challenge' };
  const store = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } } };
  const showBest = () => { const v = store.get(`salt-match-best-${size}`); bestEl.hidden = !v; bestN.textContent = v ?? ''; };
  function deal() {
    const picks = ICONS.slice(0, size);
    const deck = [...picks, ...picks].map((x) => ({ x, r: Math.random() })).sort((p, q) => p.r - q.r).map((o) => o.x);
    board.innerHTML = ''; open = []; turns = 0; pairs = 0; lock = false; celebrated = false; win.hidden = true;
    turnsEl.textContent = '0'; pairsEl.textContent = '0'; totalEl.textContent = String(size);
    board.style.setProperty('--cols', size === 10 ? '5' : '4');
    fb.textContent = 'Tap any card to begin.';
    deck.forEach(([icon, name], i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'card-m'; b.dataset.icon = icon; b.dataset.name = name; b.textContent = icon;
      b.dataset.pos = `${i + 1} of ${deck.length}`;
      b.setAttribute('aria-label', `Card ${b.dataset.pos}, face down`);
      b.addEventListener('click', () => flip(b));
      board.appendChild(b);
    });
    showBest();
  }
  function flip(b: HTMLButtonElement) {
    if (lock || b.classList.contains('up') || b.classList.contains('done')) return;
    b.classList.add('up'); b.setAttribute('aria-label', `Card ${b.dataset.pos}: ${b.dataset.name}`); open.push(b);
    if (open.length < 2) { fb.textContent = `${b.dataset.name}. Now find its twin.`; return; }
    turns++; turnsEl.textContent = String(turns);
    const [a, c] = open;
    if (a.dataset.icon === c.dataset.icon) {
      [a, c].forEach((x) => { x.classList.add('done', 'match'); x.setAttribute('aria-label', `Card ${x.dataset.pos}: ${x.dataset.name}, matched`); });
      open = []; pairs++; pairsEl.textContent = String(pairs);
      fb.textContent = `${NICE[pairs % NICE.length]} ${a.dataset.name}s.`;
      if (pairs === size) {
        $('win-turns').textContent = String(turns);
        win.hidden = false;
        fb.textContent = `All ${size} pairs found!`;
        const prev = Number(store.get(`salt-match-best-${size}`) || 0);
        if (!prev || turns < prev) store.set(`salt-match-best-${size}`, String(turns));
        showBest();
        // Only reached when every pair on the board has really been matched.
        const allMatched = board.querySelectorAll('.card-m.done').length === size * 2;
        if (allMatched && !celebrated) {
          celebrated = true;
          const isBest = !prev || turns < prev;
          // Record the win (and the $100 reward request) first, then celebrate.
          const finalTurns = turns;
          Promise.all([reportWin({ game: 'memory-match', level: LEVEL[size], turns: finalTurns }), new Promise((r) => setTimeout(r, 650))])
            .then(([reward]) => celebrate({
              mode: 'win', name: playerName(), reward,
              achievement: `found all ${size} pairs in Memory Match`,
              detail: `${LEVEL[size]} level · ${finalTurns} turns${isBest && prev ? ' · New personal best!' : ''}`,
              fileName: 'salt-100-store-credit-voucher', onPlayAgain: deal,
            }));
        }
      }
    } else {
      lock = true;
      fb.textContent = 'Not a pair. Take a good look, then try again.';
      setTimeout(() => { a.classList.add('miss'); c.classList.add('miss'); }, 500);
      setTimeout(() => {
        [a, c].forEach((x) => { x.classList.remove('up', 'miss'); x.setAttribute('aria-label', `Card ${x.dataset.pos}, face down`); });
        open = []; lock = false;
      }, 1500);
    }
  }
  document.querySelectorAll<HTMLButtonElement>('.lvl').forEach((btn) => btn.addEventListener('click', () => {
    size = Number(btn.dataset.pairs);
    document.querySelectorAll('.lvl').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
    deal();
  }));
  $('restart').addEventListener('click', deal);
  deal();
</script>
