---
import { REVIEWS, SITE } from '../data/site';
interface Props { limit?: number }
const { limit = 5 } = Astro.props;
---
<div class="revs">
  {REVIEWS.slice(0, limit).map((r) => (
    <blockquote class="rev">
      <p class="stars" aria-label="5 out of 5 stars">★★★★★</p>
      <p class="rt">{r.title}</p>
      <p class="rx clamp">“{r.text}”</p>
      <button type="button" class="more-btn" aria-expanded="false">Read more</button>
      <footer><strong>{r.name}</strong> · Amazon · {r.date}{r.verified && <span class="vp"> · Verified Purchase</span>}</footer>
    </blockquote>
  ))}
</div>
<p class="src">Reviews of The Living Legacy Planner, quoted from <a href={SITE.links.livingLegacyPlannerAmazon} rel="noopener" target="_blank">Amazon</a>.</p>
<style>
  .revs { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); align-items: start; }
  .rev { margin: 0; background: #fff; border: 2px solid var(--line); border-radius: var(--radius); padding: 20px 22px; }
  .stars { margin: 0 0 .2rem; }
  .rt { font: 600 1.08rem/1.3 var(--font-head); color: var(--green-ink); margin-bottom: .4rem; }
  .rx { color: var(--ink); margin-bottom: .3rem; }
  .clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .more-btn { background: none; border: 0; padding: 10px 0; min-height: 44px; font: 700 1rem var(--font-head); color: var(--berry); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .rev footer { font-size: .92rem; color: var(--ink-soft); margin-top: .3rem; }
  .vp { color: var(--blue); font-weight: 700; }
  .src { font-size: .95rem; color: var(--ink-soft); }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.more-btn').forEach((b) => {
    const t = b.previousElementSibling as HTMLElement;
    requestAnimationFrame(() => { if (t.scrollHeight <= t.clientHeight + 2) b.hidden = true; });
    b.addEventListener('click', () => {
      const open = t.classList.toggle('clamp') === false;
      b.textContent = open ? 'Show less' : 'Read more';
      b.setAttribute('aria-expanded', String(open));
    });
  });
</script>
