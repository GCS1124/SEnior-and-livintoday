---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import { articleSchema } from '../../data/schema';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}/`;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const crumbs = [{ name: 'Blog', href: '/blog/' }, { name: d.title, href: path }];
---
<Base
  title={d.seoTitle ?? d.title}
  description={d.description}
  type="article"
  image={d.image}
  imageAlt={d.imageAlt}
  breadcrumbs={crumbs}
  publishedTime={d.published.toISOString()}
  modifiedTime={(d.updated ?? d.published).toISOString()}
  schema={[articleSchema({ title: d.title, description: d.description, path, published: d.published, updated: d.updated, image: d.image })]}
>
  <PageHero title={d.title} breadcrumbs={crumbs}>
    <p class="byline">
      By <a href="/about/" rel="author">{SITE.founder.name}</a>, {SITE.founder.jobTitle} ·
      <time datetime={d.published.toISOString()}>{fmt(d.published)}</time>
      {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>}
    </p>
  </PageHero>
  <article class="section">
    <div class="wrap">
      {d.image && <div class="prose"><Photo src={d.image} alt={d.imageAlt ?? ''} eager /></div>}
      <div class="prose"><Content /></div>
      <aside class="author prose">
        <p><strong>About the author.</strong> {SITE.founder.name} founded Senior and Living Today after more than {SITE.founder.yearsExperience} years as an advocate for seniors and caregivers. She is the author of <a href="/books/living-legacy-planner/">The Living Legacy Planner</a> and <a href="/books/relics-of-the-century/">Relics of the Century</a>. <a href="/about/">Read Courtney’s story</a>.</p>
      </aside>
    </div>
  </article>
  <CtaBand />
</Base>
<style>
  .byline { color: var(--ink-soft); font-size: 1rem; }
  .author { margin-top: 3rem; padding: 22px 26px; background: var(--salt); border-radius: var(--radius); font-size: 1.05rem; }
  .author p { margin: 0; }
</style>
