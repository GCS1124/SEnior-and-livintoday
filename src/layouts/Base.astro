---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Crumb { name: string; href: string }
interface Props {
  title: string;              // aim for 50-60 characters
  description: string;        // aim for 140-160 characters
  image?: string;             // absolute or root-relative, 1200x630
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbs?: Crumb[];      // excluding Home
  schema?: Record<string, unknown>[]; // extra JSON-LD nodes for this page
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  imageAlt = 'Senior and Living Today - care, comfort and community for seniors',
  type = 'website',
  noindex = false,
  breadcrumbs = [],
  schema = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const isHome = Astro.url.pathname === '/';
// Append the brand only when the result still fits in Google's ~60-character title display.
const fullTitle =
  isHome || title.includes(SITE.name) ? title
  : `${title} | ${SITE.name}`.length <= 60 ? `${title} | ${SITE.name}`
  : `${title} | S.A.L.T.`.length <= 62 ? `${title} | S.A.L.T.`
  : title;

const orgId = `${SITE.url}/#organization`;
const personId = `${SITE.url}/#courtney-jones`;

// Site-wide entity graph: Organization + founder + WebSite.
const graph: Record<string, unknown>[] = [
  {
    '@type': ['Organization', 'ProfessionalService'],
    '@id': orgId,
    name: SITE.name,
    alternateName: ['S.A.L.T.', 'SALT', 'Senior & Living Today'],
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
    image: ogImage,
    description: SITE.description,
    email: SITE.email,
    telephone: SITE.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.city,
      addressRegion: SITE.address.region,
      postalCode: SITE.address.postalCode,
      addressCountry: SITE.address.country,
    },
    areaServed: { '@type': 'Country', name: 'United States' },
    founder: { '@id': personId },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: SITE.phone,
      email: SITE.email,
      contactType: 'customer service',
      areaServed: 'US',
      availableLanguage: 'English',
    },
    ...(SITE.sameAs.length ? { sameAs: SITE.sameAs } : {}),
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: SITE.founder.name,
    jobTitle: SITE.founder.jobTitle,
    url: SITE.founder.url,
    worksFor: { '@id': orgId },
    knowsAbout: ['Senior care', 'Caregiving', 'End-of-life planning', 'Aging in place', 'Senior living options'],
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    publisher: { '@id': orgId },
    inLanguage: 'en-US',
  },
];

if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, SITE.url).href,
    })),
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...graph, ...schema] });
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#12403f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/rss.xml" />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />

    {SITE.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
        <script is:inline define:vars={{ id: SITE.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
