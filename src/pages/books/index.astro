---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { LIBRARY } from '../../data/library';
import { SITE } from '../../data/site';

const crumbs = [{ name: 'Books & Reading', href: '/books/' }];
---
<Base
  title="Books & Reading: Read Free Online"
  description="Books and guides by Courtney R. Jones of Senior and Living Today. Read free online with big, adjustable text, then buy your own copy."
  breadcrumbs={crumbs}
  schema={[{ '@type': 'ItemList', name: 'Books by Courtney R. Jones', itemListElement: LIBRARY.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.title })) }]}
>
  <PageHero
    title="Books & reading"
    kicker="Curl up with a good read"
    lead="Read free online with big, easy-to-read text you can make larger or smaller. When you find one you love, buy your own copy."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="wrap">
      <ul class="lib">
        {LIBRARY.map((b) => (
          <li class="book">
            <div class="cover">
              {b.cover
                ? <img src={b.cover} alt={b.coverAlt ?? b.title} width="300" height="430" loading="lazy" />
                : <div class="tcover" aria-hidden="true"><span class="tlogo">SALT</span><strong>{b.title}</strong><em>{b.author}</em></div>}
              {b.free && <span class="flag">Free guide</span>}
            </div>
            <div class="info">
              <h2>{b.title}</h2>
              <p class="by">by {b.author}</p>
              <p class="ov">{b.overview}</p>
              <div class="btns">
                {b.readable
                  ? <a class="btn btn-berry" href={`/read/${b.slug}/`}>📖 Read Free Online</a>
                  : <span class="soon" aria-disabled="true">📖 Read free online: coming soon</span>}
                {b.buy && <a class="btn btn-primary" href={b.buy.url} target="_blank" rel="noopener">🛒 Buy This Book <small>({b.buy.where})</small> ↗</a>}
                {!b.buy && b.free && <a class="btn btn-outline" href="/books/living-legacy-planner/">Write it all down: The Living Legacy Planner</a>}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="note">🔒 To read online, we ask for your first name and email. Reading is free. <a href="/privacy-policy/#signups">How we use your details</a></p>
    </div>
  </section>

  <CtaBand title="Want to talk about what you’ve read?" text={`Courtney’s first call is free. Call ${SITE.phoneDisplay} or book a time that suits you.`} />
</Base>

<style>
  .lib { list-style: none; padding: 0; margin: 0; display: grid; gap: 28px; }
  @media (min-width: 900px) { .lib { grid-template-columns: 1fr 1fr; } }
  .book { display: grid; grid-template-columns: 130px 1fr; gap: 20px; background: #fff; border: 2px solid var(--line); border-radius: 22px; padding: 20px; transition: border-color .15s, box-shadow .15s; }
  .book:hover { border-color: var(--yellow); box-shadow: 0 14px 30px rgba(34,58,102,.1); }
  @media (min-width: 560px) { .book { grid-template-columns: 170px 1fr; } }
  .cover { position: relative; }
  .cover img { width: 100%; border-radius: 6px; box-shadow: 0 10px 22px rgba(20,33,61,.22); }
  .tcover { aspect-ratio: 300/430; border-radius: 6px; background: var(--blue); border: 4px solid var(--yellow); color: #fff; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10px; padding: 12px; text-align: center; box-shadow: 0 10px 22px rgba(20,33,61,.22); }
  .tcover strong { font: 700 1rem/1.25 var(--font-head); color: #fff; }
  .tcover em { font: 600 1.15rem var(--font-hand); color: var(--sun); font-style: normal; }
  .tlogo { font: 700 .8rem var(--font-head); letter-spacing: .2em; color: var(--sun); border: 2px solid var(--sun); border-radius: 999px; padding: 2px 10px; }
  .flag { position: absolute; top: -10px; left: -8px; background: var(--yellow); color: var(--blue-ink); font: 700 .85rem var(--font-head); padding: 4px 12px; border-radius: 999px; }
  .info h2 { font-size: 1.35rem; margin-bottom: .2em; }
  .by { color: var(--ink-soft); margin: 0 0 .6em; font-style: italic; }
  .ov { font-size: 1.05rem; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .btns .btn { min-height: 52px; padding: 10px 18px; font-size: 1rem; }
  .btns small { font-weight: 400; opacity: .85; }
  .soon { display: inline-flex; align-items: center; min-height: 52px; padding: 10px 18px; border-radius: 999px; border: 2px dashed var(--line); color: var(--ink-soft); font: 600 1rem var(--font-head); }
  .note { margin-top: 2rem; color: var(--ink-soft); }
  @media (max-width: 559px) { .book { grid-template-columns: 1fr; } .cover { max-width: 180px; } }
</style>
