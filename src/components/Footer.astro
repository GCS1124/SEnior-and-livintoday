---
import { SITE, SERVICES } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap grid cols">
    <div>
      <img src="/images/logo.png" width="96" height="96" alt="Senior and Living Today S.A.L.T. logo" class="logo" loading="lazy" />
      <p class="sign">Take care of yourselves, Saltines.<br />— Courtney</p>
      <address>
        {SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}<br />
        <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </address>
      <p class="social">
        <a href={SITE.links.youtube} rel="noopener">YouTube</a> ·
        <a href={SITE.links.threads} rel="noopener">Threads</a>
      </p>
    </div>
    <nav aria-label="Get help">
      <p class="h">Get help</p>
      <ul>
        <li><a href="/help/">What do I do when…?</a></li>
        <li><a href="/find-help/">Find help near me</a></li>
        <li><a href="/faq/">Questions &amp; answers</a></li>
        <li><a href="/videos/">Courtney’s videos</a></li>
        <li><a href="/resources/final-arrangements-discussion-guide/">10-point discussion guide</a></li>
        <li><a href="/memory-lane/">Memory Lane</a></li>
        <li><a href="/games/">Coloring &amp; games</a></li>
        <li><a href="/greeting-cards/">Greeting card maker</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </nav>
    <nav aria-label="Work with us">
      <p class="h">Work with us</p>
      <ul>
        {SERVICES.map((s) => <li><a href={s.href}>{s.short}</a></li>)}
        <li><a href="/community/">Free community</a></li>
        <li><a href="/contact/">Book a free call</a></li>
      </ul>
    </nav>
    <nav aria-label="Planners and shop">
      <p class="h">Planners &amp; shop</p>
      <ul>
        <li><a href="/planners/">All planners</a></li>
        <li><a href="/books/living-legacy-planner/">The Living Legacy Planner</a></li>
        <li><a href="/gifts/">Holiday gifts</a></li>
        <li><a href="/planners/#e-planners">E-planners</a></li>
        <li><a href={SITE.links.store} rel="noopener">SALT Online Store</a></li>
        <li><a href="/about/">About Courtney</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p><strong>Please note:</strong> S.A.L.T. offers guidance, organization and support. We are not doctors, nurses, lawyers or financial advisors, and nothing here is medical, legal or financial advice. For those decisions, please talk with a licensed professional.</p>
    <p><a href="/sitemap/">Site map</a> · <a href="/privacy-policy/">Privacy</a> · <a href="/terms-conditions/">Terms</a> · <a href="/disclaimer/">Disclaimer</a></p>
  </div>
</footer>

<style>
  .site-footer { background: var(--green-ink); color: var(--on-dark); padding: 70px 0 28px; font-size: 1.02rem; border-top: 6px solid var(--gold); }
  .site-footer a { color: #fff; }
  .site-footer a:hover { color: var(--sun); }
  .cols { gap: 36px; }
  @media (min-width: 760px) { .cols { grid-template-columns: 1.4fr 1fr 1fr 1fr; } }
  .logo { width: 96px; height: 96px; border-radius: 50%; margin-bottom: 14px; }
  .sign { font: 600 1.7rem/1.15 var(--font-hand); color: var(--sun); }
  .h { font: 600 .9rem var(--font-head); color: var(--gold); letter-spacing: .1em; text-transform: uppercase; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .6em; }
  address { font-style: normal; line-height: 1.8; }
  .legal { border-top: 1px solid #34507e; margin-top: 44px; padding-top: 22px; font-size: .95rem; color: var(--on-dark-soft); }
  .legal strong { color: #fff; }
</style>
