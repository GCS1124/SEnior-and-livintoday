---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Caregiver Connection', href: '/caregiver-connection/' }];
const items = [
  { img: '/images/adult-bibs.png', alt: 'Adult mealtime bibs for men and women', title: 'Adult mealtime bibs', text: 'Stylish, stain-resistant and easy-to-clean bibs for men and women that keep mealtimes dignified and enjoyable.' },
  { img: '/images/magnifier.png', alt: 'Handheld 10X magnifying glass for seniors', title: 'Handheld magnifying glasses', text: 'Portable 10X magnifiers for reading labels, mail and maps, and for hobbies that need close detail.' },
  { img: '/images/books-for-seniors.png', alt: 'Selection of books for seniors', title: 'Books for seniors', text: 'Carefully chosen books, from inspiring memoirs to engaging fiction, to keep minds active and entertained.' },
];
---
<Base
  title="Caregiver Connection: Daily Living Aids for Seniors"
  description="Caregiver-recommended products that support senior comfort, safety and independence: adult mealtime bibs, handheld magnifiers, books for seniors and more."
  breadcrumbs={crumbs}
>
  <PageHero
    title="Caregiver Connection: products for comfort, safety and independence"
    eyebrow="Curated with care"
    lead="Thoughtfully selected products that make daily living easier, safer and more dignified for seniors and their caregivers."
    breadcrumbs={crumbs}
  />
  <section class="section">
    <div class="wrap narrow">
      <h2>Why trust our recommendations?</h2>
      <ul class="checklist">
        <li><strong>Expert curation.</strong> Every item is chosen specifically for seniors and how it improves daily life.</li>
        <li><strong>Personal fit.</strong> Every senior's needs are different, from mealtime to hobbies to everyday tasks.</li>
        <li><strong>Quality first.</strong> We favor durable, effective products so caregivers can buy with confidence.</li>
      </ul>
    </div>
  </section>
  <section class="section section-alt">
    <div class="wrap grid grid-3">
      {items.map((i) => (
        <div class="card">
          <Photo src={i.img} alt={i.alt} />
          <h3 style="margin-top:1rem">{i.title}</h3>
          <p>{i.text}</p>
        </div>
      ))}
    </div>
    <div class="wrap btn-row">
      <a class="btn btn-primary" href={SITE.links.store} rel="noopener">Shop the SALT Online Store</a>
      <a class="btn btn-secondary" href="/contact/">Ask us for a recommendation</a>
    </div>
  </section>
</Base>
