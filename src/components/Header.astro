---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) || (href === '/games/' && path.startsWith('/greeting-cards/')) ? 'page' : undefined);
---
<div class="topbar">
  <div class="wrap tb">
    <span>Help for seniors &amp; the people who care for them. Not medical, not legal, just real help.</span>
    <a href={`tel:${SITE.phone}`}>Call Courtney’s team: <strong>{SITE.phoneDisplay}</strong></a>
  </div>
</div>
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Senior and Living Today home">
      <img src="/images/logo.png" width="64" height="64" alt="" />
      <span>
        <strong>Senior and Living Today</strong>
        <small>the caregiver’s caregiver</small>
      </span>
    </a>
    <div class="acts">
      <button type="button" class="btn btn-outline ask-btn" data-ask>💬 Ask S.A.L.T.</button>
      <a class="btn btn-primary" href="/contact/">Book a free call</a>
    </div>
    <details class="mobile">
      <summary><span aria-hidden="true">☰</span> Menu</summary>
      <nav aria-label="Main (mobile)">
        <ul>
          {NAV.map((item) => <li><a href={item.href} aria-current={current(item.href)}><span aria-hidden="true">{item.icon}</span> {item.label}</a></li>)}
          <li><a href="/services/"><span aria-hidden="true">🤝</span> Work With Us</a></li>
          <li><a href="/contact/"><span aria-hidden="true">📞</span> Contact</a></li>
        </ul>
        <a class="btn btn-primary book" href="/contact/">Book a free call</a>
      </nav>
    </details>
  </div>
  <nav class="desk" aria-label="Main">
    <ul class="wrap">
      {NAV.map((item) => <li><a href={item.href} aria-current={current(item.href)}><span aria-hidden="true">{item.icon}</span>{item.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .topbar { background: var(--green-ink); color: #dfe9dc; font-size: .95rem; }
  .tb { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 8px; padding-bottom: 8px; }
  .tb a { color: var(--sun); text-decoration: none; }
  .tb a strong { color: var(--sun); }
  @media (max-width: 760px) { .tb span { display: none; } .tb { justify-content: center; } }

  .site-header { background: #fff; position: sticky; top: 0; z-index: 30; box-shadow: 0 4px 18px rgba(90,31,60,.06); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 84px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand img { width: 60px; height: 60px; border-radius: 50%; }
  .brand strong { display: block; font: 700 1.2rem/1.1 var(--font-head); color: var(--green-ink); }
  .brand small { display: block; font: 600 1.35rem/1 var(--font-hand); color: var(--berry); }
  ul { list-style: none; margin: 0; padding: 0; }
  .acts { display: none; gap: 12px; }
  .acts .btn { min-height: 48px; padding: 10px 20px; font-size: 1rem; }

  .desk { display: none; border-top: 1px solid var(--line); border-bottom: 3px solid var(--gold); background: var(--paper); }
  .desk ul { display: flex; justify-content: space-between; gap: 4px; max-width: var(--max); margin: 0 auto; padding: 0 20px; }
  .desk a { display: flex; align-items: center; gap: 7px; padding: 12px 6px; font: 600 1rem var(--font-head); color: var(--ink); text-decoration: none; white-space: nowrap; border-bottom: 3px solid transparent; margin-bottom: -3px; }
  .desk a:hover { color: var(--berry); border-bottom-color: var(--berry); }
  .desk a[aria-current='page'] { color: var(--berry); border-bottom-color: var(--berry); }

  .mobile summary { list-style: none; cursor: pointer; font-weight: 700; padding: 10px 18px; min-height: 50px; border: 2px solid var(--green); border-radius: 999px; display: flex; align-items: center; gap: 8px; color: var(--green-ink); }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile nav { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 3px solid var(--gold); padding: 8px 20px 22px; display: grid; gap: 10px; max-height: 80vh; overflow-y: auto; }
  .mobile li a { display: block; padding: 13px 4px; font: 600 1.15rem var(--font-head); text-decoration: none; color: var(--ink); border-bottom: 1px solid var(--line); }
  .mobile a[aria-current='page'] { color: var(--berry); }
  .mobile .book { width: 100%; }

  @media (min-width: 1100px) {
    .mobile { display: none; }
    .acts { display: flex; }
    .desk { display: block; }
  }
</style>
