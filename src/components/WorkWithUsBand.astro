---
// A slim "Work with us" call-to-action for the main site (homepage and book pages), in the site's own
// blue-and-yellow style. Links to the Work With Us hub and, where useful, straight to a partner page.
interface Props { variant?: 'home' | 'llp' | 'military' }
const { variant = 'home' } = Astro.props;
const copy = {
  home: { kicker: 'Work with us', title: 'Bookstore, organization, affiliate or independent contractor?', text: 'There are several ways to work with Senior and Living Today, from carrying The Living Legacy Planner in your store to recommending our products or offering your services.' },
  llp: { kicker: 'For bookstores & organizations', title: 'Bring The Living Legacy Planner to the people you serve', text: 'Bookstores, retailers, distributors, senior living organizations and institutional buyers can purchase the planner in quantity. Explore our partner pages, or see every way to work with us.' },
  military: { kicker: 'For military bookstores & organizations', title: 'Bring the Military Edition to more military families', text: 'Military bookstores, military family and veteran organizations and institutional buyers can purchase the Military Edition in quantity.' },
}[variant];
---
<section class="wwu-band" aria-label="Work with us">
  <div class="wrap wwu-band-in">
    <div>
      <span class="kicker">{copy.kicker}</span>
      <h2>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>
    <div class="wwu-band-btns">
      {variant === 'llp' && <a class="btn btn-primary" href="/partners/">First &amp; Second Edition partners</a>}
      {variant === 'llp' && <a class="btn btn-outline" href="/team-up-with-us/">Military Edition partners</a>}
      {variant === 'military' && <a class="btn btn-primary" href="/team-up-with-us/">Military Edition partnerships</a>}
      <a class={`btn ${variant === 'home' ? 'btn-primary' : 'btn-outline'}`} href="/work-with-us/">{variant === 'home' ? 'See ways to work with us' : 'All ways to work with us'}</a>
    </div>
  </div>
</section>

<style>
  .wwu-band { padding: clamp(28px, 4vw, 44px) 0; background: var(--blue-pale); border-top: 3px solid var(--yellow); border-bottom: 3px solid var(--yellow); }
  .wwu-band-in { display: grid; grid-template-columns: 1.4fr auto; gap: 18px 36px; align-items: center; }
  .wwu-band h2 { margin: .2rem 0 .4rem; font-size: clamp(1.3rem, 2.4vw, 1.75rem); color: var(--blue-ink); }
  .wwu-band p { margin: 0; line-height: 1.6; max-width: 62ch; }
  .wwu-band-btns { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
  @media (max-width: 820px) { .wwu-band-in { grid-template-columns: 1fr; } .wwu-band-btns { justify-content: flex-start; } }
  @media (max-width: 480px) { .wwu-band-btns .btn { width: 100%; justify-content: center; text-align: center; } }
</style>
