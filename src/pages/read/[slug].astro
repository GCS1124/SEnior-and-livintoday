---
// Online reader for one book. The page itself holds no book text: pages are fetched from
// /api/read only after the visitor signs up (name + email) and receives a reading pass.
import Base from '../../layouts/Base.astro';
import PlayerSignup from '../../components/PlayerSignup.astro';
import { LIBRARY } from '../../data/library';

export function getStaticPaths() {
  return LIBRARY.filter((b) => b.readable).map((b) => ({ params: { slug: b.slug }, props: { book: b } }));
}
const { book } = Astro.props;
const crumbs = [{ name: 'Books & Reading', href: '/books/' }, { name: book.title, href: `/read/${book.slug}/` }];
---
<Base title={`Read Free: ${book.title.split(":")[0]}`} description={`Read ${book.title} by ${book.author} free online, with large text you can adjust.`.slice(0, 158)} breadcrumbs={crumbs} noindex>
  <section class="rhead">
    <div class="wrap">
      <a class="back" href="/books/">← All books</a>
      <h1>{book.title}</h1>
      <p class="by">by {book.author}</p>
    </div>
  </section>

  <div id="gate">
    <PlayerSignup
      source="books"
      book={book.slug}
      title="Read free online"
      intro="Tell us your first name and email to open the book. Reading is free."
      emailNote="Please enter your correct email. We only send you news if you tick the box below."
      buttonLabel="Start reading"
    />
  </div>

  <section class="reader-wrap" id="reader-wrap" hidden>
    <div class="wrap">
      <div class="reader" id="reader" data-theme="light" data-book={book.slug}>
        <div class="bar" role="toolbar" aria-label="Reading settings">
          <button type="button" class="tool" id="toc-btn" aria-expanded="false" aria-controls="toc">☰ Contents</button>
          <div class="grp" role="group" aria-label="Text size">
            <button type="button" class="tool" id="smaller" aria-label="Smaller text">A−</button>
            <button type="button" class="tool big" id="bigger" aria-label="Bigger text">A+</button>
          </div>
          <button type="button" class="tool" id="spacing" aria-pressed="false">↕ Roomier lines</button>
          <div class="grp" role="group" aria-label="Page color">
            <button type="button" class="tool sw-l" data-theme="light" aria-pressed="true">Light</button>
            <button type="button" class="tool sw-c" data-theme="cream" aria-pressed="false">Cream</button>
            <button type="button" class="tool sw-d" data-theme="dark" aria-pressed="false">Dark</button>
          </div>
        </div>
        <nav class="toc" id="toc" hidden aria-label="Contents"><ol></ol></nav>
        <div class="progress" aria-hidden="true"><span id="pbar"></span></div>
        <p class="pos" id="pos" aria-live="polite"></p>
        <article class="page" id="page" tabindex="-1"></article>
        <div class="turn">
          <button type="button" class="btn btn-outline" id="prev">← Previous page</button>
          <button type="button" class="btn btn-berry" id="next">Next page →</button>
        </div>
        <div class="end" id="end" hidden>
          <p>🎉 You’ve reached the end. Thank you for reading!</p>
          {book.buy
            ? <a class="btn btn-primary" href={book.buy.url} target="_blank" rel="noopener">🛒 Buy This Book ({book.buy.where}) ↗</a>
            : <a class="btn btn-primary" href="/books/living-legacy-planner/">Write it all down: The Living Legacy Planner</a>}
          <a class="btn btn-outline" href="/books/">More books</a>
        </div>
      </div>
      <p class="hint">Tip: use the ← → arrow keys or swipe to turn pages. We’ll remember your page on this device.</p>
    </div>
  </section>

  <section class="wrap unavailable" id="unavailable" hidden>
    <p class="notice">📖 Online reading is being set up right now, so this book can’t open yet. Please check back soon, or call Courtney’s team at <a href="tel:+18884164264">(888) 416-4264</a>.</p>
  </section>
</Base>

<style>
  .rhead { padding: 28px 0 0; }
  .back { font: 600 1.05rem var(--font-head); color: var(--blue); }
  .rhead h1 { font-size: clamp(1.7rem, 4vw, 2.5rem); margin: .4em 0 .1em; }
  .by { color: var(--ink-soft); font-style: italic; }
  .reader-wrap { padding: 20px 0 60px; }
  .reader { --fs: 1.3rem; --lh: 1.75; max-width: 820px; margin: 0 auto; border-radius: 22px; border: 2px solid var(--line); background: var(--r-bg); color: var(--r-ink); box-shadow: 0 16px 40px rgba(34,58,102,.1); overflow: hidden; }
  .reader[data-theme='light'] { --r-bg: #ffffff; --r-ink: #1e2a3b; --r-soft: #46546a; --r-bar: #f3f7fc; }
  .reader[data-theme='cream'] { --r-bg: #fff8e6; --r-ink: #2b2a24; --r-soft: #5a5546; --r-bar: #fff1cc; }
  .reader[data-theme='dark'] { --r-bg: #14213d; --r-ink: #e6edf7; --r-soft: #c3d0e3; --r-bar: #182b4d; }
  .bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px; background: var(--r-bar); border-bottom: 2px solid var(--line); }
  .grp { display: inline-flex; gap: 6px; }
  .tool { min-height: 48px; min-width: 48px; padding: 8px 14px; border-radius: 12px; border: 2px solid var(--line); background: #fff; color: var(--blue-ink); font: 600 1rem var(--font-head); cursor: pointer; }
  .tool.big { font-size: 1.2rem; }
  .tool[aria-pressed='true'], .tool[aria-expanded='true'] { border-color: var(--blue); background: var(--blue-soft); box-shadow: 0 0 0 2px var(--blue); }
  .sw-c { background: #fff8e6; } .sw-d { background: #14213d; color: #fff; }
  .sw-c[aria-pressed='true'] { background: #fff8e6; }
  .sw-d[aria-pressed='true'] { background: #14213d; color: #fff; box-shadow: 0 0 0 3px var(--yellow); }
  .sw-l[aria-pressed='true'] { background: #fff; }
  .toc { padding: 10px 18px; border-bottom: 2px solid var(--line); background: var(--r-bg); }
  .toc ol { margin: 0; padding-left: 1.4em; }
  .toc button { background: none; border: 0; padding: 10px 4px; min-height: 44px; text-align: left; font: 1.1rem var(--font-body); color: var(--r-ink); text-decoration: underline; cursor: pointer; }
  .toc button[aria-current='true'] { font-weight: 700; color: var(--r-ink); text-decoration: none; }
  .progress { height: 8px; background: var(--line); }
  .progress span { display: block; height: 100%; width: 0; background: var(--yellow); transition: width .3s; }
  .pos { margin: 10px 22px 0; font: 600 1rem var(--font-head); color: var(--r-soft); }
  .page { padding: 12px clamp(20px, 5vw, 56px) 20px; min-height: 40vh; font-size: var(--fs); line-height: var(--lh); outline: none; }
  .page :global(h2) { color: var(--r-ink); font-size: 1.5em; margin: .4em 0 .6em; }
  .page :global(h3) { color: var(--r-ink); font-size: 1.2em; }
  .page :global(p), .page :global(li) { margin: 0 0 .9em; }
  .page :global(strong) { color: var(--r-ink); }
  .page :global(a) { color: inherit; }
  .page :global(blockquote) { margin: 1em 0; padding: .6em 1em; border-left: 5px solid var(--yellow); background: rgba(255,180,0,.12); }
  .turn { display: flex; justify-content: space-between; gap: 12px; padding: 14px clamp(16px, 4vw, 40px) 22px; flex-wrap: wrap; }
  .turn .btn { flex: 1 1 200px; min-height: 58px; font-size: 1.1rem; }
  .turn .btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }
  .reader[data-theme='dark'] .turn .btn-outline { color: #fff; border-color: var(--on-dark-soft); }
  .reader[data-theme='dark'] .turn .btn-outline:hover { background: var(--blue); }
  .reader[data-theme='dark'] .turn .btn-berry { background: var(--yellow); color: var(--blue-ink); box-shadow: 0 3px 0 var(--yellow-shadow); }
  .end { margin: 0 clamp(16px, 4vw, 40px) 24px; padding: 18px; border-radius: 16px; background: var(--yellow-soft); color: var(--blue-ink); display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .end p { margin: 0; flex: 1 1 100%; font: 600 1.2rem var(--font-head); }
  .end[hidden] { display: none; }
  .hint { text-align: center; color: var(--ink-soft); margin-top: 1rem; }
  .unavailable { padding-bottom: 60px; }
  /* On small screens the floating helper button would cover the book text; it stays in the menu. */
  @media (max-width: 700px) { :global(.ask-launch) { display: none; } }
  @media (prefers-reduced-motion: no-preference) { .page.turning { animation: page-in .35s ease; } @keyframes page-in { from { opacity: 0; transform: translateX(var(--dir, 12px)); } to { opacity: 1; transform: none; } } }
</style>

<script>
  type Book = { title: string; chapters: { title: string; page: number }[]; pages: string[] };
  const reader = document.getElementById('reader') as HTMLElement;
  const slug = reader.dataset.book!;
  const $ = (id: string) => document.getElementById(id)!;
  const store = {
    get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
    set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
    del: (k: string) => { try { localStorage.removeItem(k); } catch { /* private mode */ } },
  };
  const PASS = `salt-read-pass-${slug}`, POS = `salt-read-pos-${slug}`, PREFS = 'salt-reader-prefs';
  let book: Book | null = null, at = 0;

  // ----- Settings (remembered on this device) -----
  const prefs = (() => { try { return JSON.parse(store.get(PREFS) || '{}'); } catch { return {}; } })() as { size?: number; roomy?: boolean; theme?: string };
  const SIZES = [1.1, 1.2, 1.3, 1.45, 1.6, 1.8, 2.0];
  let size = SIZES.includes(prefs.size ?? 0) ? prefs.size! : 1.3;
  const applyPrefs = () => {
    reader.style.setProperty('--fs', `${size}rem`);
    reader.style.setProperty('--lh', prefs.roomy ? '2.1' : '1.75');
    reader.dataset.theme = prefs.theme || 'light';
    $('spacing').setAttribute('aria-pressed', String(!!prefs.roomy));
    document.querySelectorAll<HTMLButtonElement>('[data-theme].tool').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.theme === reader.dataset.theme)));
    ($('smaller') as HTMLButtonElement).disabled = size === SIZES[0];
    ($('bigger') as HTMLButtonElement).disabled = size === SIZES[SIZES.length - 1];
    store.set(PREFS, JSON.stringify({ ...prefs, size }));
  };
  $('smaller').addEventListener('click', () => { size = SIZES[Math.max(0, SIZES.indexOf(size) - 1)]; applyPrefs(); });
  $('bigger').addEventListener('click', () => { size = SIZES[Math.min(SIZES.length - 1, SIZES.indexOf(size) + 1)]; applyPrefs(); });
  $('spacing').addEventListener('click', () => { prefs.roomy = !prefs.roomy; applyPrefs(); });
  document.querySelectorAll<HTMLButtonElement>('[data-theme].tool').forEach((b) => b.addEventListener('click', () => { prefs.theme = b.dataset.theme; applyPrefs(); }));
  applyPrefs();

  // ----- Pages -----
  function show(i: number, dir = 0) {
    if (!book) return;
    at = Math.max(0, Math.min(book.pages.length - 1, i));
    const page = $('page');
    page.innerHTML = book.pages[at];
    page.classList.remove('turning'); void page.offsetWidth;
    page.style.setProperty('--dir', `${dir * 14}px`); page.classList.add('turning');
    const total = book.pages.length;
    $('pos').textContent = `Page ${at + 1} of ${total}`;
    ($('pbar') as HTMLElement).style.width = `${((at + 1) / total) * 100}%`;
    ($('prev') as HTMLButtonElement).disabled = at === 0;
    ($('next') as HTMLButtonElement).disabled = at === total - 1;
    $('end').hidden = at !== total - 1;
    const ch = [...book.chapters].reverse().find((c) => c.page <= at);
    document.querySelectorAll<HTMLButtonElement>('#toc button').forEach((b) => b.setAttribute('aria-current', String(Number(b.dataset.page) === ch?.page)));
    store.set(POS, String(at));
  }
  const turn = (d: number) => { if (book) { show(at + d, d); $('page').focus({ preventScroll: true }); reader.scrollIntoView({ block: 'start', behavior: 'smooth' }); } };
  $('prev').addEventListener('click', () => turn(-1));
  $('next').addEventListener('click', () => turn(1));
  document.addEventListener('keydown', (e) => {
    if (!book || (e.target as HTMLElement).closest('input, textarea, select, dialog')) return;
    if (e.key === 'ArrowRight') turn(1); else if (e.key === 'ArrowLeft') turn(-1);
  });
  let sx = 0, sy = 0;
  $('page').addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  $('page').addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.5) turn(dx < 0 ? 1 : -1);
  });
  $('toc-btn').addEventListener('click', () => {
    const t = $('toc'); t.hidden = !t.hidden; $('toc-btn').setAttribute('aria-expanded', String(!t.hidden));
  });

  // ----- Open the book with a reading pass -----
  async function open(pass: string) {
    try {
      const r = await fetch(`/api/read?book=${encodeURIComponent(slug)}`, { headers: { 'X-Reading-Pass': pass } });
      if (r.status === 401) { store.del(PASS); return false; }
      if (!r.ok) throw new Error(String(r.status));
      book = await r.json();
    } catch { return false; }
    store.set(PASS, pass);
    $('toc').querySelector('ol')!.innerHTML = book!.chapters.map((c) => `<li><button type="button" data-page="${c.page}">${c.title.replace(/[<>&]/g, '')}</button></li>`).join('');
    $('toc').querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.page)); $('toc').hidden = true; $('toc-btn').setAttribute('aria-expanded', 'false'); $('page').focus(); }));
    $('gate').hidden = true; $('unavailable').hidden = true; $('reader-wrap').hidden = false;
    const saved = Number(store.get(POS) || 0);
    show(Number.isFinite(saved) ? saved : 0);
    if (saved > 0) $('pos').textContent += ' · Welcome back! We opened the page where you stopped.';
    return true;
  }

  document.addEventListener('salt:player', async (e) => {
    const d = (e as CustomEvent).detail as { readPass?: string };
    const okay = d.readPass ? await open(d.readPass) : false;
    if (!okay) { $('unavailable').hidden = false; }
  });

  // Returning reader on this device: open straight away.
  const savedPass = store.get(PASS);
  if (savedPass) open(savedPass);
</script>
