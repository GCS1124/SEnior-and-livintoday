---
// Homepage. Premium presentation of everything Senior and Living Today brings together:
// the Living Legacy Planner (flagship, three editions, with the page-turning reader from the
// landing pages), senior living resources, S.A.L.T. Academy courses, the shop, partnerships
// and Courtney's story. Styles: src/styles/home.css (scoped under .home).
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Video from '../components/Video.astro';
import Reviews from '../components/Reviews.astro';
import ProductGrid from '../components/ProductGrid.astro';
import SearchSource from '../components/SearchSource.astro';
import CtaBand from '../components/CtaBand.astro';
import WorkWithUsBand from '../components/WorkWithUsBand.astro';
import BibSpotlight from '../components/BibSpotlight.astro';
import Book3D from '../components/Book3D.astro';
import LookInside from '../components/LookInside.astro';
import { SITE, SERVICES, BOOKS, VIDEOS, GIFTS, RELICS, REVIEWS, storeLink } from '../data/site';
import { EDITIONS } from '../data/planners';
import { faqSchema } from '../data/schema';
import { getCollection } from 'astro:content';

const situations = (await getCollection('blog', ({ data }) => !data.draft && !!data.video)).slice(0, 6);

// The three Living Legacy Planner editions, each with its own page on this site.
const PAGE: Record<string, string> = { first: '/books/living-legacy-planner/', second: '/books/living-legacy-planner/#color-edition', military: '/books/military-edition/' };
const SHORT: Record<string, string> = { first: 'First Edition', second: 'Second Edition', military: 'Military Edition' };
const CHIP: Record<string, string> = { first: 'The original · Hardcover', second: 'Full color · Paperback & hardcover', military: 'Newest · Military families' };
const SMALL = (cover: string) => `${cover.replace('.webp', '-480.webp')} 480w, ${cover} 900w`;
const eds = EDITIONS.map((e) => ({ ...e, page: PAGE[e.key], short: SHORT[e.key], chip: CHIP[e.key], buy0: e.buy[0], srcset: SMALL(e.cover) }));
const [first, second, military] = eds;
const quote = REVIEWS.find((r) => r.verified) ?? REVIEWS[0];
const moreBooks = BOOKS.filter((b) => !['living-legacy-planner', 'living-legacy-planner-color', 'military-edition'].includes(b.slug));

const pillars = [
  { href: '#planner', icon: '📘', title: 'Books & legacy planning', text: 'The Living Legacy Planner, in three editions.' },
  { href: '#resources', icon: '🧭', title: 'Senior living resources', text: 'Real answers, local help and free guides.' },
  { href: '#learning', icon: '🎓', title: 'Courses & learning', text: 'S.A.L.T. Academy courses and Courtney’s videos.' },
  { href: '#shop', icon: '🛍️', title: 'Helpful products', text: 'Gifts and everyday helpers from our store.' },
];

const tiles = [
  { href: '/help/', icon: '💬', title: 'What do I do when…?', text: 'Courtney’s advice for hospital stays, Medicare letters and more.' },
  { href: '/find-help/', icon: '📍', title: 'Find help near me', text: 'Doctors, lawyers, Medicare help and local services by ZIP code.' },
  { href: '/guides/types-of-senior-living/', icon: '🏡', title: 'Senior living options', text: 'Aging in place, communities and care, explained simply.' },
  { href: '/resources/', icon: '🗂️', title: 'Free printables', text: 'Downloads and checklists for seniors and caregivers.' },
  { href: '/blog/', icon: '📰', title: 'Blog & articles', text: 'Practical articles for seniors and caregivers.' },
  { href: '/memory-lane/', icon: '📻', title: 'Memory Lane', text: 'Old newspapers, classic TV and radio, and “remember when?”' },
  { href: '/games/', icon: '🎨', title: 'Coloring & games', text: '16 pictures to color, plus a memory game.' },
  { href: '/greeting-cards/', icon: '💌', title: 'Make a greeting card', text: 'Add a photo and your wishes. Print, PDF or share.' },
];

const courses = [
  { title: 'Medicare Simplified', text: 'Medicare, made easier to understand.' },
  { title: 'Health & Nutritional Planning', text: 'Planning ahead for health and nutrition.' },
  { title: 'Smart Financial & Estate Planning', text: 'Money matters and estate planning.' },
  { title: 'Webinars', text: 'Ask-the-Expert sessions and a peer conversation hour.' },
];

const faqs = [
  { q: 'What is Senior and Living Today?', a: 'A friendly, one-stop place for adults 55+ and the people who care for them, founded by Courtney Jones, the caregiver’s caregiver. You’ll find practical advice and videos, a finder for doctors, lawyers and Medicare help, planners, holiday gifts, games, and one-on-one help when you want it.' },
  { q: 'Is this medical or legal advice?', a: 'No. S.A.L.T. offers guidance, organization and support. For medical, legal or financial decisions, we help you find and prepare for the right professional.' },
  { q: 'Where do I buy the planners and gifts?', a: 'Courtney’s printed planners and books are on Amazon. Gifts, everyday helpers and fillable e-planners are at our own SALT Online Store.' },
  { q: 'Is the Ask S.A.L.T. helper a real person?', a: 'Ask S.A.L.T. is an AI helper that points you to the right information and pages. When you want a real person, call (888) 416-4264 or book a free call with Courtney.' },
];
---
<Base
  title="Senior and Living Today: Help, Planners & Fun for Seniors"
  description="One friendly place for seniors and caregivers: find a doctor or Medicare help nearby, Courtney Jones’s advice and videos, planners, gifts, games and memories."
  image="/images/courtney-home.webp"
  imageAlt="Courtney Jones of Senior and Living Today at home"
  schema={[faqSchema(faqs)]}
>
  <div class="home">
    <!-- 1. Hero -->
    <section class="h-hero" aria-labelledby="h-title">
      <div class="wrap h-hero-in">
        <div class="h-hero-copy">
          <p class="h-eyebrow">Books · Legacy planning · Senior living education</p>
          <h1 id="h-title">Helping Families Plan, Preserve, and <em>Live Their Legacy.</em></h1>
          <p class="h-lead">Explore thoughtful planners, practical resources, and educational experiences designed to help individuals and families organize important details, preserve meaningful memories, and make informed decisions about senior living.</p>
          <div class="h-ctas">
            <a class="btn btn-primary" href="#planner">Explore the Living Legacy Planner</a>
            <a class="btn btn-light" href="#look-inside">📖 Read inside the planner</a>
          </div>
          <ul class="h-trust">
            <li>By Courtney R. Jones</li>
            <li>30+ years around senior care</li>
            <li>Three editions</li>
          </ul>
        </div>
        <div class="h-stage">
          <a class="hb hb-1" href={first.page}><Book3D src={first.cover} alt={first.coverAlt} srcset={first.srcset} sizes="(max-width: 1000px) 32vw, 190px" width={900} height={1285} /></a>
          <a class="hb hb-3" href={military.page}><Book3D src={military.cover} alt={military.coverAlt} srcset={military.srcset} sizes="(max-width: 1000px) 32vw, 190px" width={900} height={1261} /></a>
          <a class="hb hb-2" href={second.page}><Book3D src={second.cover} alt={second.coverAlt} srcset={second.srcset} sizes="(max-width: 1000px) 42vw, 250px" width={900} height={1218} /></a>
          <span class="h-badge"><img src="/images/logo-registered-small.png" alt="" width="34" height="34" /> The Living Legacy Planner</span>
        </div>
      </div>
    </section>

    <section class="h-pillars-wrap" aria-label="What we offer">
      <div class="wrap">
        <ul class="h-pillars">
          {pillars.map((p) => (
            <li><a href={p.href}><span class="ic" aria-hidden="true">{p.icon}</span><strong>{p.title}</strong><span>{p.text}</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 2. The Living Legacy Planner: flagship -->
    <section class="h-sec h-planner" id="planner" aria-labelledby="planner-title">
      <div class="wrap">
        <div class="h-plan-intro">
          <div>
            <p class="h-kicker">Our flagship book</p>
            <h2 class="h-display" id="planner-title">The Living Legacy Planner</h2>
            <p class="h-lead">An original planner by Courtney R. Jones, published by Senior and Living Today. Fill it in once, keep it updated, and the people you love will know exactly what to do, so nobody has to guess at a difficult time.</p>
            <ul class="h-inside">
              <li>Final wishes and arrangements</li>
              <li>Medical details and key contacts</li>
              <li>Finances and insurance</li>
              <li>Important documents and where they’re kept</li>
              <li>Memories and messages for loved ones</li>
              <li>A 10-point final arrangements discussion guide</li>
            </ul>
          </div>
          <blockquote class="h-quote">
            <p class="stars" aria-label="5 out of 5 stars">★★★★★</p>
            <p>{quote.title}</p>
            <footer>{quote.name} · Amazon review{quote.verified && ' · Verified Purchase'}</footer>
          </blockquote>
        </div>

        <h2 class="h-sub h-eds-title">Planners that do the remembering for you</h2>
        <ul class="h-eds">
          {eds.map((e) => (
            <li>
              <article class={`h-ed h-ed-${e.key}`} aria-labelledby={`ed-${e.key}`}>
                <a href={e.page} tabindex="-1" aria-hidden="true" class="h-ed-cover"><Book3D src={e.cover} alt={e.coverAlt} srcset={e.srcset} sizes="200px" width={900} height={1260} /></a>
                <p class="h-ed-chip">{e.chip}</p>
                <h3 id={`ed-${e.key}`}>{e.short}</h3>
                <p>{e.who}</p>
                <div class="h-ed-ctas">
                  <a class="btn btn-primary" href={e.page}>Explore the {e.short}</a>
                  <div class="h-ed-links">
                    <a href="#look-inside" data-look-edition={e.key}>📖 Read inside</a>
                    <a href={e.buy0.url} target="_blank" rel="noopener">{e.key === 'military' ? 'Buy from our store' : 'Buy on Amazon'} <span aria-hidden="true">↗</span></a>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>

        <div class="h-plan-more">
          <a class="btn btn-primary" href="/books/living-legacy-planner/">Explore the Living Legacy Planner</a>
          <a class="btn btn-outline" href="/planners/">Compare the planners</a>
          <a class="btn btn-outline" href="/gifts/#instant">Instant-download e-planners</a>
        </div>
      </div>
    </section>

    <!-- 3. Interactive book preview (the landing pages' reader: page turn + zoom) -->
    <LookInside editions={EDITIONS} initial="second" flip zoom belowFold title="Read inside the Living Legacy Planner" intro="Choose an edition, then turn the pages: the cover beside an open two-page spread, just like holding the book. Tap Zoom on any page to read it up close." />

    <section class="h-sec" style="padding-top:0" aria-label="More books and reviews">
      <div class="wrap">
        <div class="h-more">
          <div>
            <h3>More books by Courtney</h3>
            <p>Journals and keepsakes for every season of life.</p>
            <p style="margin-top:.6rem"><a href="/books/"><strong>See all books &amp; read free previews →</strong></a></p>
          </div>
          <ul>
            {moreBooks.map((b) => (
              <li><a href={b.page ?? b.buy} {...(b.page ? {} : { target: '_blank', rel: 'noopener' })}><img src={b.image} alt="" width="300" height="430" loading="lazy" /><span>{b.title}</span></a></li>
            ))}
          </ul>
        </div>
        <div class="h-reviews"><Reviews limit={3} /></div>
      </div>
    </section>

    <!-- 4. Senior living resources -->
    <section class="h-sec h-res" id="resources" aria-labelledby="res-title">
      <div class="wrap">
        <div class="h-res-top">
          <div class="h-head">
            <p class="h-kicker">Senior living resources</p>
            <h2 class="h-display" id="res-title">Where would you like to go?</h2>
            <p class="h-lead">Practical help for the questions families face: Courtney’s advice, a local finder for doctors, lawyers and Medicare help, free guides, and a little fun along the way.</p>
          </div>
          <form class="askbox" data-ask-form role="search">
            <label for="hero-q">What can we help you with today?</label>
            <div class="row">
              <input id="hero-q" name="q" placeholder="e.g. find a doctor who takes Medicare" autocomplete="off" />
              <button class="btn btn-berry" type="submit">Ask</button>
            </div>
            <div class="try">
              <span>Try:</span>
              <button type="button" data-ask="Mom is going into the hospital. What should I do?">Mom’s going to the hospital</button>
              <button type="button" data-ask="Gift ideas for my dad">Gift ideas for Dad</button>
              <button type="button" data-ask="Something fun to do today">Something fun to do</button>
            </div>
            <SearchSource compact />
          </form>
        </div>
        <ul class="h-tiles">
          {tiles.map((t) => (
            <li><a href={t.href}><span class="ic" aria-hidden="true">{t.icon}</span><strong>{t.title}</strong><span>{t.text}</span></a></li>
          ))}
        </ul>
        <p class="h-kicker h-sub-kicker">Real situations, real answers</p>
        <h2 class="h-sub" style="margin-top:0">What do I do when…?</h2>
        <div class="sits">
          {situations.map((p) => (
            <a class="sit" href={`/blog/${p.id}/`}>
              <img src={`https://i.ytimg.com/vi/${p.data.video}/mqdefault.jpg`} width="320" height="180" alt="" loading="lazy" />
              <span>“{p.data.situation}”</span>
            </a>
          ))}
        </div>
        <div class="finder-strip">
          <p><strong>📍 Need a doctor, lawyer or Medicare help nearby?</strong></p>
          <form action="/find-help/" method="get">
            <label class="visually-hidden" for="zipq">ZIP code</label>
            <input id="zipq" name="zip" placeholder="Your ZIP code" inputmode="numeric" />
            <button class="btn btn-primary" type="submit">Find help near me</button>
          </form>
        </div>
      </div>
    </section>

    <!-- 5. Courses & learning -->
    <section class="h-sec h-learn section-dark" id="learning" aria-labelledby="learn-title">
      <div class="wrap">
        <div class="h-academy">
          <div class="h-head">
            <p class="h-kicker">Courses &amp; learning</p>
            <h2 class="h-display" id="learn-title">Learn with S.A.L.T. Academy</h2>
            <p class="h-lead">Our free online community includes courses and webinars for seniors and caregivers, alongside discussions with people who’ve been there.</p>
            <div class="btn-row">
              <a class="btn btn-primary" href="/community/">Explore S.A.L.T. Academy</a>
              <a class="btn btn-light" href={SITE.links.community} rel="noopener" target="_blank">Join the free community ↗</a>
            </div>
          </div>
          <ul class="h-courses">
            {courses.map((c, i) => <li><span class="n" aria-hidden="true">{i + 1}</span><div><strong>{c.title}</strong><span>{c.text}</span></div></li>)}
          </ul>
        </div>
        <p class="h-kicker h-sub-kicker">Watch &amp; learn with Courtney</p>
        <h2 class="h-sub" style="margin-top:0">Pull up a chair. I’ve made hundreds of these.</h2>
        <div class="grid grid-3">
          {VIDEOS.slice(0, 3).map((v) => <Video id={v.id} title={v.title} length={v.length} note={v.note} />)}
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href="/videos/">More of Courtney’s videos</a>
          <a class="btn btn-light" href={SITE.links.youtubeSubscribe} rel="noopener" target="_blank">Subscribe on YouTube</a>
        </div>
      </div>
    </section>

    <!-- 6. Shop -->
    <section class="h-sec h-shop" id="shop" aria-labelledby="shop-title">
      <div class="snow" aria-hidden="true"></div>
      <div class="wrap">
        <div class="h-head">
          <p class="h-kicker">The SALT Online Store · 🎄 The season of giving</p>
          <h2 class="h-display" id="shop-title">Holiday gift ideas for the seniors you love</h2>
          <p class="h-lead">Adult bibs with crumb catchers, heated neck wraps, reading glasses, a big calendar clock. Hand-picked from our own SALT Online Store.</p>
        </div>
        <ProductGrid items={GIFTS.slice(0, 8)} campaign="home-holiday" />
        <div class="btn-row">
          <a class="btn btn-primary" href="/gifts/">Visit the shop</a>
          <a class="btn btn-light" href={storeLink('/', 'home-holiday')} target="_blank" rel="noopener">Shop more at www.saltonlinestore.com ↗</a>
        </div>
      </div>
    </section>

    <BibSpotlight campaign="home-bibs" />

    <section class="h-sec section-cream">
      <div class="wrap grid split">
        <div>
          <p class="h-kicker">Remember when?</p>
          <h2 class="h-display">Take a walk down Memory Lane</h2>
          <p class="lead">Rotary phones, rabbit-ear TVs, the milkman. Flip a card, share the story, then read the newspaper from the day you were born.</p>
          <ul class="mini-relics">
            {RELICS.slice(0, 4).map((r) => <li><span aria-hidden="true">{r.emoji}</span>{r.name}</li>)}
          </ul>
          <div class="btn-row">
            <a class="btn btn-berry" href="/memory-lane/">Visit Memory Lane</a>
            <a class="btn btn-outline" href="/games/">🖍️ Color a picture</a>
            <a class="btn btn-outline" href="/greeting-cards/">💌 Make a card</a>
          </div>
        </div>
        <a class="relics-card" href="/books/relics-of-the-century/">
          <Photo src="/images/relics-of-the-century.webp" alt="Relics of the Century book by Courtney Ray Jones" width={525} height={750} tilt="l" tape caption="Relics of the Century, by Courtney" />
        </a>
      </div>
    </section>

    <!-- 7. Work with us -->
    <WorkWithUsBand />

    <!-- 8. Courtney's story -->
    <section class="h-sec">
      <div class="wrap grid split split-rev">
        <div>
          <p class="h-kicker">The author &amp; the brand</p>
          <h2 class="h-display h-story-name">Hi, I’m Courtney</h2>
          <p>For more than 30 years I’ve been around senior care: working in a hospital, years in medical billing, and sitting with families through the hard stuff. I’m not a doctor or a lawyer. I’m the person who helps you figure out what to do next, and who to call.</p>
          <div class="svc">
            {SERVICES.map((s) => <a href={s.href}><strong>{s.title}</strong><span>{s.summary}</span></a>)}
          </div>
          <div class="btn-row"><a class="btn btn-primary" href="/contact/">Start with a free call</a><a class="btn btn-outline" href="/about/">My story</a></div>
        </div>
        <Photo src="/images/courtney-with-friends.webp" alt="Courtney Jones smiling with an older woman and a friend" width={1100} height={841} tilt="l" tape caption="This is what it’s all about." />
      </div>
    </section>

    <section class="h-sec section-cream">
      <div class="wrap">
        <p class="h-kicker">The S.A.L.T. family</p>
        <h2 class="h-display">You’re not the only one going through this</h2>
        <div class="wall">
          <Photo src="/images/garden-friends.webp" alt="A group of friends taking a selfie outdoors" width={1200} height={900} tilt="l" />
          <Photo src="/images/friends-porch.webp" alt="Two friends smiling together on a porch" width={400} height={300} tilt="r" tape />
          <Photo src="/images/dinner-out.webp" alt="An older woman smiling at a restaurant table" width={750} height={1000} tilt="l" />
          <Photo src="/images/park-group.webp" alt="Friends standing together in a park" width={825} height={1100} tilt="r" />
        </div>
      </div>
    </section>

    <section class="h-sec">
      <div class="wrap narrow">
        <h2 class="h-display">Questions people ask me</h2>
        <div class="faq">
          {faqs.map((f) => <details><summary><h3>{f.q}</h3></summary><p>{f.a}</p></details>)}
        </div>
      </div>
    </section>

    <!-- 9. Final call to action -->
    <CtaBand />
  </div>
</Base>
