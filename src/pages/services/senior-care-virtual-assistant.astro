---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';
import { faqSchema, serviceSchema } from '../../data/schema';

const path = '/services/senior-care-virtual-assistant/';
const crumbs = [{ name: 'Work With Us', href: '/services/' }, { name: 'Senior Care Virtual Assistant', href: path }];
const description = 'A senior care virtual assistant for appointments, medication reminders, paperwork, online orders and friendly check-in calls, with updates for family.';
const faqs = [
  { q: 'What does a senior care virtual assistant do?', a: 'Helps from a distance with the day-to-day: scheduling appointments, reminders for medications and bills, organizing paperwork and email, ordering groceries online, and regular friendly check-in calls.' },
  { q: 'Is this the same as in-home care?', a: 'No. A virtual assistant works by phone, video and email. There’s no hands-on or medical care. Many families use it alongside family help or in-home care.' },
  { q: 'Is this a device, like Alexa or a robot companion?', a: 'No. It’s a real person on our team, working with you by phone, video and email. You get a friendly voice and someone who follows things through, not a gadget.' },
  { q: 'Can family members get updates?', a: 'Yes, if the senior wants that. We can send regular updates so everyone stays in the loop.' },
];
---
<Base
  title="Senior Care Virtual Assistant Services"
  {description}
  breadcrumbs={crumbs}
  schema={[serviceSchema({ name: 'Senior Care Virtual Assistant Services', serviceType: 'Virtual assistant services for seniors', description, path }), faqSchema(faqs)]}
>
  <PageHero
    title="A senior care virtual assistant: an extra pair of hands, from a distance"
    kicker="Stay independent, stay in touch"
    lead="For seniors who want to keep running their own lives, and for families who live too far away to pop over every day."
    breadcrumbs={crumbs}
  >
    <div class="btn-row"><a class="btn btn-primary" href={SITE.links.bookCall30} rel="noopener">Book a free call</a></div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <h2>What we can take off your plate</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <div class="card"><h3>Appointments &amp; reminders</h3><ul class="checklist"><li>Doctor appointments and follow-ups</li><li>Medication reminders</li><li>Setting up and keeping a calendar</li></ul></div>
        <div class="card"><h3>Paperwork</h3><ul class="checklist"><li>Email and documents</li><li>Non-medical insurance paperwork</li><li>Organizing records and contacts</li></ul></div>
        <div class="card"><h3>Everyday errands, online</h3><ul class="checklist"><li>Grocery orders and delivery tracking</li><li>Online shopping help</li><li>Utility and bill reminders</li><li>Home repair follow-ups</li></ul></div>
        <div class="card"><h3>A friendly voice</h3><ul class="checklist"><li>Regular phone or video check-ins</li><li>Real conversation, to ease loneliness</li><li>Updates to family, if you’d like</li></ul></div>
      </div>
    </div>
  </section>

  <section class="section section-cream">
    <div class="wrap grid split">
      <div>
        <h2>Why families like it</h2>
        <ul class="checklist">
          <li><strong>Seniors stay in charge</strong> of their own routine.</li>
          <li><strong>Families get peace of mind</strong> without hovering.</li>
          <li><strong>It costs less</strong> than full-time help in the home for tasks that can be done remotely.</li>
          <li><strong>Routine and conversation</strong> help with loneliness.</li>
        </ul>
        <p>Medicare letter came in the mail? A bill that doesn’t look right? That’s exactly the kind of thing we help with. Read my <a href="/blog/medicare-advantage-letter-deadline/">Medicare letter checklist</a>.</p>
      </div>
      <Photo src="/images/dinner-out.webp" alt="An older woman smiling at a restaurant table" width={750} height={1000} tilt="l" tape />
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand title="See if a virtual assistant is right for your family" />
</Base>
