---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Senior and Living Today home">
      <img src="/favicon.svg" width="44" height="44" alt="" />
      <span>
        <strong>Senior and Living Today</strong>
        <small>S.A.L.T.</small>
      </span>
    </a>

    <nav class="desk" aria-label="Main">
      <ul>
        {NAV.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
      </ul>
      <a class="btn btn-primary call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
    </nav>

    <details class="mobile">
      <summary><span aria-hidden="true">☰</span> Menu</summary>
      <nav aria-label="Main (mobile)">
        <ul>
          {NAV.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
        </ul>
        <a class="btn btn-primary call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 76px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--brand-dark); }
  .brand strong { display: block; font-family: var(--font-head); font-size: 1.25rem; line-height: 1.1; }
  .brand small { display: block; font-size: .85rem; letter-spacing: .14em; color: var(--accent); font-weight: 700; }
  ul { list-style: none; margin: 0; padding: 0; }

  .desk { display: none; }
  .mobile summary {
    list-style: none; cursor: pointer; font-weight: 700; padding: 10px 16px; min-height: 48px;
    border: 2px solid var(--line); border-radius: 999px; display: flex; align-items: center; gap: 8px;
  }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile nav {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--surface);
    border-bottom: 1px solid var(--line); padding: 12px 20px 24px;
  }
  .mobile ul { margin-bottom: 16px; }
  .mobile li a { display: block; padding: 12px 4px; font-size: 1.15rem; font-weight: 700; text-decoration: none; color: var(--ink); border-bottom: 1px solid var(--line); }
  .mobile .call { width: 100%; }
  a[aria-current='page'] { color: var(--accent) !important; }

  @media (min-width: 1140px) {
    .mobile { display: none; }
    .desk { display: flex; align-items: center; gap: 20px; }
    .desk ul { display: flex; gap: 20px; }
    .desk li a { font-weight: 700; text-decoration: none; color: var(--ink); white-space: nowrap; }
    .desk li a:hover { color: var(--accent-dark); }
    .desk .call { white-space: nowrap; min-height: 46px; padding: 10px 20px; font-size: 1rem; }
  }
</style>
