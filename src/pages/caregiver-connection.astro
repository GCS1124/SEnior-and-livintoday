---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Caregiver Connection', href: '/caregiver-connection/' }];
---
<Base
  title="Caregiver Connection: Everyday Aids for Seniors"
  description="Products Courtney Jones recommends for senior comfort and independence: adult mealtime bibs, 10X magnifiers, books for seniors and caregiver printables."
  breadcrumbs={crumbs}
>
  <PageHero
    title="Caregiver Connection: little things that make the day easier"
    kicker="Picked with care"
    lead="Simple, practical things that help seniors keep their comfort, dignity and independence. Available at the SALT Online Store."
    breadcrumbs={crumbs}
  >
    <div class="btn-row"><a class="btn btn-primary" href={SITE.links.store} rel="noopener">Shop Now at the SALT Online Store</a></div>
  </PageHero>
  <section class="section">
    <div class="wrap grid split">
      <div class="grid">
        <div class="card"><h2 class="t">Adult mealtime bibs</h2><p>Stylish, stain-resistant and easy to wash, for men and women. Mealtime stays pleasant and dignified.</p></div>
        <div class="card"><h2 class="t">Handheld magnifying glasses</h2><p>Portable 10X magnifiers for pill bottles, mail, recipes, maps and hobbies.</p></div>
        <div class="card"><h2 class="t">Books for seniors</h2><p>From memoirs to fiction, plus our own <a href="/books/relics-of-the-century/">Relics of the Century</a> for memory-lane conversations.</p></div>
        <div class="card"><h2 class="t">Caregiver printables</h2><p>Fillable care logs, medication trackers and appointment planners. <a href={SITE.links.storeDigital} rel="noopener">See them all</a>.</p></div>
      </div>
      <Photo src="/images/couple-outdoors.webp" alt="An older couple smiling together outdoors" width={675} height={900} tilt="r" tape />
    </div>
  </section>
</Base>
<style>.t { font-size: 1.3rem; }</style>
