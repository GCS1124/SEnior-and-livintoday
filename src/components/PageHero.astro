---
interface Crumb { name: string; href: string }
interface Props { title: string; kicker?: string; lead?: string; breadcrumbs?: Crumb[] }
const { title, kicker, lead, breadcrumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    {breadcrumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {breadcrumbs.map((c, i) => (
            <li>{i === breadcrumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    {kicker && <span class="kicker">{kicker}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<svg class="wave" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0h1440v18c-120 22-260 30-420 18S700 2 540 10 220 44 0 30z" fill="var(--green-soft)"/></svg>
<style>.wave { margin-top: -1px; }</style>
