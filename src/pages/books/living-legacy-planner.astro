---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Reviews from '../../components/Reviews.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../data/site';
import { bookSchema, faqSchema } from '../../data/schema';

const path = '/books/living-legacy-planner/';
const crumbs = [{ name: 'Planners', href: '/planners/' }, { name: 'The Living Legacy Planner', href: path }];
const description = 'The Living Legacy Planner by Courtney Jones: a large, hardback end-of-life and personal records planner for final wishes, finances, medical details and memories.';
const faqs = [
  { q: 'Is The Living Legacy Planner a will?', a: 'No. It organizes your information and wishes, but it doesn’t replace a will, trust, power of attorney or advance directive. Make those with an attorney, then write in your planner where they’re kept.' },
  { q: 'Is it only for seniors?', a: 'No. As one reader put it, the unexpected can happen to anyone at any age. It’s especially helpful for seniors, people who live alone, caregivers and families.' },
  { q: 'Can I update it later?', a: 'Yes. There’s room to make changes as your decisions or health change, so you don’t need a new book.' },
  { q: 'Is there a version for military families?', a: 'Yes. The Military Deployment and Family Readiness Edition is written for service members and their families.' },
];
---
<Base
  title="The Living Legacy Planner by Courtney Jones"
  {description}
  image="/images/living-legacy-planner.webp"
  imageAlt="The Living Legacy Planner book cover"
  breadcrumbs={crumbs}
  schema={[bookSchema({ name: 'The Living Legacy Planner', description, path, amazonUrl: SITE.links.livingLegacyPlannerAmazon, image: '/images/living-legacy-planner.webp' }), faqSchema(faqs)]}
>
  <PageHero
    title="The Living Legacy Planner"
    kicker="Make a plan to plan"
    lead="Your wishes, your details and your story, written down in one book, so the people you love never have to guess."
    breadcrumbs={crumbs}
  >
    <div class="btn-row">
      <a class="btn btn-primary" href={SITE.links.livingLegacyPlannerAmazon} rel="noopener">Buy on Amazon</a>
      <a class="btn btn-outline" href="/planners/">See all editions</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap grid split">
      <div class="prose">
        <h2>Why I wrote it</h2>
        <p>So many seniors tell me the same thing: they worry about the planning they <em>meant</em> to do and haven’t done yet. And so many families tell me the other side of it: something happened, and nobody knew where anything was.</p>
        <p>One of our readers, Amanda, lived across the country when her mom, in her 60s, had a mild stroke. Amanda didn’t have the information she needed to handle things while her mom was in the hospital. When her mom got home and got better, they sat down and filled in the planner together, “just in case something else happens.”</p>
        <p>That’s exactly why this book exists.</p>
      </div>
      <Photo src="/images/living-legacy-planner-2nd.webp" alt="The Living Legacy Planner second edition cover" width={458} height={651} tilt="r" tape eager />
    </div>
  </section>

  <section class="section section-cream">
    <div class="wrap">
      <h2>What’s inside</h2>
      <div class="grid grid-2" style="margin-top:1.5rem">
        <ul class="checklist">
          <li><strong>Temporary Instructions</strong>, right up front, for when you’re home recovering from a surgery, accident or illness and someone is helping you.</li>
          <li><strong>Final wishes and arrangements.</strong></li>
          <li><strong>Insurance, wills, trusts and beneficiaries</strong>, all together.</li>
          <li><strong>Health details:</strong> allergies, medications, past surgeries, pharmacy, preferred doctors and hospitals.</li>
        </ul>
        <ul class="checklist">
          <li><strong>Finances:</strong> personal and business accounts.</li>
          <li><strong>The people who keep your home running:</strong> your HVAC company, handyman and more.</li>
          <li><strong>Memories, values and treasures</strong> you want to pass on.</li>
          <li><strong>A discussion template</strong> to guide the talk with your family.</li>
        </ul>
      </div>
      <p class="hand" style="margin-top:1rem">Readers love that it’s large, hardback, and lets you tuck in full sheets of documents.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What readers say</h2>
      <div style="margin-top:1.5rem"><Reviews /></div>
      <div class="btn-row"><a class="btn btn-primary" href={SITE.links.livingLegacyPlannerAmazon} rel="noopener">Get your copy on Amazon</a></div>
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand title="Want company while you fill it in?" text="Book a free call. I’ll help you get started, or help you plan the conversation with your family." />
</Base>
