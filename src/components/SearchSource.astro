---
// Small notice that search results come from Google and answers come from AI,
// so visitors know S.A.L.T. is not choosing or sending them to any business.
interface Props { mode?: 'ask' | 'google' | 'both'; compact?: boolean }
const { mode = 'both', compact = false } = Astro.props;
---
<p class:list={['src-note', { compact }]} role="note">
  <span class="badges" aria-hidden="true">
    {(mode === 'ask' || mode === 'both') && (
      <span class="badge ai" title="AI">
        <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2zm7 11l.9 2.6 2.6.9-2.6.9L19 21l-.9-2.6-2.6-.9 2.6-.9L19 13zM5 14l.7 1.8 1.8.7-1.8.7L5 19l-.7-1.8-1.8-.7 1.8-.7L5 14z"/></svg>
        AI
      </span>
    )}
    {(mode === 'google' || mode === 'both') && (
      <span class="badge g" title="Google">
        <svg viewBox="0 0 48 48" width="16" height="16"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        Google
      </span>
    )}
  </span>
  <span class="txt">
    {mode === 'ask' && <>Answers are written by AI to help you look things up yourself. Outside links and searches open on Google or the other website. </>}
    {mode === 'google' && <>Results come from Google search. You search for yourself, and we don’t choose, rank or send you to any business. </>}
    {mode === 'both' && <>Answers are written by AI, and searches open in Google. You search for yourself, and we don’t choose, rank or send you to any business. </>}
    {!compact && <>S.A.L.T. doesn’t endorse outside listings. </>}
    <a href="/disclaimer/#search-and-ai">Learn more</a>
  </span>
</p>

<style>
  .src-note { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: .9rem 0 0; font-size: .95rem; line-height: 1.45; color: var(--ink-soft); }
  .src-note.compact { font-size: .88rem; }
  .badges { display: inline-flex; gap: 6px; }
  .badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px 3px 7px; border-radius: 999px; background: #fff; border: 1.5px solid var(--line); font: 600 .9rem var(--font-head); color: var(--ink); white-space: nowrap; }
  .badge.ai { color: var(--blue); border-color: #c9d7ea; background: var(--blue-pale); }
  .badge svg { flex: none; }
  .txt { flex: 1 1 260px; }
  .txt a { color: var(--plum); font-weight: 600; }
</style>
