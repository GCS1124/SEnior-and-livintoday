---
// Winner / completion celebration, shared by every game and activity.
//
//   window.saltCelebrate({
//     mode: 'win' | 'done',         // 'win' only when the game's real winning condition is met
//     name, achievement, detail,    // shown on screen and on the voucher
//     artwork?: HTMLCanvasElement,  // for "done" (e.g. a finished coloring page) instead of a voucher
//     reward?: { recorded, emailHint } // the $100 voucher shows only when recorded is true
//     fileName, onPlayAgain,
//   })
//
// Brand blue and yellow only. Confetti is skipped for visitors who ask for reduced motion.
---
<dialog class="celebrate" id="celebrate" aria-labelledby="cel-title" aria-describedby="cel-msg">
  <canvas class="confetti" aria-hidden="true"></canvas>
  <div class="cel-card">
    <div class="sparkles" aria-hidden="true"><span>✦</span><span>★</span><span>✦</span><span>★</span><span>✦</span></div>
    <p class="cel-kicker" id="cel-kicker">OH YEAH!</p>
    <h2 id="cel-title">YOU WON!</h2>
    <p class="cel-msg" id="cel-msg"></p>
    <p class="cel-score" id="cel-score"></p>
    <figure class="cel-preview"><img id="cel-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" /></figure>
    <p class="cel-reward" id="cel-reward" hidden></p>
    <div class="cel-acts">
      <button type="button" class="btn btn-primary" id="cel-again">↻ Play again</button>
      <button type="button" class="btn btn-berry" id="cel-download">⬇ Download</button>
      <button type="button" class="btn btn-outline" id="cel-print">🖨️ Print</button>
    </div>
    <p class="cel-shop" id="cel-shop" hidden>
      <a class="btn btn-green" href="https://www.saltonlinestore.com/?utm_source=seniorandlivingtoday&utm_medium=referral&utm_campaign=game-reward" target="_blank" rel="noopener">🛍️ Shop at www.saltonlinestore.com ↗</a>
      <a class="cel-how" href="/coupon-code/">How to use your $100 coupon code</a>
    </p>
    <p class="cel-status" id="cel-status" role="status" aria-live="polite"></p>
    <button type="button" class="cel-close" id="cel-close" aria-label="Close">✕</button>
  </div>
</dialog>
<div id="cel-print-area" aria-hidden="true"><img id="cel-print-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" /></div>

<style is:global>
  dialog.celebrate { position: fixed; inset: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 16px; border: 0; background: rgba(20,33,61,.62); display: none; place-items: center; overflow: auto; }
  dialog.celebrate[open] { display: grid; }
  dialog.celebrate::backdrop { background: transparent; }
  .celebrate .confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .cel-card { position: relative; width: min(620px, 100%); background: #fff; border-radius: 26px; border: 6px solid var(--yellow); padding: clamp(22px, 5vw, 38px); text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
  .cel-kicker { display: inline-block; margin: 0; padding: 6px 18px; border-radius: 999px; background: var(--yellow); font: 700 clamp(1.3rem, 4vw, 1.8rem)/1.1 var(--font-head); letter-spacing: .08em; color: var(--blue-ink); }
  .cel-card h2 { margin: .15em 0 .3em; font-size: clamp(2.4rem, 8vw, 3.6rem); color: var(--blue); }
  .cel-msg { font-size: 1.3rem; color: var(--blue-ink); margin: 0 0 .4em; }
  .cel-score { display: inline-block; background: var(--blue-soft); border-radius: 999px; padding: 6px 18px; font: 600 1.1rem var(--font-head); color: var(--blue); }
  .cel-score:empty { display: none; }
  .cel-reward { margin: 10px auto 0; max-width: 480px; padding: 12px 16px; border-radius: 14px; background: var(--yellow-soft); border: 2px solid var(--yellow); font-size: 1.05rem; color: var(--blue-ink); text-align: left; }
  .cel-reward.warn { background: var(--blue-pale); border-color: var(--line); }
  .cel-shop { display: flex; flex-direction: column; align-items: center; gap: 8px; margin: 14px 0 0; }
  .cel-how { font-weight: 700; color: var(--blue); }
  .cel-preview { margin: 16px auto 4px; max-width: 420px; }
  .cel-preview img { width: 100%; border-radius: 10px; border: 2px solid var(--line); }
  .cel-acts { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 16px; }
  .cel-status { min-height: 1.4em; margin: 10px 0 0; color: var(--blue); font-weight: 700; }
  .cel-close { position: absolute; top: 10px; right: 10px; width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--line); background: #fff; font-size: 1.2rem; cursor: pointer; color: var(--blue-ink); }
  .sparkles { display: flex; justify-content: center; gap: 14px; color: var(--yellow); font-size: 1.5rem; }
  .sparkles span:nth-child(even) { color: var(--blue); }
  @media (prefers-reduced-motion: no-preference) {
    dialog.celebrate[open] .cel-card { animation: cel-pop .55s cubic-bezier(.2,1.4,.4,1); }
    dialog.celebrate[open] .sparkles span { animation: cel-twinkle 1.4s ease-in-out infinite; }
    dialog.celebrate[open] .sparkles span:nth-child(2) { animation-delay: .2s; }
    dialog.celebrate[open] .sparkles span:nth-child(3) { animation-delay: .4s; }
    dialog.celebrate[open] .sparkles span:nth-child(4) { animation-delay: .6s; }
    dialog.celebrate[open] .sparkles span:nth-child(5) { animation-delay: .8s; }
    @keyframes cel-pop { from { transform: scale(.6); opacity: 0; } to { transform: none; opacity: 1; } }
    @keyframes cel-twinkle { 50% { transform: scale(1.4) rotate(20deg); opacity: .6; } }
  }
  #cel-print-area { display: none; }
  @media print {
    body.cel-printing > *:not(#cel-print-area) { display: none !important; }
    body.cel-printing #cel-print-area { display: block !important; }
    body.cel-printing #cel-print-img { width: 100%; height: auto; }
    @page { margin: 10mm; }
  }
</style>

<script>
  type CelOptions = {
    mode?: 'win' | 'done';
    name?: string;
    achievement: string;   // e.g. "found all 8 pairs in Memory Match"
    detail?: string;       // e.g. "Normal level · 12 turns"
    artwork?: HTMLCanvasElement;
    reward?: { recorded: boolean; emailHint: string }; // win + reward recorded in GoHighLevel
    fileName?: string;
    onPlayAgain?: () => void;
  };
  const dlg = document.getElementById('celebrate') as HTMLDialogElement;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const canvasFx = dlg.querySelector<HTMLCanvasElement>('.confetti')!;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  let current: CelOptions | null = null;
  let resultCanvas: HTMLCanvasElement | null = null;
  let lastFocus: HTMLElement | null = null;
  let raf = 0;

  // ---------- Confetti (brand colours only) ----------
  function confetti() {
    if (calm.matches) return;
    const ctx = canvasFx.getContext('2d')!;
    const W = (canvasFx.width = innerWidth), H = (canvasFx.height = innerHeight);
    const colours = ['#223a66', '#ffb400', '#ffe14d', '#ffffff', '#3d5f99'];
    const bits = Array.from({ length: 160 }, () => ({
      x: W / 2 + (Math.random() - 0.5) * W * 0.3, y: H * 0.35,
      vx: (Math.random() - 0.5) * 14, vy: -Math.random() * 14 - 4,
      s: 6 + Math.random() * 8, r: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.3,
      c: colours[(Math.random() * colours.length) | 0], star: Math.random() < 0.25,
    }));
    const start = performance.now();
    cancelAnimationFrame(raf);
    const tick = (t: number) => {
      ctx.clearRect(0, 0, W, H);
      bits.forEach((b) => {
        b.vy += 0.32; b.vx *= 0.99; b.x += b.vx; b.y += b.vy; b.r += b.vr;
        ctx.save(); ctx.translate(b.x, b.y); ctx.rotate(b.r); ctx.fillStyle = b.c;
        if (b.star) { ctx.font = `${b.s * 2}px sans-serif`; ctx.fillText('✦', -b.s, b.s); }
        else ctx.fillRect(-b.s / 2, -b.s / 4, b.s, b.s / 2);
        ctx.restore();
      });
      if (t - start < 4200) raf = requestAnimationFrame(tick); else ctx.clearRect(0, 0, W, H);
    };
    raf = requestAnimationFrame(tick);
  }

  // ---------- Membership reward voucher ----------
  const loadImg = (src: string) => new Promise<HTMLImageElement>((ok, no) => { const i = new Image(); i.onload = () => ok(i); i.onerror = no; i.src = src; });
  const today = () => new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  function wrap(x: CanvasRenderingContext2D, text: string, cx: number, y: number, maxW: number, lh: number) {
    const words = text.split(' '); let line = '';
    for (const w of words) { const t = line ? `${line} ${w}` : w; if (x.measureText(t).width > maxW && line) { x.fillText(line, cx, y); y += lh; line = w; } else line = t; }
    if (line) x.fillText(line, cx, y);
    return y + lh;
  }
  async function voucher(o: CelOptions) {
    await Promise.all(['700 64px Poppins', '600 120px Caveat', '400 30px "Atkinson Hyperlegible"'].map((f) => document.fonts?.load(f).catch(() => null)));
    const c = document.createElement('canvas'); c.width = 1600; c.height = 1000;
    const x = c.getContext('2d')!;
    // Card base: navy with a gold frame
    x.fillStyle = '#223a66'; x.fillRect(0, 0, c.width, c.height);
    x.strokeStyle = '#ffb400'; x.lineWidth = 10; x.strokeRect(36, 36, c.width - 72, c.height - 72);
    x.strokeStyle = 'rgba(255,225,77,.45)'; x.lineWidth = 3; x.strokeRect(56, 56, c.width - 112, c.height - 112);
    // Left panel: logo + $100
    x.fillStyle = '#182b4d'; x.fillRect(56, 56, 520, c.height - 112);
    try { const logo = await loadImg('/images/logo-512.png'); x.drawImage(logo, 196, 110, 240, 240); } catch { /* logo optional */ }
    x.textAlign = 'center';
    x.fillStyle = '#ffe14d'; x.font = '700 190px Poppins, sans-serif'; x.fillText('$100', 316, 560);
    x.fillStyle = '#ffffff'; x.font = '700 40px Poppins, sans-serif'; x.fillText('COUPON CODE', 316, 625);
    x.fillStyle = '#c3d0e3'; x.font = '400 28px "Atkinson Hyperlegible", sans-serif'; x.fillText('for the SALT Online Store', 316, 668);
    x.fillStyle = '#ffb400'; x.font = '60px sans-serif'; x.fillText('★ ★ ★', 316, 790);
    // Right panel: member details
    const cx = 1080;
    x.fillStyle = '#ffb400'; x.font = '700 34px Poppins, sans-serif'; x.fillText('SALT MEMBERSHIP REWARD VOUCHER', cx, 140);
    x.fillStyle = '#c3d0e3'; x.font = '400 30px "Atkinson Hyperlegible", sans-serif'; x.fillText('Proudly presented to our winner', cx, 200);
    x.fillStyle = '#ffffff'; x.font = '600 130px Caveat, cursive'; x.fillText(o.name || 'Winner', cx, 330, 900);
    x.strokeStyle = '#ffb400'; x.lineWidth = 4; x.beginPath(); x.moveTo(cx - 330, 360); x.lineTo(cx + 330, 360); x.stroke();
    x.fillStyle = '#ffffff'; x.font = '700 40px Poppins, sans-serif';
    let y = wrap(x, 'You won a $100 coupon code!', cx, 430, 900, 52);
    x.fillStyle = '#e6edf7'; x.font = '400 30px "Atkinson Hyperlegible", sans-serif';
    y = wrap(x, 'Your coupon code, worth $100 at the SALT Online Store, will be emailed to you within 24–48 hours.', cx, y + 6, 880, 40);
    if (o.reward?.emailHint) { x.fillStyle = '#ffe14d'; x.font = '700 30px "Atkinson Hyperlegible", sans-serif'; y = wrap(x, `Account email: ${o.reward.emailHint}`, cx, y + 8, 880, 40); }
    x.fillStyle = '#c3d0e3'; x.font = '400 26px "Atkinson Hyperlegible", sans-serif';
    y = wrap(x, 'Shop at www.saltonlinestore.com and enter your code at checkout. Your email will explain each simple step.', cx, y + 18, 880, 36);
    if (o.detail) { x.fillStyle = '#ffffff'; x.font = '600 26px Poppins, sans-serif'; wrap(x, `Won: ${o.achievement} · ${o.detail}`, cx, y + 10, 880, 34); }
    x.fillStyle = '#ffb400'; x.font = '700 28px Poppins, sans-serif'; x.fillText('Senior and Living Today  ·  www.saltonlinestore.com', cx, c.height - 120);
    x.fillStyle = '#c3d0e3'; x.font = '400 24px "Atkinson Hyperlegible", sans-serif'; x.fillText(`Issued ${today()}  ·  One reward per email address`, cx, c.height - 80);
    return c;
  }

  // ---------- Open ----------
  async function celebrate(o: CelOptions) {
    current = o; lastFocus = document.activeElement as HTMLElement;
    const win = o.mode !== 'done';
    $('cel-kicker').textContent = win ? 'OH YEAH!' : 'ALL DONE!';
    $('cel-title').textContent = win ? 'YOU WON!' : 'Beautiful work!';
    const nm = o.name && o.name !== 'Friend' ? `, ${o.name}` : '';
    const rewarded = win && !!o.reward?.recorded;
    $('cel-msg').textContent = !win ? `Well done${nm}! You finished it.`
      : rewarded ? `You did it${nm}! You’ve won a $100 coupon code!` : `You did it${nm}! Congratulations on your win!`;
    const rw = $('cel-reward');
    rw.hidden = !win; rw.classList.toggle('warn', win && !rewarded);
    rw.innerHTML = !win ? '' : rewarded
      ? `🎁 Your <strong>coupon code worth $100</strong> for the SALT Online Store will be emailed to <strong>${o.reward!.emailHint}</strong> within <strong>24–48 hours</strong>, with simple steps to use it.`
      : 'We couldn’t record your reward just now, so it hasn’t been added yet. Please call Courtney’s team at <a href="tel:+18884164264">(888) 416-4264</a> and we’ll sort it out.';
    $('cel-shop').hidden = !win;
    ($('cel-download') as HTMLButtonElement).hidden = win && !rewarded;
    ($('cel-print') as HTMLButtonElement).hidden = win && !rewarded;
    $('cel-score').textContent = o.detail ?? '';
    $('cel-status').textContent = '';
    $('cel-again').textContent = o.artwork ? '🖍️ Keep coloring' : '↻ Play again';
    $('cel-download').textContent = o.artwork ? '⬇ Save picture' : '⬇ Download voucher';
    $('cel-print').textContent = o.artwork ? '🖨️ Print picture' : '🖨️ Print voucher';
    if (!dlg.open) dlg.showModal();
    confetti();
    const img = $('cel-img') as HTMLImageElement;
    // The voucher is only shown once the reward has really been recorded.
    resultCanvas = o.artwork ?? (rewarded ? await voucher(o) : null);
    img.parentElement!.hidden = !resultCanvas;
    if (resultCanvas) {
      img.src = resultCanvas.toDataURL('image/png');
      img.alt = o.artwork ? 'Your finished picture' : `SALT membership reward voucher for ${o.name || 'you'}: $100 coupon code`;
    } else img.removeAttribute('src');
    $('cel-again').focus();
  }
  (window as unknown as { saltCelebrate: typeof celebrate }).saltCelebrate = celebrate;

  function close() { cancelAnimationFrame(raf); canvasFx.getContext('2d')?.clearRect(0, 0, canvasFx.width, canvasFx.height); if (dlg.open) dlg.close(); lastFocus?.focus(); }
  $('cel-close').addEventListener('click', close);
  dlg.addEventListener('cancel', () => cancelAnimationFrame(raf));
  dlg.addEventListener('close', () => lastFocus?.focus());
  $('cel-again').addEventListener('click', () => { const again = current?.onPlayAgain; close(); again?.(); });

  $('cel-download').addEventListener('click', async () => {
    if (!resultCanvas || !current) return;
    const base = (current.fileName || 'salt-reward-voucher').replace(/[^a-z0-9-]+/gi, '-');
    const btn = $<HTMLButtonElement>('cel-download'); btn.disabled = true;
    try {
      if (current.artwork) {
        const a = document.createElement('a'); a.href = resultCanvas.toDataURL('image/png'); a.download = `${base}.png`; a.click();
      } else {
        const { jsPDF } = await import('jspdf');
        const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        pdf.addImage(resultCanvas.toDataURL('image/jpeg', 0.92), 'JPEG', 0, 0, 297, 210);
        pdf.save(`${base}.pdf`);
      }
      $('cel-status').textContent = '✓ Saved! Look in your Downloads folder.';
    } catch {
      $('cel-status').textContent = 'Sorry, that didn’t work. Try the Print button instead.';
    } finally { btn.disabled = false; }
  });

  $('cel-print').addEventListener('click', () => {
    if (!resultCanvas) return;
    const img = $<HTMLImageElement>('cel-print-img');
    img.src = resultCanvas.toDataURL('image/png');
    document.body.classList.add('cel-printing');
    const done = () => { document.body.classList.remove('cel-printing'); $('cel-status').textContent = '✓ Sent to your printer.'; window.removeEventListener('afterprint', done); };
    window.addEventListener('afterprint', done);
    const go = () => window.print();
    if (img.complete) go(); else img.onload = go;
  });
</script>
