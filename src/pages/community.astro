---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Community', href: '/community/' }];
---
<Base
  title="Free Online Community for Seniors & Caregivers"
  description="Join the free Senior and Living Today community: discussions, webinars and courses on Medicare, nutrition and estate planning for seniors and caregivers."
  image="/images/garden-friends.webp"
  breadcrumbs={crumbs}
>
  <PageHero
    title="Pull up a chair. You’re among friends."
    kicker="The S.A.L.T. community"
    lead="A free, friendly online space where seniors and caregivers talk, learn and cheer each other on. Ask a question at midnight and someone who’s been there will answer."
    breadcrumbs={crumbs}
  >
    <div class="btn-row"><a class="btn btn-primary" href={SITE.links.community} rel="noopener">Join free</a></div>
  </PageHero>

  <section class="section">
    <div class="wrap grid split">
      <div>
        <h2>What’s inside</h2>
        <ul class="checklist">
          <li><strong>Discussions.</strong> Share what you’re going through, ask questions, and get real answers from real people.</li>
          <li><strong>S.A.L.T. Academy courses.</strong> Medicare Simplified, Health &amp; Nutritional Planning, and Smart Financial &amp; Estate Planning.</li>
          <li><strong>Webinars.</strong> Ask-the-Expert sessions and a peer conversation hour.</li>
          <li><strong>Quizzes &amp; challenges.</strong> Just for fun, and to keep your mind busy.</li>
        </ul>
        <a class="btn btn-green" href={SITE.links.community} rel="noopener">Join the community</a>
      </div>
      <Photo src="/images/garden-friends.webp" alt="A group of friends taking a selfie outdoors" width={1200} height={900} tilt="r" tape caption="Good company is good medicine." />
    </div>
  </section>

  <section class="section section-cream">
    <div class="wrap grid split split-rev">
      <div>
        <span class="kicker">Take the quiz</span>
        <h2>What’s your senior living style?</h2>
        <p>Do you love staying busy, prefer peace and quiet, or need people around you? Take our short quiz, then share your result with the community.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={SITE.links.quiz} rel="noopener">Take the quiz</a>
          <a class="btn btn-outline" href="/guides/types-of-senior-living/">Senior living options, explained</a>
        </div>
      </div>
      <Photo src="/images/park-group.webp" alt="Friends standing together in a park" width={825} height={1100} tilt="l" />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid split">
      <div>
        <h2>Saltine’s Got Talent</h2>
        <p>Talent doesn’t retire. Sing, play, dance, recite a poem, tell a story or show us your quilt. Our community talent show celebrates the gifts and spirit of seniors.</p>
        <a class="btn btn-primary" href={SITE.links.talentForm} rel="noopener">Sign up to perform</a>
      </div>
      <img class="banner" src="/images/saltines-got-talent.webp" width="1600" height="800" alt="Saltine's Got Talent: coming soon, stay tuned" loading="lazy" />
    </div>
  </section>
</Base>
<style>.banner { border-radius: 16px; box-shadow: 0 10px 26px rgba(0,0,0,.15); }</style>
