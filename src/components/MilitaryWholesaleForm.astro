---
// Wholesale inquiry form for the Military Edition landing page (/team-up-with-us/).
//
// Kept as its own component on purpose, so it can be swapped for an externally hosted GoHighLevel
// form later without touching the rest of the page. It posts to /api/military-wholesale, which uses
// the site's existing GoHighLevel connection (no separate key). It sends no emails and starts no
// campaigns. Note: the on-screen "thank you" only means the server answered OK; whether the contact
// reached the intended GoHighLevel account still has to be confirmed in GoHighLevel itself.
// Styles live in src/styles/military.css (.m-form …).
import { MIL_ORG_TYPES, MIL_QUANTITIES, US_STATES } from '../../api/_lib/military-options.js';
---
<form class="m-form" id="m-form" novalidate>
  <div data-form-body>
    <h3>Discuss a wholesale partnership</h3>
    <p>No obligation. Fields marked <span class="req">*</span> are required.</p>
    <div class="m-fields">
      <div class="m-row">
        <label>Full name <span class="req" aria-hidden="true">*</span><input name="fullName" autocomplete="name" required maxlength="120" /></label>
        <label>Organization / business name <span class="req" aria-hidden="true">*</span><input name="organization" autocomplete="organization" required maxlength="120" /></label>
      </div>
      <div class="m-row">
        <label>Business email <span class="req" aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
        <label>Phone number <span class="opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" maxlength="30" /></label>
      </div>
      <div class="m-row">
        <label>Organization type <span class="req" aria-hidden="true">*</span>
          <select name="orgType" required><option value="">Choose one…</option>{Object.entries(MIL_ORG_TYPES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
        </label>
        <label>Estimated quantity of books <span class="req" aria-hidden="true">*</span>
          <select name="quantity" required><option value="">Choose a range…</option>{Object.entries(MIL_QUANTITIES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
        </label>
      </div>
      <div class="m-row">
        <label>State / country <span class="req" aria-hidden="true">*</span>
          <select name="state" required autocomplete="address-level1"><option value="">Choose…</option>{US_STATES.map((s) => <option value={s}>{s}</option>)}</select>
        </label>
        <label data-country hidden>Country <span class="req" aria-hidden="true">*</span><input name="country" autocomplete="country-name" maxlength="60" /></label>
      </div>
      <label>Message / partnership interest <span class="opt">(optional)</span><textarea name="message" rows="4" maxlength="2000" placeholder="Tell us about your organization, the families you serve, and what you have in mind."></textarea></label>
      <label class="m-hp" aria-hidden="true">Fax <input name="fax" tabindex="-1" autocomplete="off" /></label>
      <label class="m-check"><input type="checkbox" name="consent" required /> <span>I agree that Senior and Living Today may contact me about this inquiry. <span class="req" aria-hidden="true">*</span></span></label>
    </div>
    <p class="m-err" id="m-err" role="alert" hidden></p>
    <button type="submit" class="m-btn m-btn-solid" id="m-submit">Discuss a Wholesale Partnership</button>
    <p class="m-small" style="margin:.8rem 0 0">We use your details only to reply to your inquiry. <a href="/privacy-policy/">Privacy policy</a></p>
  </div>
  <div class="m-ok" id="m-ok" hidden tabindex="-1">
    <div class="m-star" aria-hidden="true">★</div>
    <h3>Thank you<span id="m-okname"></span>. Your inquiry has been received.</h3>
    <p>Our team will review it and reply personally by email. Nothing is automatic, and there’s no obligation.</p>
  </div>
</form>

<script>
  type W = Window & { gtag?: (...a: unknown[]) => void };
  const track = (name: string, params: Record<string, unknown> = {}) => { try { (window as W).gtag?.('event', name, params); } catch { /* ignore */ } };
  const form = document.getElementById('m-form') as HTMLFormElement;
  const err = document.getElementById('m-err')!;
  const submit = document.getElementById('m-submit') as HTMLButtonElement;
  const countryWrap = form.querySelector<HTMLElement>('[data-country]')!;
  const val = (n: string) => String((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
  const outside = () => val('state') === 'Outside the United States';
  form.querySelector('[name=state]')!.addEventListener('change', () => { countryWrap.hidden = !outside(); });
  let started = false;
  form.addEventListener('input', () => { if (!started) { started = true; track('mil_wholesale_start'); } });
  const fail = (msg: string, name?: string) => {
    err.textContent = msg; err.hidden = false;
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const t = name ? form.querySelector<HTMLElement>(`[name="${name}"]`) : null;
    if (t) { t.setAttribute('aria-invalid', 'true'); t.focus(); }
  };
  const fallback = 'Sorry, we couldn’t send your inquiry just now. Please email info@seniorandlivingtoday.com or call (888) 416-4264, and we’ll take care of it.';
  form.addEventListener('submit', async (e) => {
    e.preventDefault(); if (submit.disabled) return;
    if (!val('fullName')) return fail('Please enter your full name.', 'fullName');
    if (!val('organization')) return fail('Please enter your organization or business name.', 'organization');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val('email'))) return fail('Please enter a valid business email address.', 'email');
    if (!val('orgType')) return fail('Please choose your organization type.', 'orgType');
    if (!val('quantity')) return fail('Please choose an estimated quantity.', 'quantity');
    if (!val('state')) return fail('Please choose your state, or “Outside the United States”.', 'state');
    if (outside() && !val('country')) return fail('Please enter your country.', 'country');
    if (!(form.elements.namedItem('consent') as HTMLInputElement).checked) return fail('Please agree to be contacted about your inquiry.', 'consent');
    err.hidden = true;
    const utm = [...new URLSearchParams(location.search)].filter(([k]) => k.startsWith('utm_')).map(([k, v]) => `${k}=${v}`).join('&').slice(0, 200);
    const data = { fullName: val('fullName'), organization: val('organization'), email: val('email'), phone: val('phone'), orgType: val('orgType'), quantity: val('quantity'), state: val('state'), country: val('country'), message: val('message'), consent: true, fax: val('fax'), utm };
    submit.disabled = true; submit.textContent = 'Sending…';
    try {
      const r = await fetch('/api/military-wholesale', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      const j = await r.json().catch(() => ({}));
      if (r.ok) {
        track('mil_wholesale_submit', { org_type: data.orgType, quantity: data.quantity });
        document.getElementById('m-okname')!.textContent = `, ${data.fullName.split(' ')[0]}`;
        (form.querySelector('[data-form-body]') as HTMLElement).hidden = true;
        const ok = document.getElementById('m-ok')!; ok.hidden = false; ok.focus();
        return;
      }
      if (r.status === 400) return fail(j.message || 'Please check the form.', j.error);
      if (r.status === 429) return fail(j.message || 'Please wait a few minutes and try again.');
      fail(fallback);
    } catch { fail(fallback); }
    finally { submit.disabled = false; submit.textContent = 'Discuss a Wholesale Partnership'; }
  });
</script>
