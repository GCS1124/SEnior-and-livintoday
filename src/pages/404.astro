---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page Not Found" description="Sorry, we couldn't find that page." noindex>
  <PageHero title="Sorry, we couldn’t find that page" lead="The page may have moved when we refreshed our website. Try one of these instead:">
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn btn-secondary" href="/services/">Our services</a>
      <a class="btn btn-secondary" href="/blog/">Blog</a>
      <a class="btn btn-secondary" href="/contact/">Contact us</a>
    </div>
  </PageHero>
</Base>
