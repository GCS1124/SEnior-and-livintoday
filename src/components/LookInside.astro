---
// "Read Now" book preview, shown as an open book.
//
// Wide screens: two pages side by side with a center spine, turning in pairs (1–2, 3–4, 5–6…).
// Narrow screens: one page at a time, so nothing is too small to read.
// After the free pages comes a final "page" showing the rest of the book as locked (blurred
// thumbnails + section list) with buy buttons. With an odd number of free pages it sits on the
// right-hand side of the last spread.
//
// Pages are images already watermarked with the official SALT seal (see docs/ADDING-BOOKS.md).
// Navigate with the arrow buttons, by clicking the left or right page, the arrow keys, a swipe,
// or the numbered page buttons. One or several books; links anywhere on the page with
// data-look-edition="<key>" (and href="#look-inside") switch to that book.
// Without JavaScript every page is simply shown in order.
import type { Edition } from '../data/planners';
// Opt-in extras (off by default, so existing book pages are unchanged):
//   flip — realistic page turn in two-page view (the page lifts and swings over the spine)
//   zoom — a Zoom button on every page that opens it full screen, with zoom, pan and page stepping
interface Props { editions: Edition[]; initial?: Edition['key']; title?: string; intro?: string; flip?: boolean; zoom?: boolean }
const { editions, initial = editions[0].key, title = 'Look inside the planner', intro = 'Turn the pages and read a little. When you’re ready, order your own copy.', flip = false, zoom = false } = Astro.props;
// Buy buttons: links to a section on the same page (#…) stay in this tab.
const ext = (url: string) => (url.startsWith('#') ? {} : { target: '_blank', rel: 'noopener' });
const buyLabel = (b: { url: string; label: string }) => (b.url.startsWith('#') ? b.label : `🛒 ${b.label} ↗`);
const dims = (p: { src: string; w?: number; h?: number }) => (p.w && p.h ? { width: p.w, height: p.h } : p.src.includes('/page-') ? { width: 1000, height: 1304 } : { width: 900, height: 1260 });
const sectionsOpen = (e: Edition) => e.locked?.sections.filter((s) => s.open).length ?? 0;
---
<section class="section li" id="look-inside" data-look data-flip={flip ? '' : undefined} data-zoom={zoom ? '' : undefined} aria-labelledby="look-inside-title">
  <div class="wrap">
    <div class="li-head">
      <span class="kicker">Free preview</span>
      <h2 id="look-inside-title">📖 {title}</h2>
      <p class="lead">{intro}</p>
    </div>

    {editions.length > 1 && (
      <div class="li-eds" role="group" aria-label="Choose a book">
        {editions.map((e) => (
          <button type="button" class="li-edbtn" data-ed-btn={e.key} aria-pressed={String(e.key === initial)} aria-controls={`look-${e.key}`}>
            <img src={e.cover} alt="" width="60" height="84" loading="lazy" />
            <span>{e.name}</span>
          </button>
        ))}
      </div>
    )}

    {editions.map((e) => {
      const total = e.pages.length;
      return (
        <div class="li-ed" id={`look-${e.key}`} data-ed={e.key} data-total={total} hidden={e.key !== initial}>
          <p class="li-title"><strong>{e.title}</strong> <span class="li-chip">{e.chip}</span></p>
          <div class="li-stage">
            <button type="button" class="li-nav li-prev" aria-label="Previous pages" disabled><span aria-hidden="true">‹</span></button>
            <div class="li-book" tabindex="0" role="region" aria-roledescription="book" aria-label={`${e.title}, free preview. Use the left and right arrow keys to turn the pages.`}>
              <div class="li-spread">
                {e.pages.map((p, i) => (
                  <figure class="li-page" data-i={i} aria-label={`Page ${i + 1} of ${total}: ${p.label}`}>
                    <div class="li-paper">
                      <img src={p.src} alt={p.alt} {...dims(p)} draggable="false" loading={i < 2 && e.key === initial ? 'eager' : 'lazy'} decoding="async" />
                    </div>
                    <figcaption><span class="li-num">{i + 1}</span> <span class="li-label">{p.label}</span>{zoom && <button type="button" class="li-zoom" data-zoom-i={i} aria-label={`Zoom into page ${i + 1}: ${p.label}`}>🔍 Zoom</button>}</figcaption>
                  </figure>
                ))}
                <div class="li-page li-end" data-i={total} aria-label="Order your copy">
                  {e.locked ? (
                    <div class="li-endbox">
                      <h3>🔒 The rest of the book is waiting inside your copy</h3>
                      <div class="li-locked" aria-hidden="true">
                        {e.locked.thumbs.map((t) => <img src={t} alt="" width="180" height="235" loading="lazy" />)}
                        <span class="li-lock">🔒</span>
                      </div>
                      <p>You’ve read <strong>{sectionsOpen(e)} of {e.locked.sections.length} sections</strong>. Here’s everything inside:</p>
                      <ol class="li-sections">
                        {e.locked.sections.map((s) => <li class={s.open ? 'open' : ''}><span aria-hidden="true">{s.open ? '✓' : '🔒'}</span> {s.name}<span class="sr-only">{s.open ? ' (in this preview)' : ' (inside the book)'}</span></li>)}
                      </ol>
                      <div class="btn-row">
                        {e.buy.map((b) => <a class={`btn ${b.primary ? 'btn-primary' : 'btn-outline'}`} href={b.url} {...ext(b.url)}>{buyLabel(b)}</a>)}
                      </div>
                    </div>
                  ) : (
                    <div class="li-endbox">
                      <h3>📖 More pages coming soon</h3>
                      <p>{e.comingSoon}</p>
                      <p>{e.who}</p>
                      <div class="btn-row">
                        {e.buy.map((b) => <a class={`btn ${b.primary ? 'btn-primary' : 'btn-outline'}`} href={b.url} {...ext(b.url)}>{buyLabel(b)}</a>)}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
            <button type="button" class="li-nav li-next" aria-label="Next pages"><span aria-hidden="true">›</span></button>
          </div>
          <p class="li-count" aria-live="polite">Page 1 of {total}: {e.pages[0].label}</p>
          <div class="li-texts">
            {e.pages.map((p, i) => p.text && (
              <details class="li-text" data-i={i}>
                <summary>🔎 Read page {i + 1} ({p.label}) in large print</summary>
                {p.text.map((t) => <p>{t}</p>)}
              </details>
            ))}
          </div>
          <ol class="li-chips" aria-label="Go to a page">
            {e.pages.map((p, i) => <li><button type="button" data-go={i} aria-current={i === 0 ? 'true' : undefined}><b>{i + 1}</b> {p.label}</button></li>)}
            <li><button type="button" data-go={total} class="li-chip-end">🛒 Get your copy</button></li>
          </ol>
        </div>
      );
    })}
  </div>
  {zoom && (
    <dialog class="li-lb" aria-label="Enlarged page">
      <div class="li-lb-top"><strong class="li-lb-title"></strong><div class="li-lb-tools"><button type="button" class="li-lb-zoom" aria-pressed="false">Zoom in</button><button type="button" class="li-lb-close" aria-label="Close">✕</button></div></div>
      <div class="li-lb-view"><img class="li-lb-img" src="" alt="" draggable="false" /></div>
      <div class="li-lb-bottom"><button type="button" class="li-lb-prev" aria-label="Previous page">‹ Prev</button><span class="li-lb-count"></span><button type="button" class="li-lb-next" aria-label="Next page">Next ›</button></div>
    </dialog>
  )}
</section>

<style>
  .li { background: linear-gradient(180deg, var(--blue-pale), #fff); }
  .li-head { max-width: 760px; }
  .li-eds { display: flex; flex-wrap: wrap; gap: 12px; margin: 1.4rem 0 1rem; }
  .li-edbtn { display: inline-flex; align-items: center; gap: 12px; min-height: 64px; padding: 8px 18px 8px 8px; border-radius: 16px; border: 2px solid var(--line); background: #fff; color: var(--blue-ink); font: 700 1.05rem var(--font-head); cursor: pointer; }
  .li-edbtn img { width: 44px; height: auto; border-radius: 4px; box-shadow: 0 3px 8px rgba(20,33,61,.25); }
  .li-edbtn:hover { border-color: var(--yellow); }
  .li-edbtn[aria-pressed='true'] { border-color: var(--blue); background: var(--blue); color: #fff; box-shadow: 0 0 0 4px var(--yellow); }
  .li-title { margin: 1rem 0 .6rem; font-size: 1.1rem; color: var(--blue-ink); }
  .li-chip { display: inline-block; margin-left: 6px; padding: 3px 12px; border-radius: 999px; background: var(--yellow-soft); border: 1px solid var(--yellow); font: 700 .85rem var(--font-head); color: var(--blue-ink); vertical-align: middle; }

  /* The book */
  .li-stage { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; }
  .li-book { --ph: min(70vh, 680px, calc((min(100vw, 1180px) - 300px) * 0.72)); border-radius: 18px; background: #e9eef6; padding: 22px 12px 16px; outline-offset: 4px; overflow: hidden; }
  .li-spread { display: flex; justify-content: center; align-items: flex-start; flex-wrap: wrap; gap: 24px; }
  .li-page { margin: 0; display: flex; flex-direction: column; align-items: center; }
  .li-paper { position: relative; background: #fff; box-shadow: 0 16px 36px rgba(20,33,61,.22); }
  .li-paper img { display: block; width: auto; height: var(--ph); max-width: 100%; object-fit: contain; }
  figcaption { display: flex; gap: 8px; align-items: center; justify-content: center; margin-top: 12px; font: 700 1rem var(--font-head); color: var(--blue-ink); text-align: center; }
  .li-num { display: inline-grid; place-items: center; min-width: 30px; height: 30px; padding: 0 8px; border-radius: 999px; background: var(--blue); color: var(--sun); font-size: .9rem; }

  /* Open-book mode (set by the script): two facing pages joined at a soft spine */
  .li-ed.js .li-spread { flex-wrap: nowrap; gap: 0; }
  .li-ed.js .li-page[hidden] { display: none; }
  .li-ed.two .li-page { flex: 0 1 auto; max-width: 50%; }
  .li-ed.two .li-page.left .li-paper { border-radius: 6px 0 0 6px; box-shadow: -10px 16px 30px rgba(20,33,61,.18); }
  .li-ed.two .li-page.right .li-paper { border-radius: 0 6px 6px 0; box-shadow: 10px 16px 30px rgba(20,33,61,.18); }
  .li-ed.two .li-page.left .li-paper::after,
  .li-ed.two .li-page.right .li-paper::after { content: ''; position: absolute; top: 0; bottom: 0; width: 34px; pointer-events: none; }
  .li-ed.two .li-page.left .li-paper::after { right: 0; background: linear-gradient(to left, rgba(20,33,61,.16), rgba(20,33,61,0)); }
  .li-ed.two .li-page.right .li-paper::after { left: 0; background: linear-gradient(to right, rgba(20,33,61,.16), rgba(20,33,61,0)); }
  .li-ed.two .li-page.left { cursor: w-resize; }
  .li-ed.two .li-page.right { cursor: e-resize; }
  .li-ed.two .li-page.left:first-child:not(.right) { cursor: default; }
  .li-ed.one .li-page { width: 100%; }
  .li-ed.one .li-paper img { height: auto; width: 100%; max-height: 80vh; object-fit: contain; }
  @media (prefers-reduced-motion: no-preference) {
    .li-spread.turn-next .li-page:not([hidden]) { animation: li-turn-next .38s ease-out; transform-origin: left center; }
    .li-spread.turn-prev .li-page:not([hidden]) { animation: li-turn-prev .38s ease-out; transform-origin: right center; }
  }
  @keyframes li-turn-next { from { opacity: .2; transform: perspective(1800px) rotateY(-10deg); } to { opacity: 1; transform: none; } }
  @keyframes li-turn-prev { from { opacity: .2; transform: perspective(1800px) rotateY(10deg); } to { opacity: 1; transform: none; } }

  /* Sample pages are for reading here, not saving (no drag, long-press menu or text selection). */
  .li-paper, .li-locked { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
  .li-paper img, .li-locked img { -webkit-user-drag: none; }

  .li-texts { display: grid; gap: 10px; justify-items: center; margin-top: 10px; }
  .li-text { width: min(760px, 100%); background: #fff; border: 2px solid var(--line); border-radius: 14px; padding: 10px 16px; }
  .li-text summary { cursor: pointer; font: 700 1.05rem var(--font-head); color: var(--blue); min-height: 44px; display: flex; align-items: center; }
  .li-text p { font-size: 1.2rem; line-height: 1.65; }
  .li-nav { width: 56px; height: 56px; border-radius: 50%; border: 2px solid var(--blue); background: #fff; color: var(--blue); font: 700 2.2rem/1 var(--font-head); cursor: pointer; display: grid; place-items: center; padding-bottom: 6px; }
  .li-nav:hover:not(:disabled) { background: var(--yellow); border-color: var(--yellow-shadow); }
  .li-nav:disabled { opacity: .35; cursor: default; }
  /* Phones and small tablets: arrows sit in a row under the page, never on top of the text. */
  @media (max-width: 899px) { .li-stage { grid-template-columns: 1fr 1fr; grid-template-areas: 'book book' 'prev next'; row-gap: 12px; } .li-book { grid-area: book; } .li-prev { grid-area: prev; justify-self: end; margin-right: 12px; } .li-next { grid-area: next; justify-self: start; margin-left: 12px; } }
  .li-count { text-align: center; font: 700 1.1rem var(--font-head); color: var(--blue-ink); margin: 14px 0 8px; }
  .li-chips { list-style: none; padding: 0; margin: 14px auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 980px; }
  .li-chips button { min-height: 44px; padding: 6px 14px; border-radius: 999px; border: 2px solid var(--line); background: #fff; color: var(--blue-ink); font: 600 .95rem var(--font-body); cursor: pointer; }
  .li-chips button b { color: var(--blue); margin-right: 2px; }
  .li-chips button[aria-current='true'] { border-color: var(--blue); background: var(--blue-soft); }
  .li-chips .li-chip-end { background: var(--yellow); border-color: var(--yellow-shadow); font-weight: 700; }

  /* The final "rest of the book" page */
  .li-end { justify-content: center; }
  .li-endbox { width: min(820px, 100%); background: #fff; border: 3px solid var(--yellow); border-radius: 22px; padding: 22px; box-shadow: 0 14px 30px rgba(20,33,61,.12); }
  .li-ed.two .li-end.right .li-endbox { width: calc(var(--ph) * .77); height: var(--ph); overflow: auto; border-radius: 0 10px 10px 0; padding: 18px; }
  .li-ed.two .li-end.right .li-locked { grid-template-columns: repeat(4, 1fr); }
  .li-ed.two .li-end.right .li-locked img:nth-child(n+9) { display: none; }
  .li-ed.two .li-end.right .li-sections { columns: 1; }
  .li-ed.two .li-end.right h3 { font-size: 1.2rem; }
  .li-ed.two .li-end.solo { max-width: 100%; }
  .li-endbox h3 { font-size: 1.45rem; margin-top: 0; }
  .li-locked { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin: 14px 0; }
  .li-locked img { width: 100%; height: auto; border-radius: 4px; filter: saturate(.7); box-shadow: 0 4px 10px rgba(20,33,61,.18); }
  .li-lock { position: absolute; inset: 0; display: grid; place-items: center; font-size: 3rem; text-shadow: 0 2px 10px #fff; }
  @media (max-width: 560px) { .li-locked { grid-template-columns: repeat(4, 1fr); } .li-locked img:nth-child(n+9) { display: none; } }
  .li-sections { columns: 2 260px; padding-left: 0; list-style: none; margin: 10px 0 18px; }
  .li-sections li { break-inside: avoid; padding: 4px 0; color: var(--ink-soft); }
  .li-sections li.open { color: var(--blue-ink); font-weight: 700; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media print { .li { display: none; } }

  /* ---- opt-in: realistic page turn (data-flip) ---- */
  .li[data-flip] .li-book { position: relative; }
  /* The turning page and the page underneath are created by the script, so they need global selectors. */
  :global(.li-leaf), :global(.li-under) { position: absolute; z-index: 5; pointer-events: none; }
  :global(.li-leaf) { transform-style: preserve-3d; }
  :global(.li-face) { position: absolute; inset: 0; overflow: hidden; backface-visibility: hidden; -webkit-backface-visibility: hidden; background: #fff; }
  :global(.li-face.back) { transform: rotateY(180deg); }
  :global(.li-face > *), :global(.li-under > *) { width: 100% !important; height: 100% !important; margin: 0 !important; box-shadow: none !important; border-radius: 0 !important; }
  :global(.li-face img), :global(.li-under img) { display: block; width: 100% !important; height: 100% !important; max-width: none !important; object-fit: fill !important; }
  :global(.li-face::after) { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: var(--shade, 0); background: linear-gradient(90deg, rgba(0,0,0,.35), rgba(0,0,0,0) 60%); }
  :global(.li-face.back::after) { background: linear-gradient(270deg, rgba(0,0,0,.35), rgba(0,0,0,0) 60%); }

  /* ---- opt-in: zoom (data-zoom) ---- */
  .li-zoom { margin-left: 8px; min-height: 36px; padding: 4px 12px; border-radius: 999px; border: 2px solid currentColor; background: transparent; color: inherit; font: 700 .85rem var(--font-head); cursor: zoom-in; }
  dialog.li-lb { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(20,20,20,.95); color: #fff; }
  dialog.li-lb[open] { display: grid; grid-template-rows: auto 1fr auto; }
  dialog.li-lb::backdrop { background: rgba(0,0,0,.85); }
  .li-lb-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1rem; }
  .li-lb-tools { display: flex; gap: .5rem; }
  .li-lb button { white-space: nowrap; min-width: 46px; min-height: 46px; padding: .5rem .9rem; border-radius: 999px; border: 2px solid currentColor; background: transparent; color: inherit; font: 700 .95rem var(--font-head); cursor: pointer; }
  .li-lb-view { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; touch-action: none; cursor: zoom-in; }
  .li-lb-view.zoomed { cursor: grab; }
  .li-lb-img { max-width: min(96vw, 900px); max-height: calc(100vh - 150px); width: auto; height: auto; transform-origin: 0 0; user-select: none; -webkit-user-drag: none; }
  .li-lb-bottom { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: .8rem 1rem 1rem; }
  .li-lb-count { min-width: 7ch; text-align: center; }
</style>

<script>
  const wide = matchMedia('(min-width: 900px)');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-look]').forEach((root) => {
    const eds = [...root.querySelectorAll<HTMLElement>('.li-ed')];
    // No "Save image" menu or dragging on the sample pages.
    root.querySelectorAll<HTMLElement>('.li-paper, .li-locked').forEach((el) => {
      el.addEventListener('contextmenu', (e) => e.preventDefault());
      el.addEventListener('dragstart', (e) => e.preventDefault());
    });
    const edBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-ed-btn]')];
    const refreshers = new Map<string, () => void>();

    eds.forEach((ed) => {
      const book = ed.querySelector<HTMLElement>('.li-book')!;
      const spread = ed.querySelector<HTMLElement>('.li-spread')!;
      const items = [...spread.querySelectorAll<HTMLElement>('.li-page')]; // free pages + the final page
      const total = Number(ed.dataset.total); // free pages only
      const prev = ed.querySelector<HTMLButtonElement>('.li-prev')!;
      const next = ed.querySelector<HTMLButtonElement>('.li-next')!;
      const count = ed.querySelector<HTMLElement>('.li-count')!;
      const texts = [...ed.querySelectorAll<HTMLElement>('.li-text')];
      const chips = [...ed.querySelectorAll<HTMLButtonElement>('[data-go]')];
      let per = wide.matches ? 2 : 1;
      let first = 0; // index of the first item on screen

      const lastStart = () => Math.floor((items.length - 1) / per) * per;
      const render = (dir = 0) => {
        ed.classList.add('js');
        ed.classList.toggle('two', per === 2);
        ed.classList.toggle('one', per === 1);
        first = Math.max(0, Math.min(lastStart(), Math.floor(first / per) * per));
        const onScreen = items.slice(first, first + per);
        items.forEach((it) => { it.hidden = !onScreen.includes(it); it.classList.remove('left', 'right', 'solo'); });
        if (per === 2) {
          if (onScreen.length === 2) { onScreen[0].classList.add('left'); onScreen[1].classList.add('right'); }
          else onScreen[0].classList.add('solo');
        }
        const nums = onScreen.map((it) => Number(it.dataset.i)).filter((i) => i < total);
        texts.forEach((t) => { t.hidden = !nums.includes(Number(t.dataset.i)); });
        prev.disabled = first === 0;
        next.disabled = first >= lastStart();
        const label = (i: number) => items[i].querySelector('.li-label')?.textContent ?? '';
        if (!nums.length) count.textContent = 'The rest is inside your copy';
        else if (nums.length === 2) count.textContent = `Pages ${nums[0] + 1}–${nums[1] + 1} of ${total}`;
        else count.textContent = `Page ${nums[0] + 1} of ${total}: ${label(nums[0])}`;
        chips.forEach((c) => {
          const i = Number(c.dataset.go);
          if (i >= first && i < first + per) c.setAttribute('aria-current', 'true'); else c.removeAttribute('aria-current');
        });
        if (dir && !reduce.matches) {
          spread.classList.remove('turn-next', 'turn-prev');
          void spread.offsetWidth; // restart the animation
          spread.classList.add(dir > 0 ? 'turn-next' : 'turn-prev');
        }
      };
      // Opt-in realistic page turn: the outgoing page lifts and swings over the spine.
      const canFlip = root.hasAttribute('data-flip');
      const face = (it: HTMLElement | undefined) => { const f = it?.querySelector<HTMLElement>('.li-paper, .li-endbox'); return f ? (f.cloneNode(true) as HTMLElement) : null; };
      const spreadNow = () => { const on = items.filter((it) => !it.hidden); return on.length === 2 ? { left: on[0], right: on[1] } : null; };
      const place = (el: HTMLElement, ref: HTMLElement) => { const b = book.getBoundingClientRect(), r = ref.getBoundingClientRect(); Object.assign(el.style, { left: `${r.left - b.left + book.scrollLeft}px`, top: `${r.top - b.top}px`, width: `${r.width}px`, height: `${r.height}px` }); };
      const flipLeaf = (before: { left: HTMLElement; right: HTMLElement }, dir: number) => {
        const after = spreadNow();
        if (!after) { render(dir); return; }
        const fwd = dir > 0;
        const fromFace = face(fwd ? before.right : before.left), toFace = face(fwd ? after.left : after.right), stayFace = face(fwd ? before.left : before.right);
        const slot = (fwd ? after.right : after.left).querySelector<HTMLElement>('.li-paper, .li-endbox'), stillSlot = (fwd ? after.left : after.right).querySelector<HTMLElement>('.li-paper, .li-endbox');
        if (!fromFace || !toFace || !stayFace || !slot || !stillSlot) return;
        const leaf = document.createElement('div'); leaf.className = 'li-leaf'; leaf.setAttribute('aria-hidden', 'true');
        const front = document.createElement('div'); front.className = 'li-face front'; front.append(fromFace);
        const back = document.createElement('div'); back.className = 'li-face back'; back.append(toFace);
        leaf.append(front, back); place(leaf, slot); leaf.style.transformOrigin = fwd ? 'left center' : 'right center';
        const under = document.createElement('div'); under.className = 'li-under'; under.setAttribute('aria-hidden', 'true'); under.append(stayFace); place(under, stillSlot);
        book.style.perspective = '2400px'; book.append(under, leaf);
        const turn = leaf.animate([{ transform: 'rotateY(0deg)' }, { transform: `rotateY(${fwd ? -180 : 180}deg)` }], { duration: 760, easing: 'cubic-bezier(.45,.05,.35,1)' });
        const shade = (el: HTMLElement, a: number, z: number) => el.animate([{ '--shade': a } as Keyframe, { '--shade': z } as Keyframe], { duration: 760 });
        shade(front, 0, .9); shade(back, .9, 0);
        const done = () => { leaf.remove(); under.remove(); book.style.perspective = ''; };
        turn.onfinish = done; turn.oncancel = done;
      };
      const go = (to: number) => {
        const target = Math.max(0, Math.min(lastStart(), Math.floor(to / per) * per));
        if (target === first) return;
        const dir = target > first ? 1 : -1;
        const before = canFlip && per === 2 && !reduce.matches && Math.abs(target - first) === per ? spreadNow() : null;
        const fromFaces = before ? { left: face(before.left)!, right: face(before.right)! } : null;
        first = target;
        render(before ? 0 : dir);
        if (before && fromFaces) {
          // Use detached copies of the outgoing pages, so the live pages stay where they are.
          const wrap = (el: HTMLElement) => { const d = document.createElement('div'); d.append(el); return d; };
          flipLeaf({ left: wrap(fromFaces.left), right: wrap(fromFaces.right) }, dir);
        }
      };

      prev.addEventListener('click', () => go(first - per));
      next.addEventListener('click', () => go(first + per));
      chips.forEach((c) => c.addEventListener('click', () => { go(Number(c.dataset.go)); book.focus({ preventScroll: true }); }));
      // Click the left page to go back, the right page to go forward (open-book mode).
      spread.addEventListener('click', (e) => {
        if (per !== 2 || (e.target as HTMLElement).closest('a, button, summary')) return;
        const page = (e.target as HTMLElement).closest<HTMLElement>('.li-page');
        if (page?.classList.contains('left')) go(first - per);
        else if (page?.classList.contains('right')) go(first + per);
      });
      book.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(first + per); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(first - per); }
        if (e.key === 'Home') { e.preventDefault(); go(0); }
        if (e.key === 'End') { e.preventDefault(); go(items.length - 1); }
      });
      // Swipe on touch screens.
      let x0: number | null = null;
      book.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
      book.addEventListener('pointerup', (e) => {
        if (x0 === null) return;
        const dx = e.clientX - x0; x0 = null;
        if (Math.abs(dx) > 50) go(first + (dx < 0 ? per : -per));
      });
      wide.addEventListener('change', () => { per = wide.matches ? 2 : 1; render(); });
      refreshers.set(ed.dataset.ed!, () => render());
      render();
    });

    const show = (key: string) => {
      if (!eds.some((e) => e.dataset.ed === key)) return false;
      eds.forEach((e) => { e.hidden = e.dataset.ed !== key; });
      edBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.edBtn === key)));
      refreshers.get(key)?.();
      return true;
    };
    edBtns.forEach((b) => b.addEventListener('click', () => show(b.dataset.edBtn!)));

    // Opt-in zoom viewer: full screen, tap or button to zoom 2.2x, drag to look around, step through pages.
    const lb = root.querySelector<HTMLDialogElement>('dialog.li-lb');
    if (lb) {
      const img = lb.querySelector<HTMLImageElement>('.li-lb-img')!, view = lb.querySelector<HTMLElement>('.li-lb-view')!;
      const ttl = lb.querySelector<HTMLElement>('.li-lb-title')!, cnt = lb.querySelector<HTMLElement>('.li-lb-count')!, zb = lb.querySelector<HTMLButtonElement>('.li-lb-zoom')!;
      let pages: { src: string; alt: string; label: string }[] = [], at = 0, zoomed = false, ox = 0, oy = 0, drag: { x: number; y: number; ox: number; oy: number; moved: boolean } | null = null;
      const Z = 2.2;
      const apply = () => { img.style.transform = zoomed ? `translate(${ox}px, ${oy}px) scale(${Z})` : ''; view.classList.toggle('zoomed', zoomed); zb.setAttribute('aria-pressed', String(zoomed)); zb.textContent = zoomed ? 'Zoom out' : 'Zoom in'; };
      const setZoom = (on: boolean, cx?: number, cy?: number) => {
        zoomed = on;
        if (on) { const r = img.getBoundingClientRect(); const px = (cx ?? r.left + r.width / 2) - r.left, py = (cy ?? r.top + r.height / 3) - r.top; ox = -px * (Z - 1); oy = -py * (Z - 1); } else { ox = oy = 0; }
        apply();
      };
      const showPage = (i: number) => { at = (i + pages.length) % pages.length; const p = pages[at]; img.src = p.src; img.alt = p.alt; ttl.textContent = p.label; cnt.textContent = `${at + 1} / ${pages.length}`; setZoom(false); };
      root.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('.li-zoom'); if (!btn) return;
        const ed = btn.closest<HTMLElement>('.li-ed')!;
        pages = [...ed.querySelectorAll<HTMLElement>('.li-page[data-i]:not(.li-end)')].map((pg) => { const im = pg.querySelector('img')!; return { src: im.currentSrc || im.src, alt: im.alt, label: pg.querySelector('.li-label')?.textContent ?? '' }; });
        showPage(Number(btn.dataset.zoomI)); lb.showModal();
      });
      zb.addEventListener('click', () => setZoom(!zoomed));
      lb.querySelector('.li-lb-close')!.addEventListener('click', () => lb.close());
      lb.querySelector('.li-lb-prev')!.addEventListener('click', () => showPage(at - 1));
      lb.querySelector('.li-lb-next')!.addEventListener('click', () => showPage(at + 1));
      lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') showPage(at + 1); else if (e.key === 'ArrowLeft') showPage(at - 1); });
      lb.addEventListener('contextmenu', (e) => e.preventDefault());
      view.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, y: e.clientY, ox, oy, moved: false }; if (zoomed) view.setPointerCapture(e.pointerId); });
      view.addEventListener('pointermove', (e) => { if (!drag) return; const dx = e.clientX - drag.x, dy = e.clientY - drag.y; if (Math.abs(dx) + Math.abs(dy) > 6) drag.moved = true; if (zoomed) { ox = drag.ox + dx; oy = drag.oy + dy; apply(); } });
      view.addEventListener('pointerup', (e) => {
        if (!drag) return; const d = drag; drag = null;
        if (!d.moved) setZoom(!zoomed, e.clientX, e.clientY);                               // tap: zoom in/out at that spot
        else if (!zoomed && Math.abs(e.clientX - d.x) > 50) showPage(at + (e.clientX < d.x ? 1 : -1)); // swipe: next/previous page
      });
    }
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-look-edition]');
      if (a) show(a.dataset.lookEdition!);
    });
    // Links like /books/living-legacy-planner/#look-military open that book.
    const fromHash = () => {
      const m = location.hash.match(/^#look-(\w+)$/);
      if (m && show(m[1])) root.scrollIntoView({ block: 'start' });
    };
    fromHash();
    addEventListener('hashchange', fromHash);
  });
</script>
