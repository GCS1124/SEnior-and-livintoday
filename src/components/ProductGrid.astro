---
import { storeLink, type Product } from '../data/site';
import STORE_PRODUCTS from '../data/store-products.json';

interface Props { items: Product[]; campaign?: string; cta?: string; single?: boolean }
const { items, campaign = 'senior-site', cta = 'More details', single = false } = Astro.props;

type Variant = { id: number; title: string; price: number };
type Info = { option: string | null; variants: Variant[] };
const STORE = 'https://www.saltonlinestore.com';
const utm = `utm_source=seniorandlivingtoday&utm_medium=referral&utm_campaign=${campaign}`;
const money = (n: number) => `$${n.toFixed(2)}`;
// Add to cart: puts the item in the store cart and opens the cart page.
const cartUrl = (id: number) => `${STORE}/cart/add?id=${id}&quantity=1`;
// Buy now: Shopify checkout link, skips the product page and goes straight to checkout.
const buyUrl = (id: number) => `${STORE}/cart/${id}:1?${utm}`;
const label = (t: string) => t.replace(/^LH\d+-/i, '').replace(/\s*\/\s*/g, ' · ');
---
<ul class:list={['pgrid', { single }]}>
  {items.map((p) => {
    const info = (STORE_PRODUCTS as Record<string, Info>)[p.handle];
    const vs = [...(info?.variants ?? [])].sort((a, b) => a.title.localeCompare(b.title, 'en', { numeric: true }));
    const first = vs[0];
    const prices = vs.map((v) => v.price);
    const min = prices.length ? Math.min(...prices) : 0;
    const max = prices.length ? Math.max(...prices) : 0;
    const details = storeLink(`/products/${p.handle}`, campaign);
    return (
      <li class="pcard" data-product>
        <a class="pinfo" href={details} rel="noopener">
          {p.tag && <span class="ptag">{p.tag}</span>}
          <span class="pimg"><img src={`/images/shop/${p.key}.webp`} alt={p.name} width="600" height="600" loading="lazy" decoding="async" /></span>
          <strong>{p.name}</strong>
          <span class="why">{p.why}</span>
        </a>
        {first ? (
          <div class="buy">
            <p class="price" data-price>{min === max ? money(min) : `From ${money(min)}`}</p>
            {vs.length > 1 && (
              <label class="pick">
                <span>Choose {info.option?.toLowerCase() ?? 'option'}</span>
                <select data-variant>
                  {vs.map((v) => <option value={String(v.id)} data-amount={money(v.price)}>{label(v.title)}{min !== max ? ` (${money(v.price)})` : ''}</option>)}
                </select>
              </label>
            )}
            <div class="btns">
              <a class="btn-cart" href={cartUrl(first.id)} data-cart rel="noopener">🛒 Add to cart</a>
              <a class="btn-buy" href={buyUrl(first.id)} data-buy rel="noopener">Buy now</a>
            </div>
            <a class="more" href={details} rel="noopener">{cta} ›</a>
          </div>
        ) : (
          <div class="buy"><a class="btn-buy" href={details} rel="noopener">See it at the SALT store</a></div>
        )}
      </li>
    );
  })}
</ul>

<style>
  .pgrid { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 22px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .pgrid.single { margin-top: 0; max-width: 420px; grid-template-columns: 1fr; }
  .pcard { display: flex; flex-direction: column; background: #fff; border: 2px solid var(--line); border-radius: 20px; padding: 14px 14px 18px; transition: border-color .15s, box-shadow .15s; }
  .pcard:hover { border-color: var(--gold); box-shadow: 0 14px 30px rgba(90,31,60,.12); }
  .pinfo { position: relative; display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .pimg { display: block; border-radius: 14px; overflow: hidden; background: #f7f2ea; aspect-ratio: 1; margin-bottom: 12px; }
  .pimg img { width: 100%; height: 100%; object-fit: contain; transition: transform .2s; }
  .pinfo:hover .pimg img { transform: scale(1.04); }
  .ptag { position: absolute; top: 8px; left: 8px; z-index: 2; background: var(--berry); color: #fff; font: 600 .82rem var(--font-head); padding: 4px 11px; border-radius: 999px; }
  .pinfo strong { font: 600 1.1rem/1.3 var(--font-head); }
  .pinfo:hover strong { color: var(--berry); }
  .why { color: var(--ink-soft); font-size: 1rem; margin: 4px 0 10px; }
  .buy { margin-top: auto; display: grid; gap: 10px; }
  .price { margin: 0; font: 700 1.3rem var(--font-head); color: var(--plum); }
  .pick { display: grid; gap: 4px; font: 600 .92rem var(--font-head); color: var(--ink-soft); }
  .pick select { font: 1rem var(--font-body, inherit); min-height: 46px; padding: 8px 10px; border: 2px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink); }
  .btns { display: grid; gap: 8px; }
  .btn-cart, .btn-buy { display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 8px 10px; border-radius: 999px; font: 700 1rem var(--font-head); text-decoration: none; text-align: center; }
  .btn-cart { background: #fff; color: var(--plum); border: 2px solid var(--plum); }
  .btn-cart:hover { background: var(--plum); color: #fff; }
  .btn-buy { background: var(--gold); color: var(--ink); border: 2px solid var(--gold); }
  .btn-buy:hover { filter: brightness(.95); }
  .buy > .btn-buy { grid-column: 1 / -1; }
  .more { justify-self: center; font: 600 .95rem var(--font-head); color: var(--plum); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-product]').forEach((card) => {
    const sel = card.querySelector<HTMLSelectElement>('[data-variant]');
    if (!sel) return;
    const cart = card.querySelector<HTMLAnchorElement>('[data-cart]')!;
    const buy = card.querySelector<HTMLAnchorElement>('[data-buy]')!;
    const price = card.querySelector<HTMLElement>('[data-price]')!;
    const update = () => {
      const id = sel.value;
      cart.href = cart.href.replace(/id=\d+/, `id=${id}`);
      buy.href = buy.href.replace(/\/cart\/\d+:1/, `/cart/${id}:1`);
      price.textContent = sel.selectedOptions[0].dataset.amount ?? price.textContent;
    };
    sel.addEventListener('change', update);
    if (sel.selectedIndex > 0) update();
  });
</script>
